+                                bool selfCritical, bool targetFinish, bool targetProtected,
+                                bool safeRecovery, bool resetRequested, float incomingBurstScore,
+                                float killWindowScore)
 {
     // A nearly secured kill may be worth finishing through moderate pressure,
     // but never through a true lethal enemy go. This is the shared answer to
     // "Finish or Reset?" used by every specialization policy.
-    if (targetFinish && killWindowScore >= 0.82f && incomingBurstScore < 0.85f && !targetProtected)
+    if (targetFinish && killWindowScore >= profile.finishThreshold &&
+        incomingBurstScore < std::max(0.85f, profile.surviveThreshold + 0.07f) && !targetProtected)
         return PvpSpecPhase::Finish;
-    if (selfCritical || incomingBurstScore >= 0.78f)
+    if (selfCritical || incomingBurstScore >= profile.surviveThreshold)
         return PvpSpecPhase::Survive;
     if (allyCritical)
         return PvpSpecPhase::Peel;
@@ -1077,46 +1126,107 @@ PvpSpecPhase SelectPvpSpecPhase(bool allyCritical, bool selfCritical, bool targe
