+    EXPECT_EQ(PvpProcUse::Damage, SelectPvpProcUse(5, 5, finish));
+
+    PvpProcScores emergency = ScorePvpProcUse(PvpArchetype::EnhancementShaman,
+                                              22.0f, 80.0f, 70.0f, 0.85f,
+                                              false, false, PvpSpecPhase::Survive);
+    EXPECT_EQ(PvpProcUse::Heal, SelectPvpProcUse(5, 5, emergency));
+
+    PvpProcScores setup = ScorePvpProcUse(PvpArchetype::FeralDruid,
+                                          100.0f, 100.0f, 90.0f, 0.0f,
+                                          true, false, PvpSpecPhase::Setup);
+    EXPECT_EQ(PvpProcUse::Control, SelectPvpProcUse(5, 5, setup));
+}
+
+TEST(PvpSpecPolicy, ProfilesGiveAggressiveAndDurableSpecsDifferentThresholds)
+{
+    PvpSpecPolicyProfile const fury = GetPvpSpecPolicyProfile(PvpArchetype::FuryWarrior);
+    PvpSpecPolicyProfile const blood = GetPvpSpecPolicyProfile(PvpArchetype::BloodDeathKnight);
+    EXPECT_LT(fury.commitThreshold, blood.commitThreshold);
+    EXPECT_GT(fury.surviveThreshold, blood.surviveThreshold);
+    EXPECT_TRUE(ShouldCommitPvpPrimaryBurst(PvpSpecPhase::Commit, 0.58f, false, true,
+                                           fury.commitThreshold));
+    EXPECT_FALSE(ShouldCommitPvpPrimaryBurst(PvpSpecPhase::Commit, 0.58f, false, true,
+                                            blood.commitThreshold));
 }
