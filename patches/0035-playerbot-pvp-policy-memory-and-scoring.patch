+PvpSpecPolicyProfile GetPvpSpecPolicyProfile(PvpArchetype archetype)
+{
+    PvpSpecPolicyProfile profile;
+    switch (archetype)
+    {
+        case PvpArchetype::FuryWarrior:
+        case PvpArchetype::FireMage:
+            profile.setupThreshold = 0.30f;
+            profile.commitThreshold = 0.56f;
+            profile.finishThreshold = 0.76f;
+            profile.surviveThreshold = 0.84f;
+            break;
+        case PvpArchetype::SubtletyRogue:
+        case PvpArchetype::FeralDruid:
+        case PvpArchetype::AssassinationRogue:
+            profile.setupThreshold = 0.32f;
+            profile.commitThreshold = 0.60f;
+            profile.resetBias = 0.12f;
+            break;
+        case PvpArchetype::BloodDeathKnight:
+        case PvpArchetype::ProtectionWarrior:
+        case PvpArchetype::ProtectionPaladin:
+            profile.commitThreshold = 0.68f;
+            profile.surviveThreshold = 0.68f;
+            profile.resetBias = -0.10f;
+            break;
+        case PvpArchetype::HolyPaladin:
+        case PvpArchetype::HolyPriest:
+        case PvpArchetype::RestorationShaman:
+        case PvpArchetype::DisciplinePriest:
+        case PvpArchetype::RestorationDruid:
+            profile.commitThreshold = 0.74f;
+            profile.surviveThreshold = 0.66f;
+            profile.resetBias = -0.06f;
+            break;
+        default:
+            break;
+    }
+    return profile;
+}
+
