+Unit* ResolvePvpHostilePet(PlayerbotAI* botAI, float maxDistance)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!IsPvpTacticalEligible(bot))
+        return nullptr;
+
+    Unit* best = nullptr;
+    float bestScore = FLT_MAX;
+    auto consider = [&](Unit* candidate, Player* expectedOwner)
+    {
+        if (!candidate || candidate->IsPlayer() || !candidate->IsAlive() || !candidate->IsInWorld() ||
+            candidate->GetMap() != bot->GetMap() || candidate->IsTotem() || candidate->IsFriendlyTo(bot) ||
+            !bot->CanSeeOrDetect(candidate, false, true))
+            return;
+        Unit* owner = candidate->GetOwner();
+        if (!owner || !owner->IsPlayer() || (expectedOwner && owner != expectedOwner) || !bot->IsHostileTo(owner))
+            return;
+        float const distance = bot->GetDistance2d(candidate);
+        if (maxDistance > 0.0f && distance > maxDistance)
+            return;
+        // An actively attacking pet wins over an idle summon, then distance
+        // provides stable selection between several controlled creatures.
+        float const score = distance - (candidate->GetVictim() == bot ? 50.0f : 0.0f);
+        if (score < bestScore)
+        {
+            best = candidate;
+            bestScore = score;
+        }
+    };
+
+    if (bot->duel && bot->duel->Opponent && bot->duel->Opponent->IsAlive())
+        for (Unit* controlled : bot->duel->Opponent->m_Controlled)
+            consider(controlled, bot->duel->Opponent);
+    else
+    {
+        for (Unit* attacker : bot->getAttackers())
+            consider(attacker, nullptr);
+        for (ObjectGuid const& guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest enemy players")->Get())
+            if (Player* enemy = botAI->GetUnit(guid) ? botAI->GetUnit(guid)->ToPlayer() : nullptr)
+                for (Unit* controlled : enemy->m_Controlled)
+                    consider(controlled, enemy);
+    }
+    return best;
+}
+
+Unit* ResolvePvpMovementThreat(PlayerbotAI* botAI, float maxDistance)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    Unit* player = ResolvePvpThreatTarget(botAI, maxDistance);
+    Unit* pet = ResolvePvpHostilePet(botAI, maxDistance);
+    if (!bot || !pet)
+        return player;
+    PvpControlState const petControl = GetPvpControlState(pet);
+    if ((petControl == PvpControlState::DamageBreakable || petControl == PvpControlState::DamageImmune) &&
+        bot->GetDistance2d(pet) > 8.0f)
+        return player;
+    if (pet->GetVictim() != bot && bot->GetDistance2d(pet) > 8.0f)
+        return player;
+    return !player || bot->GetDistance2d(pet) < bot->GetDistance2d(player) ? pet : player;
+}
