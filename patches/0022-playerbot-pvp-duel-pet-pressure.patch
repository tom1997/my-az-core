+PvpHostilePetResponse ClassifyPvpHostilePetResponse(bool alive, bool attackingBot, bool ownerProtected,
+                                                     PvpControlState petControl, bool ranged,
+                                                     float healthPct, float distance)
+{
+    if (!alive || !attackingBot)
+        return PvpHostilePetResponse::None;
+    if (petControl == PvpControlState::DamageBreakable || petControl == PvpControlState::DamageImmune)
+        return ranged ? PvpHostilePetResponse::Kite : PvpHostilePetResponse::None;
+    if (ownerProtected)
+        return healthPct <= 65.0f ? PvpHostilePetResponse::Kill : PvpHostilePetResponse::Control;
+    if (healthPct <= 30.0f)
+        return PvpHostilePetResponse::Kill;
+    if (ranged && distance <= 10.0f)
+        return PvpHostilePetResponse::Kite;
+    return distance <= 15.0f ? PvpHostilePetResponse::Control : PvpHostilePetResponse::None;
+}
