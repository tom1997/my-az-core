+bool ShouldReleasePvpControlWindowSetup(PvpCcUsage usage, bool positioningComplete, uint32 elapsedMs)
+{
+    if (usage != PvpCcUsage::SetupThenBreak && usage != PvpCcUsage::Reposition)
