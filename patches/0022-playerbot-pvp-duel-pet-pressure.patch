+bool PvpTacticalEmergencyEscapeAction::isUseful()
+{
+    if (!IsPvpTacticalContextEnabled(bot) || !botAI->IsRanged(bot, true) ||
+        (bot->getClass() != CLASS_MAGE && bot->getClass() != CLASS_HUNTER))
+        return false;
+    Unit* threat = ResolvePvpMovementThreat(botAI, 12.0f);
+    if (!threat)
+        return false;
+    float const emergencyDistance = bot->getClass() == CLASS_HUNTER ? 10.0f : 8.0f;
+    if (bot->GetDistance2d(threat) > emergencyDistance)
+        return false;
+    auto ready = [&](char const* spell)
+    {
+        uint32 const spellId = context->GetValue<uint32>("spell id", spell)->Get();
+        return spellId && !bot->HasSpellCooldown(spellId);
+    };
+    if (bot->getClass() == CLASS_MAGE)
+        return ready("blink") || ready("frost nova") || ready("cone of cold");
+    return ready("disengage") || ready("freezing trap") || ready("wing clip");
+}
+
+bool PvpTacticalEmergencyEscapeAction::Execute(Event /*event*/)
+{
+    Unit* threat = ResolvePvpMovementThreat(botAI, 12.0f);
+    if (!threat)
+        return false;
+    if (bot->IsNonMeleeSpellCast(false))
+        bot->InterruptNonMeleeSpells(false);
+    StopOwnedPvpMovement(botAI);
+
+    if (bot->getClass() == CLASS_MAGE)
+    {
+        // Blink travels forward. Face directly away from whichever unit is
+        // actually pinning the mage, including a hostile permanent pet.
+        bot->SetOrientation(bot->GetAngle(threat) + float(M_PI));
+        if (TrySpell(botAI, "blink", bot, false))
+        {
+            DebugPvpTactical(botAI, "emergency-blink", threat);
+            return true;
+        }
+        if (TrySelfAreaControl(botAI, "frost nova", threat) ||
+            TrySpell(botAI, "cone of cold", threat, false))
+        {
+            DebugPvpTactical(botAI, "emergency-mage-control", threat);
+            return true;
+        }
+        return false;
+    }
+
+    if (bot->getClass() == CLASS_HUNTER)
+    {
+        // Disengage jumps backwards, so face the pressure source first.
+        bot->SetOrientation(bot->GetAngle(threat));
+        if (TrySpell(botAI, "disengage", bot, false))
+        {
+            DebugPvpTactical(botAI, "emergency-disengage", threat);
+            return true;
+        }
+        if (TrySelfAreaControl(botAI, "freezing trap", threat) ||
+            TrySpell(botAI, "wing clip", threat, false))
+        {
+            DebugPvpTactical(botAI, "emergency-hunter-control", threat);
+            return true;
+        }
+    }
+    return false;
+}
+
+bool PvpTacticalHostilePetAction::isUseful()
+{
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    if (snapshot.hostilePet.petGuid.IsEmpty() || !snapshot.hostilePet.alive)
+        return false;
+    return snapshot.hostilePet.response == PvpHostilePetResponse::Control ||
+           snapshot.hostilePet.response == PvpHostilePetResponse::Kill;
+}
+
+bool PvpTacticalHostilePetAction::Execute(Event /*event*/)
+{
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    Unit* pet = botAI->GetUnit(snapshot.hostilePet.petGuid);
+    if (!pet || !pet->IsAlive() || !pet->IsInWorld())
+        return false;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (now - state.lastHostilePetActionAtMs < 400)
+        return false;
+
+    auto tryPetDamage = [&]()
+    {
+        auto tryDamage = [&](std::initializer_list<char const*> spells)
+        {
+            for (char const* spell : spells)
+                if (TrySpell(botAI, spell, pet, false))
+                    return true;
+            return false;
+        };
+        switch (bot->getClass())
+        {
+            case CLASS_WARRIOR: return tryDamage({ "mortal strike", "overpower", "heroic strike" });
+            case CLASS_PALADIN: return tryDamage({ "judgement of light", "exorcism", "crusader strike" });
+            case CLASS_DEATH_KNIGHT: return tryDamage({ "icy touch", "death coil", "scourge strike" });
+            case CLASS_HUNTER: return tryDamage({ "arcane shot", "aimed shot", "steady shot" });
+            case CLASS_ROGUE: return tryDamage({ "sinister strike", "hemorrhage", "eviscerate" });
+            case CLASS_PRIEST: return tryDamage({ "shadow word: death", "mind blast", "smite" });
+            case CLASS_SHAMAN: return tryDamage({ "frost shock", "lava burst", "lightning bolt" });
+            case CLASS_MAGE: return tryDamage({ "ice lance", "frostbolt", "fireball" });
+            case CLASS_WARLOCK: return tryDamage({ "searing pain", "incinerate", "shadow bolt" });
+            case CLASS_DRUID: return tryDamage({ "moonfire", "wrath", "starfire" });
+            default: return false;
+        }
+    };
+
+    bool acted = false;
+    if (snapshot.hostilePet.response == PvpHostilePetResponse::Control)
+    {
+        switch (bot->getClass())
+        {
+            case CLASS_WARRIOR:
+                acted = TrySpell(botAI, "intimidating shout", pet) ||
+                        TrySpell(botAI, "hamstring", pet, false);
+                break;
+            case CLASS_PALADIN:
+                acted = TrySpell(botAI, "turn evil", pet) || TrySpell(botAI, "hammer of justice", pet);
+                break;
+            case CLASS_DEATH_KNIGHT:
+                acted = TrySpell(botAI, "chains of ice", pet, false) ||
+                        TrySpell(botAI, "strangulate", pet);
+                break;
+            case CLASS_HUNTER:
+                acted = TrySpell(botAI, "scare beast", pet) || TrySpell(botAI, "scatter shot", pet) ||
+                        (bot->GetDistance2d(pet) <= 8.0f && TrySelfAreaControl(botAI, "freezing trap", pet));
+                break;
+            case CLASS_ROGUE:
+                acted = TrySpell(botAI, "blind", pet) || TrySpell(botAI, "gouge", pet);
+                break;
+            case CLASS_PRIEST:
+                acted = TrySpell(botAI, "shackle undead", pet) ||
+                        (bot->GetDistance2d(pet) <= 8.0f && TrySelfAreaControl(botAI, "psychic scream", pet));
+                break;
+            case CLASS_SHAMAN:
+                acted = TrySpell(botAI, "hex", pet) || TrySpell(botAI, "frost shock", pet, false) ||
+                        (bot->GetDistance2d(pet) <= 12.0f && TrySpell(botAI, "earthbind totem", bot, false));
+                break;
+            case CLASS_MAGE:
+                acted = TrySpell(botAI, "polymorph", pet) ||
+                        (bot->GetDistance2d(pet) <= 10.0f && TrySelfAreaControl(botAI, "frost nova", pet));
+                break;
+            case CLASS_WARLOCK:
+                acted = TrySpell(botAI, "banish", pet) || TrySpell(botAI, "fear", pet) ||
+                        TrySpell(botAI, "death coil", pet);
+                break;
+            case CLASS_DRUID:
+                acted = TrySpell(botAI, "hibernate", pet) || TrySpell(botAI, "entangling roots", pet) ||
+                        TrySpell(botAI, "cyclone", pet);
+                break;
+            default:
+                break;
+        }
+        if (acted)
+            DebugPvpTactical(botAI, "hostile-pet-control", pet);
+        bool const ownerProtected = snapshot.hostilePet.ownerGuid == snapshot.primaryTarget &&
+            (snapshot.targetControlState == PvpControlState::DamageBreakable ||
+             snapshot.targetControlState == PvpControlState::DamageImmune);
+        if (!acted && ownerProtected && (acted = tryPetDamage()))
+            DebugPvpTactical(botAI, "hostile-pet-control-damage-fallback", pet);
+        if (!acted && botAI->IsRanged(bot, true) && bot->GetDistance2d(pet) <= 18.0f)
+        {
+            acted = botAI->DoSpecificAction("pvp tactical retreat", Event(), true);
+            if (acted)
+                DebugPvpTactical(botAI, "hostile-pet-reposition", pet);
+        }
+    }
+    else if (snapshot.hostilePet.response == PvpHostilePetResponse::Kill)
+    {
+        acted = tryPetDamage();
+        if (!acted)
+        {
+            bot->SetSelection(pet->GetGUID());
+            context->GetValue<Unit*>("current target")->Set(pet);
+            acted = bot->Attack(pet, botAI->IsMelee(bot, true) || bot->IsWithinMeleeRange(pet));
+        }
+        if (acted)
+            DebugPvpTactical(botAI, "hostile-pet-kill", pet);
+    }
+
+    if (acted)
+        state.lastHostilePetActionAtMs = now;
+    return acted;
+}
