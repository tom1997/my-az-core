+++ b/modules/mod-playerbots/t/PvpTacticalPolicyTests.cxx
@@ -0,0 +1,91 @@
+#include "PvpTacticalValue.h"
+
+#include "SharedDefines.h"
+#include "SpellDefines.h"
+
+#include <gtest/gtest.h>
+#include <initializer_list>
+
+namespace
+{
+constexpr uint32 BreaksOnDamage = AURA_INTERRUPT_FLAG_TAKE_DAMAGE |
+                                  AURA_INTERRUPT_FLAG_DIRECT_DAMAGE;
+
+TEST(PvpControlPolicy, ClassicBreakableControlUsesDamageInterruptMetadata)
+{
+    for (uint32 mechanic : { MECHANIC_POLYMORPH, MECHANIC_SAPPED, MECHANIC_DISORIENTED,
+                             MECHANIC_FREEZE, MECHANIC_SLEEP, MECHANIC_FEAR })
+    {
+        EXPECT_EQ(PvpControlState::DamageBreakable,
+                  ClassifyPvpControlMetadata(1ULL << mechanic, BreaksOnDamage, false));
+    }
+}
+
+TEST(PvpControlPolicy, StunRootAndSilenceRemainDamageSafe)
+{
+    for (uint32 mechanic : { MECHANIC_STUN, MECHANIC_ROOT, MECHANIC_SILENCE })
+    {
+        EXPECT_EQ(PvpControlState::DamageSafe,
+                  ClassifyPvpControlMetadata(1ULL << mechanic, BreaksOnDamage, false));
+    }
+}
+
+TEST(PvpControlPolicy, BanishAndCompleteDamageImmunityAreDamageImmune)
+{
+    EXPECT_EQ(PvpControlState::DamageImmune,
+              ClassifyPvpControlMetadata(1ULL << MECHANIC_BANISH, 0, false));
+    EXPECT_EQ(PvpControlState::DamageImmune,
+              ClassifyPvpControlMetadata(0, 0, true));
+}
+
+TEST(PvpControlPolicy, NonControlMetadataIsNotProtected)
+{
+    EXPECT_EQ(PvpControlState::None,
+              ClassifyPvpControlMetadata(1ULL << MECHANIC_SNARE, BreaksOnDamage, false));
+    EXPECT_EQ(PvpControlState::None, ClassifyPvpControlMetadata(0, 0, false));
+}
+
+TEST(PvpControlPolicy, UncertainComplexControlFallbackFailsClosed)
+{
+    EXPECT_EQ(PvpControlState::DamageBreakable,
+              ClassifyPvpControlFallback(false, false, false, false, true, false, false, false));
+    EXPECT_EQ(PvpControlState::DamageBreakable,
+              ClassifyPvpControlFallback(false, false, false, false, false, true, false, false));
+    EXPECT_EQ(PvpControlState::DamageBreakable,
+              ClassifyPvpControlFallback(false, false, false, false, false, false, true, true));
+    EXPECT_EQ(PvpControlState::DamageSafe,
+              ClassifyPvpControlFallback(true, false, false, false, true, true, true, true));
+    EXPECT_EQ(PvpControlState::DamageSafe,
+              ClassifyPvpControlFallback(false, true, true, true, false, false, false, false));
+    EXPECT_EQ(PvpControlState::None,
+              ClassifyPvpControlFallback(false, false, false, false, false, false, false, false));
+}
+
+TEST(PvpDamagePolicy, UtilityRemainsAvailableOnProtectedTargets)
+{
+    EXPECT_TRUE(ShouldBlockPvpDamage(PvpControlState::DamageBreakable, true));
+    EXPECT_TRUE(ShouldBlockPvpDamage(PvpControlState::DamageImmune, true));
+    EXPECT_FALSE(ShouldBlockPvpDamage(PvpControlState::DamageBreakable, false));
+    EXPECT_FALSE(ShouldBlockPvpDamage(PvpControlState::DamageImmune, false));
+    EXPECT_FALSE(ShouldBlockPvpDamage(PvpControlState::DamageSafe, true));
+}
+
+TEST(PvpControlPolicy, PressureBonusReflectsHowMuchTheTargetLoses)
+{
+    EXPECT_FLOAT_EQ(0.20f, CalculatePvpControlPressureBonus(true, true, false, false, false, true));
+    EXPECT_FLOAT_EQ(0.14f, CalculatePvpControlPressureBonus(true, false, true, false, true, false));
+    EXPECT_FLOAT_EQ(0.08f, CalculatePvpControlPressureBonus(true, false, false, true, false, true));
+    EXPECT_FLOAT_EQ(0.02f, CalculatePvpControlPressureBonus(true, false, true, false, false, true));
+    EXPECT_FLOAT_EQ(0.02f, CalculatePvpControlPressureBonus(true, false, false, true, true, false));
+    EXPECT_FLOAT_EQ(0.0f, CalculatePvpControlPressureBonus(false, true, true, true, true, true));
+}
+
+TEST(PvpDamagePolicy, AreaDamageChecksBothImpactAndCasterVicinity)
+{
+    EXPECT_TRUE(ShouldBlockPvpAreaDamage(true, true, false));
+    EXPECT_TRUE(ShouldBlockPvpAreaDamage(true, false, true));
+    EXPECT_TRUE(ShouldBlockPvpAreaDamage(true, true, true));
+    EXPECT_FALSE(ShouldBlockPvpAreaDamage(true, false, false));
+    EXPECT_FALSE(ShouldBlockPvpAreaDamage(false, true, true));
+}
+}
