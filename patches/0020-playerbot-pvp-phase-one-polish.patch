+bool IsPvpDamageSpellInternal(SpellInfo const* spellInfo, uint8 depth)
+{
+    if (!spellInfo || depth > 3)
+        return false;
+    for (SpellEffectInfo const& effect : spellInfo->Effects)
+    {
+        switch (effect.Effect)
+        {
+            case SPELL_EFFECT_INSTAKILL:
+            case SPELL_EFFECT_SCHOOL_DAMAGE:
+            case SPELL_EFFECT_ENVIRONMENTAL_DAMAGE:
+            case SPELL_EFFECT_HEALTH_LEECH:
+            case SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL:
+            case SPELL_EFFECT_WEAPON_PERCENT_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE:
+            case SPELL_EFFECT_NORMALIZED_WEAPON_DMG:
+                return true;
+            default:
+                break;
+        }
+        if (effect.ApplyAuraName == SPELL_AURA_PERIODIC_DAMAGE ||
+            effect.ApplyAuraName == SPELL_AURA_PERIODIC_DAMAGE_PERCENT ||
+            effect.ApplyAuraName == SPELL_AURA_PERIODIC_LEECH)
+            return true;
+        if (effect.TriggerSpell && effect.TriggerSpell != spellInfo->Id &&
+            IsPvpDamageSpellInternal(sSpellMgr->GetSpellInfo(effect.TriggerSpell), depth + 1))
+            return true;
+    }
+    return false;
+}
