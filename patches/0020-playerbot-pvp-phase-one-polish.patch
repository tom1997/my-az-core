+    if (metadataDamageSafe || stunned || rooted || silenced)
+        return PvpControlState::DamageSafe;
+    if (feared || confused || charmed || areaCharmed)
+        return PvpControlState::DamageBreakable;
+    return PvpControlState::None;
+}
