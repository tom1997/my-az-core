+PvpControlState ClassifyPvpControlMetadata(uint64 mechanicMask, uint32 auraInterruptFlags, bool damageImmune)
+{
+    if (damageImmune || (mechanicMask & (1ULL << MECHANIC_BANISH)))
+        return PvpControlState::DamageImmune;
+    if ((mechanicMask & PVP_BREAKABLE_CONTROL_MASK) && (auraInterruptFlags & PVP_DAMAGE_BREAK_FLAGS))
+        return PvpControlState::DamageBreakable;
+    return mechanicMask & PVP_CONTROL_MASK ? PvpControlState::DamageSafe : PvpControlState::None;
+}
