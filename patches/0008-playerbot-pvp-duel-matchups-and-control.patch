+bool PvpTacticalPressureHunterTrigger::IsActive()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsPlayer() || target->getClass() != CLASS_HUNTER || bot->getClass() != CLASS_MAGE ||
+        !IsPvpTacticalContextEnabled(bot))
+        return false;
+
+    float const distance = bot->GetDistance2d(target);
+    if (distance < 12.0f || distance > 28.0f)
+        return false;
+
+    // Only take the hunter's dead-zone aggressively while the exchange is
+    // favorable; otherwise the mage keeps casting instead of walking into damage.
+    return target->GetHealthPct() <= 40.0f ||
+           (bot->GetHealthPct() >= 70.0f && bot->GetHealthPct() >= target->GetHealthPct() + 15.0f);
+}
