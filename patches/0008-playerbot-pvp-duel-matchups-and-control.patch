+bool CastBlinkBackAction::isUseful()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (target && target->IsPlayer() && sPlayerbotAIConfig.pvpTacticalEnabled && bot->duel &&
+        bot->duel->Opponent == target && bot->GetDistance2d(target) > 8.0f)
+        return false;
+
