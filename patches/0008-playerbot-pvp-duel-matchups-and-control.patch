+
+namespace
+{
+void StopMageForPvpCast(PlayerbotAI* botAI, Player* bot)
+{
+    bot->GetMotionMaster()->Clear(false);
+    bot->StopMoving();
+    botAI->GetAiObjectContext()->GetValue<LastMovement&>("last movement")->Get().clear();
+}
+}
+
+bool CastPvpPolymorphAction::isUseful()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsPlayer() || botAI->HasAura("polymorph", target) ||
+        target->IsImmunedToDamage(SPELL_SCHOOL_MASK_MAGIC))
+        return false;
+
+    float const distance = bot->GetDistance2d(target);
+    if (distance < 8.0f || distance > 30.0f || bot->GetHealthPct() > 60.0f)
+        return false;
+
+    uint32 const spellId = AI_VALUE2(uint32, "spell id", "polymorph");
+    return spellId && !bot->HasSpellCooldown(spellId) && (!lastCastMs || getMSTime() - lastCastMs >= 18000);
+}
+
+bool CastPvpPolymorphAction::Execute(Event /*event*/)
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target)
+        return false;
+
+    if (bot->isMoving())
+    {
+        StopMageForPvpCast(botAI, bot);
+        return true;
+    }
+
+    if (!botAI->CastSpell("polymorph", target))
+        return false;
+
+    lastCastMs = getMSTime();
+    return true;
+}
+
+bool CastPvpMageSlowAction::isUseful()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsPlayer() || botAI->HasAura("polymorph", target) ||
+        botAI->HasAura("slow", target) || botAI->HasAura("frostbolt", target) ||
+        botAI->HasAura("cone of cold", target))
+        return false;
+
+    return bot->GetDistance2d(target) <= 35.0f;
+}
+
+bool CastPvpMageSlowAction::Execute(Event /*event*/)
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target)
+        return false;
+
+    if (bot->GetDistance2d(target) <= 10.0f && botAI->CanCastSpell("cone of cold", target))
+        return botAI->CastSpell("cone of cold", target);
+
+    if (botAI->CanCastSpell("slow", target))
+        return botAI->CastSpell("slow", target);
+
+    uint32 const frostboltId = AI_VALUE2(uint32, "spell id", "frostbolt");
+    if (!frostboltId || bot->HasSpellCooldown(frostboltId))
+        return false;
+
+    if (bot->isMoving())
+    {
+        StopMageForPvpCast(botAI, bot);
+        return true;
+    }
+
+    return botAI->CastSpell("frostbolt", target);
+}
+
+bool HoldPvpPolymorphAction::isUseful()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    return target && target->IsPlayer() && botAI->HasAura("polymorph", target);
+}
+
+bool HoldPvpPolymorphAction::Execute(Event /*event*/)
+{
+    bot->AttackStop();
+    botAI->PetFollow();
+    return true;
+}
