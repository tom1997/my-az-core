+bool AttackDuelOpponentAction::Execute(Event /*event*/)
+{
+    Player* opponent = AI_VALUE(Unit*, "duel target") ? AI_VALUE(Unit*, "duel target")->ToPlayer() : nullptr;
+    if (!opponent || !bot->duel)
+        return false;
+
+    if (bot->duel->State == DUEL_STATE_CHALLENGED)
+        return false;
+
+    if (bot->duel->State == DUEL_STATE_COUNTDOWN)
+    {
+        if (bot->getClass() == CLASS_ROGUE && !botAI->HasAura("stealth", bot) && botAI->CanCastSpell("stealth", bot))
+            return botAI->CastSpell("stealth", bot);
+
+        float desiredDistance = 10.0f;
+        if (bot->getClass() == CLASS_WARRIOR)
+            desiredDistance = 18.0f;
+        else if (bot->getClass() == CLASS_DEATH_KNIGHT)
+            desiredDistance = 20.0f;
+        else if (bot->getClass() == CLASS_HUNTER)
+            desiredDistance = 28.0f;
+        else if (botAI->IsRanged(bot, true) || botAI->IsHeal(bot))
+            desiredDistance = 25.0f;
+
+        float const distance = bot->GetDistance2d(opponent);
+        if (std::abs(distance - desiredDistance) <= 2.0f || bot->isMoving())
+            return true;
+
+        if (distance < desiredDistance)
+        {
+            float const step = std::min(6.0f, (desiredDistance - distance) * 0.5f);
+            return MoveAway(opponent, std::max(2.0f, step), false);
+        }
+
+        return MoveTo(opponent, desiredDistance, MovementPriority::MOVEMENT_COMBAT);
+    }
+
+    if (bot->duel->State != DUEL_STATE_IN_PROGRESS)
+        return false;
+
+    if (IsFullyDamageImmune(opponent))
+    {
+        if (Unit* secondary = GetDuelSecondaryTarget(bot, opponent))
+            return Attack(secondary);
+
+        bot->AttackStop();
+        botAI->PetFollow();
+        return true;
+    }
+
+    return Attack(opponent);
+}
 
