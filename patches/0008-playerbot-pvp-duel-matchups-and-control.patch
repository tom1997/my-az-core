+bool IsFullyDamageImmune(Unit* unit)
+{
+    return unit && unit->IsImmunedToDamage(SPELL_SCHOOL_MASK_NORMAL) &&
+           unit->IsImmunedToDamage(SPELL_SCHOOL_MASK_MAGIC);
+}
+
+Unit* GetDuelSecondaryTarget(Player* bot, Player* opponent)
+{
+    Unit* best = nullptr;
+    float bestDistance = FLT_MAX;
+    for (Unit* controlled : opponent->m_Controlled)
+    {
+        if (!controlled || !controlled->IsInWorld() || !controlled->IsAlive() || controlled->IsFriendlyTo(bot) ||
+            IsFullyDamageImmune(controlled))
+            continue;
+
+        float const distance = bot->GetDistance2d(controlled);
+        if (distance <= 50.0f && distance < bestDistance)
+        {
+            best = controlled;
+            bestDistance = distance;
+        }
+    }
+    return best;
+}
+}
 
