+bool PvpTacticalBattlegroundEngageAction::isUseful()
+{
+    if (!sPlayerbotAIConfig.pvpTacticalEnabled || !sPlayerbotAIConfig.pvpTacticalBattleground ||
+        !IsPvpTacticalEligible(bot) || !bot->InBattleground())
+        return false;
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (state.battlegroundEngagement == PvpBattlegroundEngagement::Travel &&
+        state.battlegroundReengageAtMs > getMSTime() && bot->getAttackers().empty())
+        return false;
+    return state.battlegroundEngagement != PvpBattlegroundEngagement::Travel ||
+           ResolvePvpBattlegroundEngageTarget(botAI, 50.0f);
+}
+
+bool PvpTacticalBattlegroundEngageAction::Execute(Event /*event*/)
+{
+    Battleground* battleground = bot->GetBattleground();
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (!battleground || battleground->GetStatus() != STATUS_IN_PROGRESS)
+    {
+        state.battlegroundEngagement = PvpBattlegroundEngagement::Travel;
+        state.battlegroundPressureBand = PvpBattlegroundPressureBand::None;
+        state.battlegroundTargetGuid.Clear();
+        return false;
+    }
+
+    uint32 const now = getMSTime();
+    if (state.battlegroundEngagement == PvpBattlegroundEngagement::Travel &&
+        state.battlegroundReengageAtMs > now && bot->getAttackers().empty())
+        return false;
+    Unit* target = botAI->GetUnit(state.battlegroundTargetGuid);
+    auto validTarget = [&](Unit* candidate, float maxDistance)
+    {
+        return candidate && candidate->IsPlayer() && candidate->IsAlive() && candidate->IsInWorld() &&
+               candidate->GetMap() == bot->GetMap() && bot->IsHostileTo(candidate) &&
+               bot->IsValidAttackTarget(candidate) && bot->CanSeeOrDetect(candidate, false, true) &&
+               bot->IsWithinLOSInMap(candidate) && bot->GetDistance2d(candidate) <= maxDistance &&
+               !ShouldBlockPvpDuelInterference(bot, candidate);
+    };
+    if (!validTarget(target, state.battlegroundEngagement == PvpBattlegroundEngagement::Travel ? 50.0f : 65.0f))
+        target = ResolvePvpBattlegroundEngageTarget(
+            botAI, state.battlegroundEngagement == PvpBattlegroundEngagement::Travel ? 50.0f : 65.0f);
+
+    bool const underPressure = !bot->getAttackers().empty() ||
+        (target && (target->GetVictim() == bot || target->GetTarget() == bot->GetGUID()));
+    if (bot->IsInCombat() || underPressure)
+        state.battlegroundLastCombatAtMs = now;
+
+    if (state.battlegroundEngagement == PvpBattlegroundEngagement::Combat)
+    {
+        bool const engageGrace = state.battlegroundEngagedAtMs && now - state.battlegroundEngagedAtMs < 3000;
+        if (target && (bot->IsInCombat() || underPressure || engageGrace))
+        {
+            state.battlegroundTargetGuid = target->GetGUID();
+            Unit* current = context->GetValue<Unit*>("current target")->Get();
+            if (!current || !current->IsAlive() || !bot->IsHostileTo(current))
+            {
+                bot->SetSelection(target->GetGUID());
+                context->GetValue<Unit*>("current target")->Set(target);
+            }
+            return false;
+        }
+
+        if (bot->IsInCombat() || !bot->getAttackers().empty() ||
+            (state.battlegroundLastCombatAtMs && now - state.battlegroundLastCombatAtMs < 2500))
+            return false;
+
+        state.battlegroundEngagement = PvpBattlegroundEngagement::Travel;
+        state.battlegroundPressureBand = PvpBattlegroundPressureBand::None;
+        state.battlegroundTargetGuid.Clear();
+        state.battlegroundReengageAtMs = now + 5000;
+        state.rangeMotion = PvpRangeMotion::Hold;
+        if (state.movementOwner != PvpMovementOwner::None)
+            CancelPvpMovement(botAI);
+        DebugPvpTactical(botAI, "bg-travel-resume", nullptr);
+        return false;
+    }
+
+    if (!target)
+        return false;
+
+    state.battlegroundEngagement = PvpBattlegroundEngagement::Engage;
+    state.battlegroundTargetGuid = target->GetGUID();
+    state.battlegroundEngagedAtMs = now;
+
+    // The objective path is a travel concern. Clear it before removing the
+    // mount so the first combat movement cannot be overwritten by its stale
+    // waypoint on the next update.
+    CancelPvpMovement(botAI);
+    bool const dismounted = bot->IsMounted();
+    if (dismounted)
+        bot->RemoveAurasByType(SPELL_AURA_MOUNTED);
+    ShapeshiftForm const form = bot->GetShapeshiftForm();
+    if (form == FORM_TRAVEL || form == FORM_FLIGHT || form == FORM_FLIGHT_EPIC)
+        botAI->RemoveShapeshift();
+
+    bot->SetSelection(target->GetGUID());
+    context->GetValue<Unit*>("current target")->Set(target);
+    context->GetValue<GuidVector>("prioritized targets")->Set({ target->GetGUID() });
+    botAI->ChangeEngine(BOT_STATE_COMBAT);
+    bot->Attack(target, botAI->IsMelee(bot, true));
+    state.battlegroundEngagement = PvpBattlegroundEngagement::Combat;
+    state.battlegroundLastCombatAtMs = now;
+    DebugPvpTactical(botAI, dismounted ? "bg-engage-dismount" : "bg-engage", target);
+    return true;
+}
