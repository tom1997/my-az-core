+Unit* ResolvePvpBattlegroundEngageTarget(PlayerbotAI* botAI, float maxDistance)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!IsPvpTacticalEligible(bot) || !bot->InBattleground())
+        return nullptr;
+
+    Unit* best = nullptr;
+    float bestScore = -FLT_MAX;
+    std::set<ObjectGuid> seen;
+    auto consider = [&](Unit* candidate)
+    {
+        if (!candidate || !candidate->IsPlayer() || !candidate->IsAlive() || !candidate->IsInWorld() ||
+            candidate->GetMap() != bot->GetMap() || !bot->IsHostileTo(candidate) ||
+            !bot->IsValidAttackTarget(candidate) || !bot->CanSeeOrDetect(candidate, false, true) ||
+            !bot->IsWithinLOSInMap(candidate) || ShouldBlockPvpDuelInterference(bot, candidate))
+            return;
+        if (!seen.insert(candidate->GetGUID()).second)
+            return;
+        float const distance = bot->GetDistance2d(candidate);
+        if (maxDistance > 0.0f && distance > maxDistance)
+            return;
+
+        // Prefer an enemy already committing to this bot, then wounded and
+        // healing targets. Distance remains the stable tie breaker so mounted
+        // bots do not rapidly change their mind during the engage transition.
+        float score = 1.0f - distance / std::max(1.0f, maxDistance);
+        if (candidate->GetVictim() == bot || candidate->GetTarget() == bot->GetGUID())
+            score += 0.75f;
+        score += (100.0f - candidate->GetHealthPct()) / 200.0f;
+        if (PlayerbotAI::IsHeal(candidate->ToPlayer(), true))
+            score += 0.15f;
+        if (score > bestScore)
+        {
+            best = candidate;
+            bestScore = score;
+        }
+    };
+
+    consider(botAI->GetAiObjectContext()->GetValue<Unit*>("current target")->Get());
+    for (Unit* attacker : bot->getAttackers())
+        consider(attacker);
+    for (ObjectGuid const& guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest enemy players")->Get())
+        consider(botAI->GetUnit(guid));
+    return best;
+}
