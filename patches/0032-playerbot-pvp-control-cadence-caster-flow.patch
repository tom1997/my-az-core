+bool PvpTacticalCasterPressureAction::isUseful()
+{
+    if (!bot->IsAlive() || bot->IsNonMeleeSpellCast(false))
+        return false;
+    Unit* target = ResolvePvpClassActionTarget(botAI);
+    if (!target || !target->IsPlayer() || !target->IsAlive() ||
+        !bot->CanSeeOrDetect(target, false, true))
+        return false;
+
+    PvpArchetype const archetype = GetPvpSnapshot(botAI).archetype;
+    return archetype == PvpArchetype::ShadowPriest || archetype == PvpArchetype::ElementalShaman ||
+           archetype == PvpArchetype::ArcaneMage || archetype == PvpArchetype::BalanceDruid;
+}
+
+bool PvpTacticalCasterPressureAction::Execute(Event /*event*/)
+{
+    Unit* target = ResolvePvpClassActionTarget(botAI);
+    if (!target || !target->IsPlayer())
+        return false;
+
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (state.damageFormRecoveryUntilMs > now || snapshot.intent == PvpIntent::Survive ||
+        snapshot.intent == PvpIntent::Recover || snapshot.intent == PvpIntent::Reset ||
+        snapshot.defensiveNeedScore >= 0.72f)
+        return false;
+
+    bool const moving = bot->isMoving();
+    switch (snapshot.archetype)
+    {
+        case PvpArchetype::ShadowPriest:
+        {
+            if (bot->GetHealthPct() <= 30.0f || bot->GetPowerPct(POWER_MANA) <= 12.0f)
+                return false;
+            if (!botAI->HasAura("shadowform", bot))
+                return TrySpell(botAI, "shadowform", bot, false);
+
+            // While moving, spend instant DoTs first. Once the range controller
+            // grants a plant window, VT -> Mind Blast -> Mind Flay becomes a
+            // continuous caster chain instead of falling through to the wand.
+            if (!botAI->HasAura("devouring plague", target, false, true) &&
+                TryPvpPressureSpell(botAI, "devouring plague", target))
+                return true;
+            if (!botAI->HasAura("shadow word: pain", target, false, true) &&
+                TryPvpPressureSpell(botAI, "shadow word: pain", target))
+                return true;
+            if (!botAI->HasAura("vampiric touch", target, false, true) &&
+                TryPvpPressureSpell(botAI, "vampiric touch", target))
+                return true;
+            if (TryPvpPressureSpell(botAI, "mind blast", target))
+                return true;
+            if (moving && target->GetHealthPct() <= 40.0f &&
+                TryPvpPressureSpell(botAI, "shadow word: death", target))
+                return true;
+            return TryPvpPressureSpell(botAI, "mind flay", target);
+        }
+        case PvpArchetype::ElementalShaman:
+            if (bot->GetPowerPct(POWER_MANA) <= 12.0f)
+                return false;
+            if (!botAI->HasAura("flame shock", target, false, true) &&
+                TryPvpPressureSpell(botAI, "flame shock", target))
+                return true;
+            if (moving && !botAI->HasAura("frost shock", target) &&
+                TryPvpPressureSpell(botAI, "frost shock", target))
+                return true;
+            if (botAI->HasAura("flame shock", target, false, true) &&
+                TryPvpPressureSpell(botAI, "lava burst", target))
+                return true;
+            return TryPvpPressureSpell(botAI, "lightning bolt", target);
+        case PvpArchetype::ArcaneMage:
+        {
+            float const manaPct = bot->GetPowerPct(POWER_MANA);
+            if (manaPct <= 15.0f)
+                return false;
+            Aura* blast = botAI->GetAura("arcane blast", bot);
+            uint8 const stacks = blast ? blast->GetStackAmount() : 0;
+            if (botAI->HasAura("missile barrage", bot) &&
+                TryPvpPressureSpell(botAI, "arcane missiles", target))
+                return true;
+            if (moving)
+                return TryPvpPressureSpell(botAI, "arcane barrage", target) ||
+                       TryPvpPressureSpell(botAI, "fire blast", target);
+            if ((stacks >= 4 || manaPct < 35.0f) &&
+                TryPvpPressureSpell(botAI, "arcane barrage", target))
+                return true;
+            if (snapshot.killWindowScore >= 0.62f &&
+                TrySpell(botAI, "arcane power", bot, false))
+                return true;
+            return TryPvpPressureSpell(botAI, "arcane blast", target) ||
+                   TryPvpPressureSpell(botAI, "arcane barrage", target);
+        }
+        case PvpArchetype::BalanceDruid:
+            if (bot->GetHealthPct() <= 35.0f || bot->GetPowerPct(POWER_MANA) <= 12.0f)
+                return false;
+            if (!botAI->HasAura("moonkin form", bot))
+                return TrySpell(botAI, "moonkin form", bot, false);
+            if (!botAI->HasAura("insect swarm", target, false, true) &&
+                TryPvpPressureSpell(botAI, "insect swarm", target))
+                return true;
+            if (!botAI->HasAura("moonfire", target, false, true) &&
+                TryPvpPressureSpell(botAI, "moonfire", target))
+                return true;
+            if (botAI->HasAura("eclipse (lunar)", bot) &&
+                TryPvpPressureSpell(botAI, "starfire", target))
+                return true;
+            return TryPvpPressureSpell(botAI, "wrath", target) ||
+                   TryPvpPressureSpell(botAI, "starfire", target);
+        default:
+            return false;
+    }
+}
