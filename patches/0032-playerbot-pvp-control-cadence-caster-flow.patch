+bool ShouldLeavePvpDamageForm(float healthPct, PvpControlState targetControl,
+                              uint32 controlRemainingMs, bool targetMovementDenied,
+                              float targetDistance, float incomingBurstScore)
+{
+    // Shadowform and Moonkin Form are pressure states.  Dropping either form
+    // just because a generic heal trigger fired creates a dead GCD and leaves
+    // the caster exposed.  Recovery is allowed only after the bot has created
+    // a real control window and is actually wounded enough to use it.
+    if (healthPct >= 85.0f || incomingBurstScore >= 0.72f)
+        return false;
+
+    if ((targetControl == PvpControlState::DamageBreakable ||
+         targetControl == PvpControlState::DamageImmune) && controlRemainingMs >= 1800)
+        return true;
+
+    return targetControl == PvpControlState::DamageSafe && targetMovementDenied &&
+           targetDistance >= 14.0f && controlRemainingMs >= 1200;
+}
