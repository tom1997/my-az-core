+int32 GetTemplatePrimaryTab(Player* player, uint32 specNo)
+{
+    if (!player || specNo >= MAX_SPECNO)
+        return -1;
+
+    uint32 points[3] = { 0, 0, 0 };
+    for (int32 level = std::min<uint32>(player->GetLevel(), 80); level >= 2; --level)
+    {
+        std::vector<std::vector<uint32>> const& talents =
+            sPlayerbotAIConfig.parsedSpecLinkOrder[player->getClass()][specNo][level];
+        if (talents.empty())
+            continue;
+        for (std::vector<uint32> const& talent : talents)
+            if (talent.size() >= 4 && talent[0] < 3)
+                points[talent[0]] += talent[3];
+        break;
+    }
+
+    if (!points[0] && !points[1] && !points[2])
+        return -1;
+    return std::distance(points, std::max_element(points, points + 3));
+}
