+PvpControlPurpose ClassifyPvpControlPurpose(bool offTarget, bool recoveryNeeded, bool targetPressuring,
+                                            bool meleeThreat, bool targetCasting, bool burstSetup,
+                                            bool castWindowNeeded)
+{
+    if (offTarget)
+        return PvpControlPurpose::OffTarget;
+    if (recoveryNeeded)
+        return PvpControlPurpose::Recover;
+    if (targetPressuring && meleeThreat)
+        return PvpControlPurpose::Escape;
+    if (targetCasting || (targetPressuring && !meleeThreat))
+        return PvpControlPurpose::Peel;
+    if (burstSetup || castWindowNeeded)
+        return PvpControlPurpose::Setup;
+    return PvpControlPurpose::None;
+}
+
+uint32 GetPvpControlCadenceMs(std::string const& spell)
+{
+    if (spell == "fear" || spell == "hex" || spell == "polymorph" || spell == "repentance")
+        return 12000;
+    if (spell == "entangling roots" || spell == "cyclone" || spell == "hibernate" || spell == "banish")
+        return 9000;
+    return 0;
+}
+
+bool IsPvpControlCadenceReady(uint32 now, uint32 lastAttemptAtMs, uint32 cadenceMs)
+{
+    return !cadenceMs || !lastAttemptAtMs || now - lastAttemptAtMs >= cadenceMs;
+}
+
+void MarkPvpControlAttempt(PlayerbotAI* botAI, std::string const& spell, Unit* target)
+{
+    if (!botAI || !target || !IsPvpTacticalContextEnabled(botAI->GetBot()))
+        return;
+    uint32 const cadenceMs = GetPvpControlCadenceMs(spell);
+    if (!cadenceMs)
+        return;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    state.lastCadencedControlAtMs = getMSTime();
+    state.lastCadencedControlTargetGuid = target->GetGUID();
+    state.lastCadencedControlSpellId =
+        botAI->GetAiObjectContext()->GetValue<uint32>("spell id", spell)->Get();
+}
+
+void MarkPvpCastStarted(PlayerbotAI* botAI, SpellInfo const* spellInfo, uint32 castMs)
+{
+    if (!botAI || !spellInfo || castMs < 750 || !IsPvpTacticalContextEnabled(botAI->GetBot()))
+        return;
+
+    // Keep a short follow-through window after a successful hard cast begins.
+    // Without it the range controller can restart a retreat on the first frame
+    // after impact, before the next spell in the class rotation is selected.
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const until = getMSTime() + std::clamp<uint32>(castMs + 1100, 1800, 5200);
+    state.rangedCastPlantUntilMs = std::max(state.rangedCastPlantUntilMs, until);
+    state.rangeMotion = PvpRangeMotion::Hold;
+}
+
+bool ShouldDeployPvpTotems(PlayerbotAI* botAI)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot || !IsPvpTacticalContextEnabled(bot))
+        return true;
+    if (bot->getClass() != CLASS_SHAMAN || !bot->IsAlive() || bot->IsMounted())
+        return false;
+    if (bot->InBattleground() && !IsPvpBattlegroundCombatOwned(botAI))
+        return false;
+
+    Unit* target = ResolvePvpThreatTarget(botAI, 40.0f);
+    if (!target || bot->GetDistance2d(target) > 35.0f || bot->IsNonMeleeSpellCast(false))
+        return false;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (state.battlegroundPressureBand == PvpBattlegroundPressureBand::Emergency ||
+        bot->isMoving() || IsPvpMovementActive(botAI, bot))
+        return false;
+    return true;
+}
