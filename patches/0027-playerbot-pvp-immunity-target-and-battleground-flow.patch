+bool ShouldReleasePvpIceBlock(uint32 elapsedMs, float incomingBurstScore, float threatDistance,
+                              bool threatMovementDenied, float targetHealthPct)
+{
+    // Keep a short guaranteed cleanse/burst-denial window, then leave early as
+    // soon as the opponent can no longer punish the release. Never consume the
+    // full ten seconds while a safe counter-pressure window already exists.
+    if (elapsedMs < 1200)
