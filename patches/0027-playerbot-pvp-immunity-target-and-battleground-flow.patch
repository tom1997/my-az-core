+bool TryOpponentImmunityRecovery(PlayerbotAI* botAI, Unit* target, PvpSnapshot const& snapshot)
+{
+    Player* bot = botAI->GetBot();
+    if (!ShouldUsePvpImmunityRecovery(snapshot.targetControlState, bot->GetHealthPct()))
+        return false;
+
+    // Ice Block and Divine Shield cannot be pressured. Spend that otherwise
+    // dead duel time on real recovery, without repeatedly refreshing an aura
+    // that is already present.
+    bot->AttackStop();
+    if (bot->IsNonMeleeSpellCast(false))
+        return true;
+
+    if (bot->GetHealthPct() < 85.0f && botAI->DoSpecificAction("healthstone", Event(), true))
+    {
+        DebugPvpTactical(botAI, "enemy-immunity-healthstone", target);
+        return true;
+    }
+
+    bool recovered = false;
+    switch (bot->getClass())
+    {
+        case CLASS_DRUID:
+            if (bot->GetShapeshiftForm() != FORM_NONE)
+            {
+                botAI->RemoveShapeshift();
+                DebugPvpTactical(botAI, "enemy-immunity-leave-form", target);
+                return true;
+            }
+            recovered = !botAI->HasAura("rejuvenation", bot) &&
+                        TrySpell(botAI, "rejuvenation", bot, false);
+            break;
+        case CLASS_PRIEST:
+            recovered = (!botAI->HasAura("renew", bot) && TrySpell(botAI, "renew", bot, false)) ||
+                        (!botAI->HasAura("power word: shield", bot) &&
+                         TrySpell(botAI, "power word: shield", bot, false));
+            break;
+        case CLASS_SHAMAN:
+            recovered = !botAI->HasAura("riptide", bot) && TrySpell(botAI, "riptide", bot, false);
+            break;
+        case CLASS_DEATH_KNIGHT:
+            recovered = TrySpell(botAI, "rune tap", bot, false) || TrySpell(botAI, "death pact", bot, false);
+            break;
+        case CLASS_WARRIOR:
+            recovered = !botAI->HasAura("enraged regeneration", bot) &&
+                        TrySpell(botAI, "enraged regeneration", bot, false);
+            break;
+        default:
+            break;
+    }
+    if (recovered)
+    {
+        DebugPvpTactical(botAI, "enemy-immunity-instant-recovery", target);
+        return true;
+    }
+
+    auto ready = [&](char const* spell)
+    {
+        uint32 const spellId = botAI->GetAiObjectContext()->GetValue<uint32>("spell id", spell)->Get();
+        return spellId && !bot->HasSpellCooldown(spellId);
+    };
+    bool const hasHardHeal =
+        (bot->getClass() == CLASS_DRUID && (ready("regrowth") || ready("healing touch"))) ||
+        (bot->getClass() == CLASS_PALADIN && (ready("flash of light") || ready("holy light"))) ||
+        (bot->getClass() == CLASS_PRIEST && (ready("flash heal") || ready("greater heal"))) ||
+        (bot->getClass() == CLASS_SHAMAN && (ready("lesser healing wave") || ready("healing wave")));
+    if (hasHardHeal && bot->isMoving())
+    {
+        StopOwnedPvpMovement(botAI);
+        DebugPvpTactical(botAI, "enemy-immunity-heal-plant", target);
+        return true;
+    }
+
+    switch (bot->getClass())
+    {
+        case CLASS_DRUID:
+            recovered = TrySpell(botAI, "regrowth", bot, false) || TrySpell(botAI, "healing touch", bot, false);
+            break;
+        case CLASS_PALADIN:
+            recovered = TrySpell(botAI, "flash of light", bot, false) || TrySpell(botAI, "holy light", bot, false);
+            break;
+        case CLASS_PRIEST:
+            recovered = TrySpell(botAI, "flash heal", bot, false) || TrySpell(botAI, "greater heal", bot, false);
+            break;
+        case CLASS_SHAMAN:
+            recovered = TrySpell(botAI, "lesser healing wave", bot, false) || TrySpell(botAI, "healing wave", bot, false);
+            break;
+        default:
+            break;
+    }
+    if (recovered)
+    {
+        DebugPvpTactical(botAI, "enemy-immunity-heal", target);
+        return true;
+    }
+
+    if (bot->getClass() == CLASS_MAGE && bot->GetHealthPct() >= 85.0f &&
+        bot->GetPowerPct(POWER_MANA) < 70.0f && ready("evocation"))
+    {
+        if (bot->isMoving())
+        {
+            StopOwnedPvpMovement(botAI);
+            return true;
+        }
+        if (TrySpell(botAI, "evocation", bot, false))
+        {
+            DebugPvpTactical(botAI, "enemy-immunity-evocation", target);
+            return true;
+        }
+    }
+
+    if (!bot->HasAura(11196))
+        if (Item* bandage = botAI->FindBandage())
+        {
+            if (bot->isMoving())
+            {
+                StopOwnedPvpMovement(botAI);
+                return true;
+            }
+            botAI->ImbueItem(bandage, bot);
+            DebugPvpTactical(botAI, "enemy-immunity-bandage", target);
+            return true;
+        }
+    return false;
+}
+
+bool HandlePvpMageIceBlock(PlayerbotAI* botAI, Unit* target, PvpSnapshot const& snapshot)
+{
+    Player* bot = botAI->GetBot();
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (bot->getClass() != CLASS_MAGE || !botAI->HasAura("ice block", bot))
+    {
+        state.mageIceBlockStartedAtMs = 0;
+        return false;
+    }
+
+    uint32 const now = getMSTime();
+    if (!state.mageIceBlockStartedAtMs)
+        state.mageIceBlockStartedAtMs = now;
+    uint32 const elapsed = now - state.mageIceBlockStartedAtMs;
+    bool const threatMovementDenied = target->HasUnitState(UNIT_STATE_ROOT) || target->HasRootAura() ||
+                                      target->isFrozen() || target->HasAuraType(SPELL_AURA_MOD_STUN);
+    if (ShouldReleasePvpIceBlock(elapsed, snapshot.incomingBurstScore, bot->GetDistance2d(target),
+                                 threatMovementDenied, target->GetHealthPct()))
+    {
+        botAI->RemoveAura("ice block");
+        state.mageIceBlockStartedAtMs = 0;
+        state.rangedCastPlantUntilMs = 0;
+        DebugPvpTactical(botAI, "mage-ice-block-release", target);
+        return true;
+    }
+
+    bot->AttackStop();
+    return true;
+}
+
+Unit* ResolvePvpClassActionTarget(PlayerbotAI* botAI)
+{
+    if (Unit* target = ResolvePvpThreatTarget(botAI))
+        return target;
+    Player* bot = botAI->GetBot();
+    Player* opponent = bot->duel ? bot->duel->Opponent : nullptr;
+    if (opponent && bot->duel->State == DUEL_STATE_IN_PROGRESS && opponent->IsAlive() &&
+        bot->CanSeeOrDetect(opponent, false, true))
+        return opponent;
+    return nullptr;
+}
