diff --git a/modules/mod-playerbots/src/Ai/Base/Actions/PvpTacticalActions.cpp b/modules/mod-playerbots/src/Ai/Base/Actions/PvpTacticalActions.cpp
index 9acb7f4..2917842 100644
--- a/modules/mod-playerbots/src/Ai/Base/Actions/PvpTacticalActions.cpp
+++ b/modules/mod-playerbots/src/Ai/Base/Actions/PvpTacticalActions.cpp
@@ -95,6 +95,40 @@ bool PvpTacticalClassControlAction::Execute(Event /*event*/)
             if (melee && TrySpell(botAI, "typhoon", target, false))
                 return true;
             return NeedsSlow(botAI, "entangling roots", target) && TrySpell(botAI, "entangling roots", target);
+        case CLASS_MAGE:
+            if (targetCasting && TrySpell(botAI, "counterspell", target, false))
+                return true;
+            if (melee && TrySpell(botAI, "frost nova", bot))
+                return true;
+            if (melee && TrySpell(botAI, "cone of cold", target, false))
+                return true;
+            if (bot->GetHealthPct() <= 60.0f && distance >= 8.0f && TrySpell(botAI, "polymorph", target))
+                return true;
+            return NeedsSlow(botAI, "slow", target) && TrySpell(botAI, "slow", target, false);
+        case CLASS_WARLOCK:
+            if (melee && TrySpell(botAI, "death coil", target))
+                return true;
+            if (distance <= 30.0f && TrySpell(botAI, "shadowfury", target))
+                return true;
+            return distance <= 30.0f && TrySpell(botAI, "fear", target);
+        case CLASS_PRIEST:
+            if (targetCasting && TrySpell(botAI, "silence", target, false))
+                return true;
+            if (melee && TrySpell(botAI, "psychic horror", target))
+                return true;
+            if (melee && TrySpell(botAI, "psychic scream", bot))
+                return true;
+            if (bot->GetHealthPct() < 55.0f && TrySpell(botAI, "power word: shield", bot, false))
+                return true;
+            return false;
+        case CLASS_SHAMAN:
+            if (targetCasting && TrySpell(botAI, "wind shear", target, false))
+                return true;
+            if (melee && TrySpell(botAI, "thunderstorm", bot, false))
+                return true;
+            if (distance < 12.0f && TrySpell(botAI, "earthbind totem", bot, false))
+                return true;
+            return NeedsSlow(botAI, "frost shock", target) && TrySpell(botAI, "frost shock", target, false);
         default:
             return false;
     }
