+bool ShouldSkipPvpMaintainedEffect(std::string const& spell, bool auraActive)
+{
+    if (!auraActive)
+        return false;
+
+    // Planned controls and explicit maintenance auras are conditions, not
+    // rotational damage effects. Recasting the same active aura only overwrites
+    // duration and lets high-priority utility starve pursuit or normal DPS.
+    static std::set<std::string> const maintainedEffects = {
+        "hunter's mark"
+    };
+    return IsPlannedControlAction(spell) || maintainedEffects.find(spell) != maintainedEffects.end();
+}
