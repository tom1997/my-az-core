+bool PvpTacticalMeleeFlankAction::Execute(Event /*event*/)
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsPlayer() || !botAI->IsMelee(bot, true))
+        return false;
+
+    float minAngle = std::clamp(sPlayerbotAIConfig.pvpTacticalMeleeMinAngle, 90.0f, 175.0f) * M_PI / 180.0f;
+    float maxAngle = std::clamp(sPlayerbotAIConfig.pvpTacticalMeleeMaxAngle, 90.0f, 175.0f) * M_PI / 180.0f;
+    if (minAngle > maxAngle)
+        std::swap(minAngle, maxAngle);
+
+    float const angle = frand(minAngle, maxAngle);
+    float const distance = std::max(1.0f, bot->GetMeleeRange(target) * 0.6f);
+    Position left = target->GetPosition();
+    Position right = target->GetPosition();
+    left.RelocatePolarOffset(angle, distance);
+    right.RelocatePolarOffset(-angle, distance);
+
+    std::vector<Position> candidates;
+    for (Position const& position : {left, right})
+    {
+        float x = position.GetPositionX();
+        float y = position.GetPositionY();
+        float z = position.GetPositionZ();
+        if (bot->GetMap()->CheckCollisionAndGetValidCoords(bot, bot->GetPositionX(), bot->GetPositionY(),
+                                                            bot->GetPositionZ(), x, y, z))
+            candidates.emplace_back(x, y, z);
+    }
+
+    if (candidates.empty())
+        return false;
+
+    Position destination = candidates.front();
+    for (Position const& candidate : candidates)
+        if (bot->GetExactDist2d(candidate) < bot->GetExactDist2d(destination))
+            destination = candidate;
+    return MoveTo(bot->GetMapId(), destination.GetPositionX(), destination.GetPositionY(),
+                  destination.GetPositionZ(), false, false, false, true, MovementPriority::MOVEMENT_COMBAT);
+}
+
+bool PvpTacticalMeleeFlankAction::isUseful()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    return sPlayerbotAIConfig.pvpTacticalEnabled && sPlayerbotAIConfig.pvpTacticalMeleeEnabled && target &&
+           target->IsPlayer() && botAI->IsMelee(bot, true);
+}
