+PvpTacticalMeleeFlankTrigger::PvpTacticalMeleeFlankTrigger(PlayerbotAI* botAI)
+    : Trigger(botAI, "pvp tactical melee flank", sPlayerbotAIConfig.pvpTacticalMeleeDecisionInterval)
+{
+}
+
+bool PvpTacticalMeleeFlankTrigger::IsActive()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!sPlayerbotAIConfig.pvpTacticalMeleeEnabled || !target || !target->IsPlayer() ||
+        !IsPvpTacticalContextEnabled(bot) || !botAI->IsMelee(bot, true))
+        return false;
+
+    if (bot->HasRootAura() || bot->HasStunAura() || bot->HasUnitState(UNIT_STATE_LOST_CONTROL))
+        return false;
+
+    float const engageDistance = bot->GetMeleeRange(target) + sPlayerbotAIConfig.pvpTacticalMeleeFlankDistance;
+    if (bot->GetDistance2d(target) > engageDistance)
+        return false;
+
+    // Reposition only while inside the target's front half. Once behind it, the
+    // normal rotation continues until the opponent turns to face the bot again.
+    return target->HasInArc(M_PI, bot);
+}
