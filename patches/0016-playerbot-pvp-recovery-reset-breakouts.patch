+bool MoveRogueResetAway(PlayerbotAI* botAI, Unit* target)
+{
+    Player* bot = botAI->GetBot();
+    if (IsPvpMovementActive(botAI, bot, PvpMovementOwner::RogueReset))
+        return true;
+
+    float const desired = std::clamp(sPlayerbotAIConfig.pvpTacticalRogueResetDistance, 18.0f, 45.0f);
+    float const distance = bot->GetDistance2d(target);
+    if (distance >= desired)
+        return false;
+
+    float const step = std::min(12.0f, std::max(4.0f, desired - distance));
+    float const baseAngle = target->GetAngle(bot);
+    GameObject* duelFlag = bot->duel ? bot->GetMap()->GetGameObject(bot->GetGuidValue(PLAYER_DUEL_ARBITER)) : nullptr;
+    bool found = false;
+    Position best;
+    float bestDistance = distance;
+    for (float const offset : { 0.0f, float(M_PI / 4.0), float(-M_PI / 4.0), float(M_PI / 2.0), float(-M_PI / 2.0) })
+    {
+        float x = bot->GetPositionX() + std::cos(baseAngle + offset) * step;
+        float y = bot->GetPositionY() + std::sin(baseAngle + offset) * step;
+        float z = bot->GetPositionZ();
+        if (!bot->GetMap()->CheckCollisionAndGetValidCoords(bot, bot->GetPositionX(), bot->GetPositionY(),
+                                                             bot->GetPositionZ(), x, y, z))
+            continue;
+        if (duelFlag && duelFlag->GetDistance2d(x, y) > sPlayerbotAIConfig.pvpTacticalDuelSafeRadius)
+            continue;
+        float const candidateDistance = target->GetDistance2d(x, y);
+        if (!found || candidateDistance > bestDistance)
+        {
+            found = true;
+            bestDistance = candidateDistance;
+            best.Relocate(x, y, z);
+        }
+    }
+    if (!found)
+        return false;
+
+    ClaimPvpMovement(botAI, PvpMovementOwner::RogueReset, target);
+    SetPvpMovementDestination(botAI, best.GetPositionX(), best.GetPositionY());
+    bot->GetMotionMaster()->Clear(false);
+    bot->GetMotionMaster()->MovePoint(0, best.GetPositionX(), best.GetPositionY(), best.GetPositionZ(),
+                                      FORCED_MOVEMENT_NONE, 0.0f, 0.0f, true, false);
+    DebugPvpTactical(botAI, "rogue-reset-move", target);
+    return true;
+}
+
+bool TryRogueReset(PlayerbotAI* botAI, Unit* target)
+{
+    Player* bot = botAI->GetBot();
+    if (bot->getClass() != CLASS_ROGUE)
+        return false;
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+
+    if (!state.rogueResetting && bot->GetHealthPct() <= sPlayerbotAIConfig.pvpTacticalRogueResetHealthPct)
+    {
+        if (bot->GetDistance2d(target) <= 15.0f && TrySpell(botAI, "blind", target))
+            return true;
+        state.rogueResetting = true;
+        state.rogueResetStartedAtMs = now;
+        DebugPvpTactical(botAI, "rogue-reset-start", target);
+    }
+    if (!state.rogueResetting)
+        return false;
+
+    uint32 const elapsed = now - state.rogueResetStartedAtMs;
+    if (bot->GetHealthPct() >= 70.0f || elapsed >= 16000)
+    {
+        state.rogueResetting = false;
+        state.rogueResetStartedAtMs = 0;
+        ClearPvpMovement(botAI, PvpMovementOwner::RogueReset);
+        DebugPvpTactical(botAI, "rogue-reset-reopen", target);
+        return false;
+    }
+
+    bool const stealthed = botAI->HasAura("stealth", bot);
+    if (!stealthed)
+    {
+        if (!bot->IsInCombat() && bot->GetStandState() == UNIT_STAND_STATE_SIT && bot->GetHealthPct() < 70.0f)
+            return true;
+        if (TrySpell(botAI, "vanish", bot, false) || (!bot->IsInCombat() && TrySpell(botAI, "stealth", bot, false)))
+            return true;
+        // After bandaging, wait briefly for combat to drop and re-stealth. If
+        // the opponent closes to melee, abandon the reset and defend normally.
+        if (bot->GetDistance2d(target) > 10.0f)
+            return true;
+        state.rogueResetting = false;
+        return false;
+    }
+
+    bot->AttackStop();
+    botAI->PetFollow();
+    if (MoveRogueResetAway(botAI, target))
+        return true;
+
+    if (!bot->IsInCombat() && bot->GetHealthPct() < 70.0f && botAI->DoSpecificAction("food", Event(), true))
+    {
+        DebugPvpTactical(botAI, "rogue-reset-eat", target);
+        return true;
+    }
+
+    if (bot->GetHealthPct() < 60.0f && !bot->HasAura(11196))
+        if (Item* bandage = botAI->FindBandage())
+        {
+            botAI->ImbueItem(bandage, bot);
+            DebugPvpTactical(botAI, "rogue-reset-bandage", target);
+            return true;
+        }
+
+    // Hold stealth long enough to pool energy and let short cooldowns recover,
+    // then reopen even if no healing item was available.
+    if (elapsed >= 8000)
+    {
+        state.rogueResetting = false;
+        return false;
+    }
+    return true;
+}
 }
 
