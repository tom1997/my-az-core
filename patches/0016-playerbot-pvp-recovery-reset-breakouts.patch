+bool TryControlWindowRecovery(PlayerbotAI* botAI, Unit* target)
+{
+    Player* bot = botAI->GetBot();
+    if (bot->GetHealthPct() >= sPlayerbotAIConfig.pvpTacticalRecoveryHealthPct)
+        return false;
+
+    int32 const remaining = BreakableControlRemainingMs(botAI, target);
+    if (remaining < int32(sPlayerbotAIConfig.pvpTacticalRecoveryMinControlMs))
+        return false;
+
+    bot->AttackStop();
+    botAI->PetFollow();
+    if (bot->isMoving())
+    {
+        StopOwnedPvpMovement(botAI);
+        DebugPvpTactical(botAI, "control-window-stop", target);
+        return true;
+    }
+    if (bot->IsNonMeleeSpellCast(false))
+        return true;
+
+    bool healed = false;
+    switch (bot->getClass())
+    {
+        case CLASS_DRUID:
+            if (bot->GetShapeshiftForm() != FORM_NONE)
+            {
+                botAI->RemoveShapeshift();
+                return true;
+            }
+            healed = (!botAI->HasAura("rejuvenation", bot) && TrySpell(botAI, "rejuvenation", bot, false)) ||
+                     TrySpell(botAI, "regrowth", bot, false) || TrySpell(botAI, "healing touch", bot, false);
+            break;
+        case CLASS_PALADIN:
+            healed = TrySpell(botAI, "flash of light", bot, false) || TrySpell(botAI, "holy light", bot, false);
+            break;
+        case CLASS_PRIEST:
+            healed = (!botAI->HasAura("renew", bot) && TrySpell(botAI, "renew", bot, false)) ||
+                     TrySpell(botAI, "flash heal", bot, false) || TrySpell(botAI, "greater heal", bot, false);
+            break;
+        case CLASS_SHAMAN:
+            healed = TrySpell(botAI, "riptide", bot, false) || TrySpell(botAI, "lesser healing wave", bot, false) ||
+                     TrySpell(botAI, "healing wave", bot, false);
+            break;
+        case CLASS_DEATH_KNIGHT:
+            healed = TrySpell(botAI, "rune tap", bot, false) || TrySpell(botAI, "death pact", bot, false);
+            break;
+        case CLASS_WARRIOR:
+            healed = TrySpell(botAI, "enraged regeneration", bot, false);
+            break;
+        default:
+            break;
+    }
+    if (healed)
+    {
+        DebugPvpTactical(botAI, "control-window-heal", target);
+        return true;
+    }
+
+    if (remaining >= int32(sPlayerbotAIConfig.pvpTacticalBandageMinControlMs) && !bot->HasAura(11196))
+        if (Item* bandage = botAI->FindBandage())
+        {
+            botAI->ImbueItem(bandage, bot);
+            DebugPvpTactical(botAI, "control-window-bandage", target);
+            return true;
+        }
+
+    // Do not immediately break a useful recovery control merely because this
+    // bot has no heal or bandage available. The next tick may gain enough mana
+    // or finish a global cooldown; resume pressure near the end of the aura.
+    return true;
+}
