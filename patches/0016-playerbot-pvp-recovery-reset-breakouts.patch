+bool TryAntiStealthProbe(PlayerbotAI* botAI, Unit* target)
+{
+    Player* bot = botAI->GetBot();
+    if (!target || target->getClass() != CLASS_ROGUE || !botAI->HasAura("stealth", target) ||
+        bot->GetDistance2d(target) > sPlayerbotAIConfig.pvpTacticalAntiStealthProbeDistance)
+        return false;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (now - state.lastAntiStealthProbeAtMs < 2500)
+        return false;
+    state.lastAntiStealthProbeAtMs = now;
+
+    bool cast = false;
+    switch (bot->getClass())
+    {
+        case CLASS_WARRIOR: cast = TrySpell(botAI, "thunder clap", bot, false); break;
+        case CLASS_PALADIN: cast = TrySpell(botAI, "consecration", bot, false); break;
+        case CLASS_HUNTER:
+            cast = TrySpell(botAI, "explosive trap", bot, false) || TrySpell(botAI, "immolation trap", bot, false);
+            break;
+        case CLASS_ROGUE: cast = TrySpell(botAI, "fan of knives", bot, false); break;
+        case CLASS_PRIEST: cast = TrySpell(botAI, "holy nova", bot, false); break;
+        case CLASS_DEATH_KNIGHT: cast = TrySpell(botAI, "blood boil", bot, false); break;
+        case CLASS_SHAMAN:
+            cast = TrySpell(botAI, "magma totem", bot, false) || TrySpell(botAI, "fire nova", bot, false);
+            break;
+        case CLASS_MAGE: cast = TrySpell(botAI, "arcane explosion", bot, false); break;
+        case CLASS_WARLOCK: cast = TrySpell(botAI, "hellfire", bot, false); break;
+        case CLASS_DRUID: cast = TrySpell(botAI, "hurricane", bot, false) || TrySpell(botAI, "swipe", bot, false); break;
+        default: break;
+    }
+    if (cast)
+        DebugPvpTactical(botAI, "anti-stealth-probe", target);
+    return cast;
+}
