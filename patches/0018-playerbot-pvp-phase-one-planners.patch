+bool ShouldCommitPvpInterrupt(PlayerbotAI* botAI, Unit* caster)
+{
+    if (!botAI || !caster || !caster->IsPlayer() || !IsPvpTacticalContextEnabled(botAI->GetBot()))
+        return true;
+    Spell* spell = CurrentPvpCast(caster);
+    if (!spell || !spell->m_spellInfo)
+        return false;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    bool const highValue = IsHealingOrControlSpell(spell->m_spellInfo);
+    StartEnemyCastObservation(botAI, caster, spell, highValue, getMSTime());
+    uint32 const total = std::max<int32>(1, spell->GetCastTime());
+    uint32 const remaining = std::max<int32>(0, spell->GetCastTimeRemaining());
+    float const progress = std::clamp(1.0f - float(remaining) / float(total), 0.0f, 1.0f);
+    state.observedEnemyCastProgress = progress;
+    float threshold = state.interruptCommitPct > 0.0f ? state.interruptCommitPct : 0.70f;
+    if (highValue)
+        threshold = std::min(threshold, float(sPlayerbotAIConfig.pvpTacticalInterruptCriticalMaxPct) / 100.0f);
+    return progress >= threshold || remaining <= sPlayerbotAIConfig.pvpTacticalHumanReactionMaxMs;
+}
