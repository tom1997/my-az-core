+float ScorePvpTarget(PlayerbotAI* botAI, Unit* candidate)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot || !candidate || !candidate->IsPlayer() || !candidate->IsAlive() || !bot->IsHostileTo(candidate) ||
+        !bot->CanSeeOrDetect(candidate, false, true))
+        return 0.0f;
+
+    Player* player = candidate->ToPlayer();
+    float score = (100.0f - player->GetHealthPct()) / 100.0f * 0.32f;
+    if (PlayerbotAI::IsHeal(player, true))
+        score += 0.18f;
+    if (player->GetVictim() == bot)
+        score += 0.15f;
+    if (CurrentPvpCast(player))
+        score += 0.08f;
+    if (player->HasAura(23333) || player->HasAura(23335) || player->HasAura(34976))
+        score += 0.30f;
+    if (HasMajorDefensive(player))
+        score -= 0.45f;
+    score -= std::clamp(bot->GetDistance2d(player) / 80.0f, 0.0f, 0.30f);
+
+    if (Group* group = bot->GetGroup())
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (!member || member == bot)
+                continue;
+            if (member->GetVictim() == player)
+                score += GET_PLAYERBOT_AI(member) ? 0.08f : 0.16f;
+        }
+
+    return std::clamp(score, 0.0f, 1.0f);
+}
