+PvpSnapshot PvpSnapshotValue::Calculate()
+{
+    PvpSnapshot snapshot;
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!IsPvpTacticalEligible(bot) || !IsPvpTacticalContextEnabled(bot))
+        return snapshot;
+
+    uint32 const now = getMSTime();
+    snapshot.capturedAtMs = now;
+    snapshot.archetype = DetectPvpArchetype(botAI);
+    snapshot.triage = CalculateTriage(botAI);
+    snapshot.incomingBurstScore = IncomingBurstAgainst(bot);
+    snapshot.defensiveNeedScore = std::max(snapshot.incomingBurstScore, snapshot.triage.dangerScore);
+    snapshot.castSafetyScore = std::clamp(1.0f - snapshot.incomingBurstScore * 0.65f, 0.0f, 1.0f);
+
+    if (Pet* pet = bot->GetPet())
+    {
+        snapshot.pet.petGuid = pet->GetGUID();
+        snapshot.pet.alive = pet->IsAlive();
+        snapshot.pet.healthPct = pet->GetHealthPct();
+        if (pet->GetMaxPower(POWER_ENERGY))
+            snapshot.pet.resourcePct = pet->GetPowerPct(POWER_ENERGY);
+        else if (pet->GetMaxPower(POWER_FOCUS))
+            snapshot.pet.resourcePct = pet->GetPowerPct(POWER_FOCUS);
+        else if (pet->GetMaxPower(POWER_MANA))
+            snapshot.pet.resourcePct = pet->GetPowerPct(POWER_MANA);
+        snapshot.pet.controlSpellId = FindPetSpell(botAI, pet, { "gnaw", "spell lock", "seduction", "intimidation" });
+        snapshot.pet.defensiveSpellId = FindPetSpell(botAI, pet, { "huddle", "roar of sacrifice", "master's call" });
+        snapshot.pet.controlReady = snapshot.pet.controlSpellId && !pet->HasSpellCooldown(snapshot.pet.controlSpellId);
+        snapshot.pet.defensiveReady = snapshot.pet.defensiveSpellId && !pet->HasSpellCooldown(snapshot.pet.defensiveSpellId);
+    }
+
+    Unit* current = botAI->GetAiObjectContext()->GetValue<Unit*>("current target")->Get();
+    if (bot->duel && bot->duel->Opponent)
+        current = bot->duel->Opponent;
+    if (!current || !current->IsPlayer() || !current->IsAlive() || !bot->IsHostileTo(current) ||
+        current->GetMap() != bot->GetMap())
+        current = ResolvePvpThreatTarget(botAI);
+    if (!current)
+        return snapshot;
+    snapshot.primaryTarget = current->GetGUID();
+    snapshot.targetMajorDefensive = HasMajorDefensive(current);
+    snapshot.targetHardControlled = IsHardControlled(current);
+
+    std::vector<Unit*> candidates;
+    std::set<ObjectGuid> seen;
+    AddPvpCandidate(botAI, current, candidates, seen);
+    for (Unit* attacker : bot->getAttackers())
+        AddPvpCandidate(botAI, attacker, candidates, seen);
+    for (ObjectGuid const& guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest enemy players")->Get())
+        AddPvpCandidate(botAI, botAI->GetUnit(guid), candidates, seen);
+
+    snapshot.currentTargetScore = ScorePvpTarget(botAI, current);
+    snapshot.recommendedTarget = current->GetGUID();
+    snapshot.recommendedTargetScore = snapshot.currentTargetScore;
+    for (Unit* candidate : candidates)
+    {
+        float const score = ScorePvpTarget(botAI, candidate);
+        if (score > snapshot.recommendedTargetScore ||
+            (std::abs(score - snapshot.recommendedTargetScore) < 0.01f &&
+             candidate->GetGUID() < snapshot.recommendedTarget))
+        {
+            snapshot.recommendedTarget = candidate->GetGUID();
+            snapshot.recommendedTargetScore = score;
+        }
+    }
+
+    if (Unit* ccTarget = ResolvePvpControlTarget(botAI, current))
+        snapshot.ccTarget = ccTarget->GetGUID();
+
+    if (Spell* spell = CurrentPvpCast(current))
+    {
+        snapshot.enemyCastSpellId = spell->m_spellInfo ? spell->m_spellInfo->Id : 0;
+        snapshot.enemyCastRemainingMs = std::max<int32>(0, spell->GetCastTimeRemaining());
+        snapshot.enemyCastTotalMs = std::max<int32>(1, spell->GetCastTime());
+        snapshot.enemyCastProgress = std::clamp(
+            1.0f - float(snapshot.enemyCastRemainingMs) / float(snapshot.enemyCastTotalMs), 0.0f, 1.0f);
+        snapshot.enemyCastHighValue = IsHealingOrControlSpell(spell->m_spellInfo);
+    }
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (snapshot.enemyCastSpellId)
+    {
+        StartEnemyCastObservation(botAI, current, CurrentPvpCast(current), snapshot.enemyCastHighValue, now);
+        state.observedEnemyCastProgress = snapshot.enemyCastProgress;
+    }
+    else if (state.observedEnemyCastSpellId && state.observedEnemyCasterGuid == current->GetGUID())
+    {
+        if (!state.interruptCommitted && state.observedEnemyCastProgress >= 0.12f &&
+            state.observedEnemyCastProgress < 0.82f && now - state.observedEnemyCastStartedAtMs < 4000)
+        {
+            state.enemyFakeCastStreak = std::min<uint8>(3, state.enemyFakeCastStreak + 1);
+            state.lastFakeCastObservedAtMs = now;
+        }
+        state.observedEnemyCasterGuid.Clear();
+        state.observedEnemyCastSpellId = 0;
+        state.observedEnemyCastProgress = 0.0f;
+        state.interruptCommitted = false;
+    }
+    if (state.enemyFakeCastStreak && now - state.lastFakeCastObservedAtMs > 15000)
+        --state.enemyFakeCastStreak;
+
+    Player* enemy = current->ToPlayer();
+    snapshot.enemyInterruptThreat = CanThreatenInterrupt(enemy, bot);
+    float const distance = bot->GetDistance2d(current);
+    snapshot.connectScore = std::clamp((distance - 5.0f) / 20.0f +
+                                           (snapshot.enemyCastHighValue ? 0.25f : 0.0f) +
+                                           (current->GetHealthPct() <= 30.0f ? 0.20f : 0.0f),
+                                       0.0f, 1.0f);
+    snapshot.killWindowScore = std::clamp((100.0f - current->GetHealthPct()) / 100.0f * 0.55f +
+                                              (snapshot.targetHardControlled ? 0.20f : 0.0f) +
+                                              (snapshot.targetMajorDefensive ? -0.55f : 0.0f) +
+                                              (current->GetHealthPct() <= 35.0f ? 0.30f : 0.0f),
+                                          0.0f, 1.0f);
+    snapshot.castSafetyScore = 1.0f - snapshot.incomingBurstScore * 0.55f;
+    if (current->GetVictim() == bot && distance < 12.0f)
+        snapshot.castSafetyScore -= 0.30f;
+    if (snapshot.enemyInterruptThreat)
+        snapshot.castSafetyScore -= 0.20f;
+    if (snapshot.targetHardControlled)
+        snapshot.castSafetyScore += 0.25f;
+    snapshot.castSafetyScore = std::clamp(snapshot.castSafetyScore, 0.0f, 1.0f);
+
+    if (!bot->duel && !bot->InArena() && !bot->InBattleground() &&
+        distance > sPlayerbotAIConfig.pvpTacticalTargetLeashDistance)
+        snapshot.intent = PvpIntent::Disengage;
+    else if (state.rogueResetting)
+        snapshot.intent = PvpIntent::Reset;
+    else if (snapshot.killWindowScore >= 0.72f)
+        snapshot.intent = PvpIntent::Finish;
+    else if (snapshot.incomingBurstScore >= 0.72f || bot->GetHealthPct() <= 25.0f)
+        snapshot.intent = PvpIntent::Survive;
+    else if (snapshot.triage.targetGuid != bot->GetGUID() && snapshot.triage.dangerScore >= 0.65f)
+        snapshot.intent = PvpIntent::Peel;
+    else if (bot->GetHealthPct() <= sPlayerbotAIConfig.pvpTacticalRecoveryHealthPct &&
+             snapshot.targetHardControlled)
+        snapshot.intent = PvpIntent::Recover;
+    else if ((botAI->IsRanged(bot, true) || botAI->IsHeal(bot)) && !botAI->IsRanged(enemy, true) &&
+             distance < state.desiredDistance)
+        snapshot.intent = PvpIntent::Kite;
+    else if (!snapshot.ccTarget.IsEmpty())
+        snapshot.intent = PvpIntent::Control;
+    else
+        snapshot.intent = PvpIntent::Pressure;
+
+    Spell* ownCast = bot->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+    if (!ownCast)
+    {
+        state.observedOwnCastSpellId = 0;
+        state.ownFakeCastEvaluated = false;
+        state.ownFakeCastPlanned = false;
+    }
+    return snapshot;
+}
