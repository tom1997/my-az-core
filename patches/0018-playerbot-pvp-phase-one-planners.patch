+        if (CurrentPvpCast(candidate))
+            score += 0.25f;
+        score -= bot->GetDistance2d(candidate) / 100.0f;
+        if (score > bestScore)
+        {
+            best = candidate;
+            bestScore = score;
+        }
+    }
+    return best;
+}
