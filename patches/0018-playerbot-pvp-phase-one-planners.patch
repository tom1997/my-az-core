+                       PvpArchetype::UnholyDeathKnight : PvpArchetype::Generic;
+        case CLASS_HUNTER:
+            return HasPvpSpell(botAI, "chimera shot") && HasPvpSpell(botAI, "aimed shot") ?
+                       PvpArchetype::MarksmanshipHunter : PvpArchetype::Generic;
+        case CLASS_ROGUE:
