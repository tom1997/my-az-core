+float IncomingBurstAgainst(Player* player)
+{
+    if (!player)
+        return 0.0f;
+    float score = 0.0f;
+    for (Unit* attacker : player->getAttackers())
+    {
+        if (!attacker || !attacker->IsPlayer())
+            continue;
+        score += attacker->IsWithinMeleeRange(player) ? 0.18f : 0.12f;
+        if (HasMajorOffensive(attacker))
+            score += 0.28f;
+    }
+    return std::clamp(score, 0.0f, 1.0f);
+}
+
+float AllyDanger(Player* ally, Player* healer)
+{
+    if (!ally || !ally->IsAlive())
+        return 0.0f;
+    float score = std::clamp((75.0f - ally->GetHealthPct()) / 75.0f, 0.0f, 1.0f) * 0.55f;
+    score += IncomingBurstAgainst(ally) * 0.35f;
+    if (healer && healer != ally && IsHardControlled(healer))
+        score += 0.15f;
+    if (healer && healer != ally && !healer->IsWithinLOSInMap(ally))
+        score += 0.10f;
+    return std::clamp(score, 0.0f, 1.0f);
+}
+
+PvpAllyTriage CalculateTriage(PlayerbotAI* botAI)
+{
+    PvpAllyTriage result;
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot)
+        return result;
+
+    std::vector<Player*> allies;
+    if (Group* group = bot->GetGroup())
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (member && member->IsAlive() && !member->IsGameMaster() && member->GetMap() == bot->GetMap() &&
+                bot->GetDistance2d(member) <= sPlayerbotAIConfig.healDistance * 2.0f)
+                allies.push_back(member);
+        }
+    if (allies.empty())
+        allies.push_back(bot);
+
+    Player* healer = nullptr;
+    for (Player* ally : allies)
+        if (PlayerbotAI::IsHeal(ally, true) && (!healer || ally->GetGUID() < healer->GetGUID()))
+            healer = ally;
+
+    for (Player* ally : allies)
+    {
+        float const danger = AllyDanger(ally, healer);
+        if (result.targetGuid.IsEmpty() || danger > result.dangerScore ||
+            (std::abs(danger - result.dangerScore) < 0.01f && ally->GetGUID() < result.targetGuid))
+        {
+            result.targetGuid = ally->GetGUID();
+            result.healthPct = ally->GetHealthPct();
+            result.dangerScore = danger;
+            result.incomingBurstScore = IncomingBurstAgainst(ally);
+            result.mobilityNeed = botAI->IsMovementImpaired(ally) ?
+                                      std::clamp(0.45f + result.incomingBurstScore, 0.0f, 1.0f) : 0.0f;
+            result.healerControlled = healer && IsHardControlled(healer);
+            result.lineOfSightToHealer = !healer || healer == ally || healer->IsWithinLOSInMap(ally);
+        }
+    }
+    return result;
+}
