+    Unit* target = botAI->GetUnit(snapshot.primaryTarget);
+    if (!target || !snapshot.enemyInterruptThreat || snapshot.intent == PvpIntent::Finish ||
+        snapshot.intent == PvpIntent::Survive || snapshot.castSafetyScore < 0.35f)
+        return false;
