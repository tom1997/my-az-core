+bool PvpTacticalFakeCastAction::Execute(Event /*event*/)
+{
+    Unit* target = ResolvePvpThreatTarget(botAI);
+    bot->InterruptNonMeleeSpells(false);
+    DebugPvpTactical(botAI, "fake-cast-cancel", target);
+    return true;
+}
+
+bool PvpTacticalTargetSwapAction::isUseful()
+{
+    if (bot->duel && bot->duel->Opponent)
+        return false;
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    if (snapshot.recommendedTarget.IsEmpty() || snapshot.recommendedTarget == snapshot.primaryTarget)
+        return false;
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (state.lastTargetSwapAtMs && now - state.lastTargetSwapAtMs < sPlayerbotAIConfig.pvpTacticalTargetSwapMinHoldMs)
+        return false;
+    return snapshot.recommendedTargetScore >=
+           snapshot.currentTargetScore + sPlayerbotAIConfig.pvpTacticalTargetSwapAdvantage;
+}
+
+bool PvpTacticalTargetSwapAction::Execute(Event /*event*/)
+{
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    Unit* target = botAI->GetUnit(snapshot.recommendedTarget);
+    if (!target || !target->IsPlayer() || !target->IsAlive() || !bot->IsHostileTo(target))
+        return false;
+
+    bot->SetSelection(target->GetGUID());
+    context->GetValue<Unit*>("current target")->Set(target);
+    bot->Attack(target, bot->IsWithinMeleeRange(target) || !PlayerbotAI::IsRanged(bot));
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    state.lastTargetSwapAtMs = getMSTime();
+    state.targetGuid = target->GetGUID();
+    DebugPvpTactical(botAI, "target-swap", target);
+    return true;
+}
