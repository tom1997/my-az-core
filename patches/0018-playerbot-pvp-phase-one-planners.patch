+            !bot->IsHostileTo(candidate) || !bot->CanSeeOrDetect(candidate, false, true) ||
+            bot->GetDistance2d(candidate) > 30.0f || HasMajorDefensive(candidate) || IsHardControlled(candidate))
+            continue;
