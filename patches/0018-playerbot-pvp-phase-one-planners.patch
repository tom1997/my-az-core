+# Humanized interrupt planning. Normal casts are committed late; healing and
+# hard-control casts may be stopped earlier. The remaining-time safety net
+# avoids missing very short casts because of the tactical tick interval.
+AiPlayerbot.PvPTactical.Interrupt.NormalMinPct = 60
+AiPlayerbot.PvPTactical.Interrupt.NormalMaxPct = 85
+AiPlayerbot.PvPTactical.Interrupt.CriticalMinPct = 35
+AiPlayerbot.PvPTactical.Interrupt.CriticalMaxPct = 60
+AiPlayerbot.PvPTactical.HumanReactionMaxMs = 320
+
+# Minimum shared safety score for a cast of two seconds or longer. Fake casts
+# are sampled once per cast and rate-limited; they never inspect hidden enemy CDs.
+AiPlayerbot.PvPTactical.CastSafety.MinScore = 0.55
+AiPlayerbot.PvPTactical.FakeCast.Enable = 1
+AiPlayerbot.PvPTactical.FakeCast.ChancePct = 25
+AiPlayerbot.PvPTactical.FakeCast.CooldownMs = 12000
+
+# A new target must beat the current target by this normalized score and the
+# current target must have been held for at least this long.
+AiPlayerbot.PvPTactical.TargetSwap.MinHoldMs = 2000
+AiPlayerbot.PvPTactical.TargetSwap.Advantage = 0.20
+
 # When a damage-breakable player control has enough time remaining, a low-health
 # bot pauses attacks to self-heal. Bandages require a longer safe window.
 AiPlayerbot.PvPTactical.Recovery.HealthPct = 40.0
