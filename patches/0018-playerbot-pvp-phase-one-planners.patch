+    state.observedEnemyCasterGuid = caster->GetGUID();
+    state.observedEnemyCastSpellId = spell->m_spellInfo->Id;
+    state.observedEnemyCastStartedAtMs = now;
+    state.observedEnemyCastProgress = 0.0f;
+    state.interruptCommitted = false;
+
+    uint32 minPct = highValue ? sPlayerbotAIConfig.pvpTacticalInterruptCriticalMinPct :
+                                sPlayerbotAIConfig.pvpTacticalInterruptNormalMinPct;
+    uint32 maxPct = highValue ? sPlayerbotAIConfig.pvpTacticalInterruptCriticalMaxPct :
+                                sPlayerbotAIConfig.pvpTacticalInterruptNormalMaxPct;
+    minPct = std::min<uint32>(95, minPct + state.enemyFakeCastStreak * 5);
+    maxPct = std::max(minPct, std::min<uint32>(95, maxPct + state.enemyFakeCastStreak * 5));
+    state.interruptCommitPct = float(urand(minPct, maxPct)) / 100.0f;
+}
