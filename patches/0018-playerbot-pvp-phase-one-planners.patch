+void StartEnemyCastObservation(PlayerbotAI* botAI, Unit* caster, Spell* spell, bool highValue, uint32 now)
+{
+    if (!botAI || !caster || !spell || !spell->m_spellInfo)
+        return;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (state.observedEnemyCasterGuid == caster->GetGUID() &&
+        state.observedEnemyCastSpellId == spell->m_spellInfo->Id)
+        return;
