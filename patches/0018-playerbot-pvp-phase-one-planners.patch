+            return distance <= 8.0f;
+        case CLASS_DEATH_KNIGHT:
+            return distance <= 10.0f;
+        case CLASS_PALADIN:
+            return distance <= 12.0f;
+        case CLASS_SHAMAN:
+        case CLASS_MAGE:
+        case CLASS_HUNTER:
+        case CLASS_PRIEST:
