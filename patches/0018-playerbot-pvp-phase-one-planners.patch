+bool IsSafeForPvpCast(PlayerbotAI* botAI, Unit* /*spellTarget*/, uint32 castMs)
+{
+    if (!botAI || castMs < 1000 || !IsPvpTacticalContextEnabled(botAI->GetBot()))
+        return true;
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    if (snapshot.intent == PvpIntent::Survive || snapshot.incomingBurstScore > 0.78f)
+        return false;
+    float const minimumSafety = sPlayerbotAIConfig.pvpTacticalCastSafetyMin;
+    if (castMs >= 2000 && snapshot.castSafetyScore < minimumSafety)
+        return false;
+    return castMs < 2000 || snapshot.castSafetyScore >= minimumSafety - 0.12f;
+}
