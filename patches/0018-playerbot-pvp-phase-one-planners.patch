+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (now - state.lastOwnFakeCastAtMs < sPlayerbotAIConfig.pvpTacticalFakeCastCooldownMs)
