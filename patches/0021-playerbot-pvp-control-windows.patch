+
+bool TryDuelControlWindow(PlayerbotAI* botAI, Unit* target, PvpSnapshot const& snapshot)
+{
+    Player* bot = botAI->GetBot();
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    PvpControlWindow const& window = snapshot.controlWindow;
+    bool const duelPrimary = bot->duel && bot->duel->Opponent == target &&
+                             bot->duel->State == DUEL_STATE_IN_PROGRESS;
+    if (!duelPrimary || !window.active || window.targetGuid != target->GetGUID() ||
+        (window.controlState != PvpControlState::DamageBreakable &&
+         window.controlState != PvpControlState::DamageImmune))
+    {
+        ResetDuelControlWindow(state);
+        return false;
+    }
+
+    uint32 const now = getMSTime();
+    bool const newWindow = state.controlWindowTargetGuid != target->GetGUID() ||
+                           state.controlWindowSpellId != window.controlSpellId ||
+                           window.remainingMs > state.controlWindowLastRemainingMs + 500;
+    if (newWindow)
+    {
+        state.controlWindowTargetGuid = target->GetGUID();
+        state.controlWindowStartedAtMs = now;
+        state.controlWindowSpellId = window.controlSpellId;
+        state.controlWindowReadyToBreak = false;
+        DebugPvpTactical(botAI, "control-window-start", target);
+    }
+    state.controlWindowLastRemainingMs = window.remainingMs;
+
+    bot->AttackStop();
+    botAI->PetFollow();
+
+    if (IsPvpMovementActive(botAI, bot, PvpMovementOwner::Retreat))
+        return true;
+
+    bool const ranged = botAI->IsRanged(bot, true) || botAI->IsHeal(bot);
+    bool positioningComplete = true;
+    if (ranged && window.expectedRemainingMs > 500)
+    {
+        float const preferredDistance = GetControlWindowPreferredDistance(botAI, bot, target);
+        state.desiredDistance = preferredDistance;
+        if (bot->GetDistance2d(target) + 1.0f < preferredDistance)
+        {
+            positioningComplete = false;
+            state.retreating = true;
+            if (botAI->DoSpecificAction("pvp tactical retreat", Event(), true))
+            {
+                DebugPvpTactical(botAI, "control-window-reposition", target);
+                return true;
+            }
+        }
+    }
+
+    if (state.movementOwner != PvpMovementOwner::None && IsPvpMovementActive(botAI, bot))
+    {
+        StopOwnedPvpMovement(botAI);
+        DebugPvpTactical(botAI, "control-window-positioned", target);
+        return true;
+    }
+
+    if (TryControlWindowRecovery(botAI, target, window))
+        return true;
+
+    if (window.usage == PvpCcUsage::Reset && bot->getClass() == CLASS_ROGUE)
+    {
+        if (!botAI->HasAura("stealth", bot) &&
+            (TrySpell(botAI, "vanish", bot, false) ||
+             (!bot->IsInCombat() && TrySpell(botAI, "stealth", bot, false))))
+        {
+            DebugPvpTactical(botAI, "control-window-reset-stealth", target);
+            return true;
+        }
+    }
+
+    if (TryControlWindowResourcePrep(botAI, target, window))
+        return true;
+
+    if (window.controlState == PvpControlState::DamageBreakable &&
+        (window.usage == PvpCcUsage::SetupThenBreak || window.usage == PvpCcUsage::Reposition))
+    {
+        if (!positioningComplete)
+            return false;
+        if (now - state.controlWindowStartedAtMs < 250)
+            return true;
+        if (!state.controlWindowReadyToBreak)
+            DebugPvpTactical(botAI, "control-window-release", target);
+        state.controlWindowReadyToBreak = true;
+    }
+    return false;
 }
 
