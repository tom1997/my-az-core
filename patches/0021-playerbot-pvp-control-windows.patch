+void ResetDuelControlWindow(PvpTacticalState& state)
+{
+    state.controlWindowTargetGuid.Clear();
+    state.controlWindowStartedAtMs = 0;
+    state.controlWindowSpellId = 0;
+    state.controlWindowLastRemainingMs = 0;
+    state.controlWindowReadyToBreak = false;
