+PvpCcUsage ClassifyPvpCcUsage(uint8 playerClass, PvpArchetype archetype, PvpControlState controlState,
+                              uint64 mechanicMask, bool duel, uint32 remainingMs)
+{
+    if (controlState == PvpControlState::None)
+        return PvpCcUsage::None;
+    if (controlState == PvpControlState::DamageSafe)
+        return PvpCcUsage::BreakForKill;
+    if (controlState == PvpControlState::DamageImmune)
+        return PvpCcUsage::Reposition;
+
+    // Until ArenaTeamPlan supplies an explicit reservation, non-duel
+    // breakable control is protected. A solo bot must not guess that a
+    // teammate's off-target CC was meant to be broken.
+    if (!duel)
+        return PvpCcUsage::Preserve;
+
+    switch (playerClass)
+    {
+        case CLASS_WARLOCK:
+        case CLASS_PALADIN:
+            return PvpCcUsage::SetupThenBreak;
+        case CLASS_PRIEST:
+            return archetype == PvpArchetype::DisciplinePriest ? PvpCcUsage::Reposition :
+                                                                 PvpCcUsage::SetupThenBreak;
+        case CLASS_MAGE:
+        case CLASS_SHAMAN:
+        case CLASS_DRUID:
+            return PvpCcUsage::Preserve;
+        case CLASS_HUNTER:
+            return mechanicMask & ((1ULL << MECHANIC_FREEZE) | (1ULL << MECHANIC_SLEEP)) ?
+                PvpCcUsage::Preserve : PvpCcUsage::SetupThenBreak;
+        case CLASS_ROGUE:
+            if ((mechanicMask & (1ULL << MECHANIC_SAPPED)) || remainingMs > 6000)
+                return PvpCcUsage::Reset;
+            return PvpCcUsage::SetupThenBreak;
+        default:
+            return PvpCcUsage::Preserve;
+    }
+}
+
+uint32 EstimatePvpControlWindowRemainingMs(PvpControlState controlState, uint32 remainingMs,
+                                           bool hasPeriodicDamage)
+{
+    if (controlState == PvpControlState::DamageBreakable && hasPeriodicDamage)
+        return std::min<uint32>(remainingMs, 1200);
+    return remainingMs;
+}
+
+PvpControlWindow GetPvpControlWindow(PlayerbotAI* botAI, Unit* target, PvpArchetype archetype)
+{
+    PvpControlWindow result;
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot || !target)
+        return result;
+
+    result.targetGuid = target->GetGUID();
+    result.controlState = GetPvpControlState(target);
+    if (result.controlState == PvpControlState::None)
+        return result;
+
+    for (auto const& applied : target->GetAppliedAuras())
+    {
+        Aura* aura = applied.second ? applied.second->GetBase() : nullptr;
+        SpellInfo const* info = aura ? aura->GetSpellInfo() : nullptr;
+        if (!info || info->IsPositive() || aura->GetDuration() <= 0)
+            continue;
+
+        if (IsPeriodicPvpDamageAura(info))
+            result.hasPeriodicDamage = true;
+
+        uint64 const mechanicMask = info->GetAllEffectsMechanicMask();
+        PvpControlState const auraControl = ClassifyPvpControlMetadata(
+            mechanicMask, info->AuraInterruptFlags, false);
+        if (auraControl != result.controlState)
+            continue;
+
+        result.mechanicMask |= mechanicMask;
+        uint32 const duration = uint32(aura->GetDuration());
+        if (duration > result.remainingMs)
+        {
+            result.remainingMs = duration;
+            result.controlSpellId = info->Id;
+        }
+    }
+
+    result.active = result.remainingMs > 0;
+    result.expectedRemainingMs = EstimatePvpControlWindowRemainingMs(
+        result.controlState, result.remainingMs, result.hasPeriodicDamage);
+    bool const duel = bot->duel && bot->duel->Opponent == target && bot->duel->State == DUEL_STATE_IN_PROGRESS;
+    result.usage = ClassifyPvpCcUsage(bot->getClass(), archetype, result.controlState,
+                                      result.mechanicMask, duel, result.remainingMs);
+    return result;
+}
