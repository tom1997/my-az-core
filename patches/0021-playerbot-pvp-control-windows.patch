+bool ShouldStartPvpControlWindowDamage(PvpControlState control, PvpCcUsage usage, bool duelPrimaryTarget,
+                                       bool setupComplete, bool hardCast, bool channeled, bool areaDamage,
+                                       uint32 expectedRemainingMs, uint32 expectedImpactMs)
+{
+    if (!duelPrimaryTarget || (control != PvpControlState::DamageBreakable &&
+                               control != PvpControlState::DamageImmune) ||
+        !hardCast || channeled || areaDamage || !expectedRemainingMs)
+        return false;
+
+    // Fear, short disorients and similar setup controls may be deliberately
+    // broken by a hard cast after the bot has created distance and exhausted
+    // useful recovery. Damage-immune control can only be timed for expiry.
+    if (control == PvpControlState::DamageBreakable && setupComplete &&
+        (usage == PvpCcUsage::SetupThenBreak || usage == PvpCcUsage::Reposition))
+        return true;
+
+    // Preserve/Reset windows still permit a real precast, but expected damage
+    // must arrive after the control expires with enough margin to absorb
+    // decision-tick and projectile timing jitter.
+    constexpr uint32 PRECAST_SAFETY_MS = 100;
+    return expectedImpactMs >= expectedRemainingMs + PRECAST_SAFETY_MS;
+}
+
+bool CanPrecastPvpControlWindow(PlayerbotAI* botAI, Unit* target, SpellInfo const* spellInfo)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot || !target || !spellInfo || !IsPvpDamageSpell(spellInfo) ||
+        !bot->duel || bot->duel->Opponent != target || bot->duel->State != DUEL_STATE_IN_PROGRESS)
+        return false;
+
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    PvpControlWindow const& window = snapshot.controlWindow;
+    if (!window.active || window.targetGuid != target->GetGUID())
+        return false;
+
+    uint32 const castMs = spellInfo->IsChanneled() ? 0 :
+        uint32(std::max<int32>(0, spellInfo->CalcCastTime(bot)));
+    uint32 travelMs = 0;
+    if (spellInfo->Speed > 0.0f)
+        travelMs = uint32(std::max(0.0f, bot->GetDistance(target) / spellInfo->Speed * 1000.0f));
+    bool const setupComplete = GetPvpTacticalState(botAI).controlWindowReadyToBreak &&
+                               GetPvpTacticalState(botAI).controlWindowTargetGuid == target->GetGUID();
+    return ShouldStartPvpControlWindowDamage(
+        window.controlState, window.usage, true, setupComplete, castMs >= 750,
+        spellInfo->IsChanneled(), IsPvpAreaOrChainSpell(spellInfo),
+        window.expectedRemainingMs, castMs + travelMs);
+}
