+bool PvpTacticalTargetTooFarTrigger::IsActive()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsPlayer() || !IsPvpTacticalContextEnabled(bot))
+        return false;
+
+    // A duel already has its own boundary and must not lose its opponent.
+    if (bot->duel && bot->duel->Opponent == target)
+        return false;
+
+    return bot->GetDistance2d(target) > sPlayerbotAIConfig.pvpTacticalTargetLeashDistance;
+}
