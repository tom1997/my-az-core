+        return sPlayerbotAIConfig.pvpTacticalHunterMinDistance;
+
+    if (botAI->IsHeal(bot))
+        return sPlayerbotAIConfig.pvpTacticalHealerMinDistance;
+
+    return sPlayerbotAIConfig.pvpTacticalCasterMinDistance;
+}
