+bool PvpTacticalRetreatAction::TryClassPeel(Unit* target, float distance)
+{
+    auto tryCast = [this](char const* spell, Unit* spellTarget)
+    {
+        return botAI->HasSpell(spell) && !botAI->HasAura(spell, spellTarget) &&
+               botAI->CanCastSpell(spell, spellTarget) &&
+               botAI->CastSpell(spell, spellTarget);
+    };
+
+    // Each branch is naturally level-aware: an option is considered only after
+    // the character has actually learned that spell.
+    switch (bot->getClass())
+    {
+        case CLASS_HUNTER:
+            if (distance < 9.0f && tryCast("freezing trap", bot))
+                return true;
+            if (distance < 6.0f && tryCast("wing clip", target))
+                return true;
+            if (distance < 7.0f && botAI->HasSpell("disengage") && botAI->CanCastSpell("disengage", bot))
+            {
+                bot->SetOrientation(bot->GetAngle(target));
+                return botAI->CastSpell("disengage", bot);
+            }
+            return tryCast("concussive shot", target);
+        case CLASS_MAGE:
+            if (distance < 10.0f && tryCast("frost nova", bot))
+                return true;
+            if (distance < 7.0f && botAI->HasSpell("blink") && botAI->CanCastSpell("blink", bot))
+            {
+                bot->SetOrientation(bot->GetAngle(target) + M_PI);
+                return botAI->CastSpell("blink", bot);
+            }
+            return tryCast("cone of cold", target);
+        case CLASS_WARLOCK:
+            if (distance < 12.0f && tryCast("death coil", target))
+                return true;
+            if (tryCast("curse of exhaustion", target))
+                return true;
+            return distance < 10.0f && tryCast("fear", target);
+        case CLASS_PRIEST:
+            return distance < 8.0f && tryCast("psychic scream", bot);
+        case CLASS_SHAMAN:
+            if (distance < 10.0f && tryCast("thunderstorm", bot))
+                return true;
+            if (tryCast("frost shock", target))
+                return true;
+            return distance < 9.0f && tryCast("earthbind totem", bot);
+        case CLASS_DRUID:
+            if (tryCast("entangling roots", target))
+                return true;
+            return distance < 10.0f && tryCast("cyclone", target);
+        case CLASS_PALADIN:
+            if ((bot->HasRootAura() || bot->HasAuraType(SPELL_AURA_MOD_DECREASE_SPEED)) &&
+                tryCast("hand of freedom", bot))
+                return true;
+            return distance < 10.0f && tryCast("hammer of justice", target);
+        default:
+            return false;
+    }
+}
+
+bool PvpTacticalRetreatAction::Execute(Event /*event*/)
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsPlayer() || !botAI->IsRanged(bot, true))
+        return false;
+
+    float const distance = bot->GetDistance2d(target);
+    if (TryClassPeel(target, distance))
+        return true;
+
+    // Finish safe casts when possible, but do not stand still once the enemy has
+    // reached the normal melee danger zone.
+    if (bot->IsNonMeleeSpellCast(false))
+    {
+        if (distance > sPlayerbotAIConfig.tooCloseDistance)
+            return false;
+        bot->InterruptNonMeleeSpells(true);
+    }
+
+    float minimumDistance = sPlayerbotAIConfig.pvpTacticalCasterMinDistance;
+    if (bot->getClass() == CLASS_HUNTER)
+        minimumDistance = sPlayerbotAIConfig.pvpTacticalHunterMinDistance;
+    else if (botAI->IsHeal(bot))
+        minimumDistance = sPlayerbotAIConfig.pvpTacticalHealerMinDistance;
+
+    float const missingDistance = std::max(2.0f, minimumDistance - distance + 1.0f);
+    float const step = std::min(sPlayerbotAIConfig.pvpTacticalRetreatStep, missingDistance);
+    return MoveAway(target, step, false);
+}
+
+bool PvpTacticalRetreatAction::isUseful()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    return sPlayerbotAIConfig.pvpTacticalEnabled && target && target->IsPlayer() && botAI->IsRanged(bot, true);
+}
