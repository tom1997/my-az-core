+
+bool PvpTacticalRangedTooCloseTrigger::IsActive()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsPlayer() || !IsPvpTacticalContextEnabled(bot) || !botAI->IsRanged(bot, true))
+        return false;
+
+    // Do not kite a player who is currently pressuring somebody else. This keeps
+    // ranged bots from needlessly cancelling casts in group PvP.
+    if (target->GetVictim() != bot && !(bot->duel && bot->duel->Opponent == target))
+        return false;
+
+    float const minimumDistance = GetPvpTacticalMinimumDistance(botAI, bot);
+    return bot->GetDistance2d(target) < minimumDistance;
+}
+
+PvpTacticalTargetTooFarTrigger::PvpTacticalTargetTooFarTrigger(PlayerbotAI* botAI)
+    : Trigger(botAI, "pvp tactical target too far", sPlayerbotAIConfig.pvpTacticalDecisionInterval)
