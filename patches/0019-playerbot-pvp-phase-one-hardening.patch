+bool EnforcePvpDamageGuard(PlayerbotAI* botAI, Unit* primaryTarget)
+{
+    Player* bot = botAI->GetBot();
+    bool changed = false;
+    if (Unit* victim = bot->GetVictim(); victim && !CanDamagePvpTarget(botAI, victim))
+    {
+        bot->AttackStop();
+        changed = true;
+    }
+    if (Spell* autoRepeat = bot->GetCurrentSpell(CURRENT_AUTOREPEAT_SPELL))
+    {
+        Unit* autoTarget = botAI->GetUnit(autoRepeat->m_targets.GetUnitTargetGUID());
+        if (autoTarget && !CanDamagePvpTarget(botAI, autoTarget))
+        {
+            bot->InterruptSpell(CURRENT_AUTOREPEAT_SPELL);
+            changed = true;
+        }
+    }
+    for (CurrentSpellTypes slot : { CURRENT_GENERIC_SPELL, CURRENT_CHANNELED_SPELL })
+    {
+        Spell* spell = bot->GetCurrentSpell(slot);
+        Unit* spellTarget = spell ? botAI->GetUnit(spell->m_targets.GetUnitTargetGUID()) : nullptr;
+        if (!spellTarget)
+            spellTarget = primaryTarget;
+        if (spell && spell->m_spellInfo && IsPvpDamageSpell(spell->m_spellInfo) &&
+            !CanDamagePvpTarget(botAI, spellTarget, spell->m_spellInfo))
+        {
+            bot->InterruptNonMeleeSpells(false);
+            changed = true;
+            break;
+        }
+    }
+    if (botAI->HasAura("blade flurry", bot) && HasBreakablePvpControlNearby(botAI, bot, 12.0f))
+    {
+        botAI->RemoveAura("blade flurry");
+        changed = true;
+    }
+    if (Pet* pet = bot->GetPet())
+        if (Unit* victim = pet->GetVictim(); victim && !CanDamagePvpTarget(botAI, victim))
+        {
+            botAI->PetFollow();
+            changed = true;
+        }
+    if (changed)
+        DebugPvpTactical(botAI, "damage-guard", primaryTarget);
+    return changed;
+}
+
+bool TryPvpPetMicro(PlayerbotAI* botAI, Unit* target, PvpSnapshot const& snapshot)
+{
+    Player* bot = botAI->GetBot();
+    Pet* pet = bot->GetPet();
+    if (!pet || !pet->IsAlive() || pet->IsNonMeleeSpellCast(false))
+        return false;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (now - state.lastPetControlAtMs < 500)
+        return false;
+
+    if (snapshot.pet.defensiveReady &&
+        (snapshot.pet.healthPct <= 35.0f || snapshot.defensiveNeedScore >= 0.72f))
+    {
+        uint32 const spellId = snapshot.pet.defensiveSpellId;
+        SpellInfo const* info = spellId ? sSpellMgr->GetSpellInfo(spellId) : nullptr;
+        Unit* defensiveTarget = info && info->GetMaxRange(true) > 0.0f ? static_cast<Unit*>(bot) :
+                                                                           static_cast<Unit*>(pet);
+        if (info && !pet->HasSpellCooldown(spellId) &&
+            pet->CastSpell(defensiveTarget, spellId, false) == SPELL_CAST_OK)
+        {
+            state.lastPetControlAtMs = now;
+            DebugPvpTactical(botAI, "pet-defensive", defensiveTarget);
+            return true;
+        }
+    }
+
+    if (!target || !snapshot.pet.controlReady)
+        return false;
+    uint32 const spellId = snapshot.pet.controlSpellId;
+    SpellInfo const* info = spellId ? sSpellMgr->GetSpellInfo(spellId) : nullptr;
+    if (!info || pet->HasSpellCooldown(spellId))
+        return false;
+
+    bool interrupt = false;
+    for (SpellEffectInfo const& effect : info->Effects)
+        interrupt = interrupt || effect.Effect == SPELL_EFFECT_INTERRUPT_CAST;
+    Unit* controlTarget = target;
+    bool const breakableControl =
+        info->AuraInterruptFlags & (AURA_INTERRUPT_FLAG_TAKE_DAMAGE | AURA_INTERRUPT_FLAG_DIRECT_DAMAGE);
+    if (!interrupt && breakableControl)
+    {
+        controlTarget = botAI->GetUnit(snapshot.ccTarget);
+        if (!controlTarget || controlTarget == target)
+            return false;
+    }
+    if (!pet->IsWithinLOSInMap(controlTarget))
+        return false;
+    if (interrupt)
+    {
+        if (!controlTarget->IsNonMeleeSpellCast(false) || !ShouldCommitPvpInterrupt(botAI, controlTarget))
+            return false;
+    }
+    else
+    {
+        if (GetPvpControlState(controlTarget) != PvpControlState::None ||
+            (snapshot.intent != PvpIntent::Control && snapshot.intent != PvpIntent::Peel &&
+             snapshot.intent != PvpIntent::Finish && snapshot.intent != PvpIntent::Survive))
+            return false;
+        if (GetPvpDrWeight(controlTarget, spellId) <= 0.25f)
+            return false;
+    }
+
+    float const maxRange = std::max(1.0f, info->GetMaxRange(false, pet));
+    if (pet->GetDistance2d(controlTarget) > maxRange)
+    {
+        pet->GetMotionMaster()->MoveChase(controlTarget, std::max(1.0f, maxRange * 0.75f));
+        return true;
+    }
+    pet->SetFacingToObject(controlTarget);
+    if (pet->CastSpell(controlTarget, spellId, false) != SPELL_CAST_OK)
+        return false;
+    state.lastPetControlAtMs = now;
+    if (interrupt)
+        MarkPvpInterruptCommitted(botAI);
+    DebugPvpTactical(botAI, interrupt ? "pet-interrupt" : "pet-control", controlTarget);
+    return true;
+}
+
+void ResetHunterCcPlan(PlayerbotAI* botAI)
+{
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    state.hunterCcStage = PvpHunterCcStage::None;
+    state.hunterCcStartedAtMs = 0;
+    state.hunterCcTargetGuid.Clear();
+    ClearPvpMovement(botAI, PvpMovementOwner::HunterTrap);
+}
+
+bool TryHunterScatterTrapPlan(PlayerbotAI* botAI, Unit* primaryTarget, PvpSnapshot const& snapshot)
+{
+    if (snapshot.archetype != PvpArchetype::MarksmanshipHunter)
+        return false;
+    Player* bot = botAI->GetBot();
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (state.hunterCcStage != PvpHunterCcStage::None && now - state.hunterCcStartedAtMs > 6500)
+    {
+        ResetHunterCcPlan(botAI);
+        return false;
+    }
+    if (state.hunterCcStage == PvpHunterCcStage::Complete)
+    {
+        ResetHunterCcPlan(botAI);
+        return false;
+    }
+
+    Unit* ccTarget = state.hunterCcTargetGuid.IsEmpty() ? ResolvePvpControlTarget(botAI, primaryTarget) :
+                                                          botAI->GetUnit(state.hunterCcTargetGuid);
+    if (!ccTarget || !ccTarget->IsPlayer() || !ccTarget->IsAlive() || ccTarget == primaryTarget)
+    {
+        if (state.hunterCcStage != PvpHunterCcStage::None)
+            ResetHunterCcPlan(botAI);
+        return false;
+    }
+
+    if (state.hunterCcStage == PvpHunterCcStage::None)
+    {
+        uint32 const trapId = botAI->GetAiObjectContext()->GetValue<uint32>("spell id", "freezing trap")->Get();
+        if (!trapId || bot->HasSpellCooldown(trapId) || GetPvpControlState(ccTarget) != PvpControlState::None)
+            return false;
+        state.hunterCcStage = PvpHunterCcStage::Scatter;
+        state.hunterCcStartedAtMs = now;
+        state.hunterCcTargetGuid = ccTarget->GetGUID();
+    }
+
+    if (state.hunterCcStage == PvpHunterCcStage::Scatter)
+    {
+        if (!TrySpell(botAI, "scatter shot", ccTarget))
+        {
+            ResetHunterCcPlan(botAI);
+            return false;
+        }
+        botAI->PetFollow();
+        state.hunterCcStage = PvpHunterCcStage::MoveForTrap;
+        DebugPvpTactical(botAI, "scatter-trap-scatter", ccTarget);
+        return true;
+    }
+
+    if (bot->GetDistance2d(ccTarget) > 4.0f)
+    {
+        if (IsPvpMovementActive(botAI, bot, PvpMovementOwner::HunterTrap))
+            return true;
+        float const angle = ccTarget->GetAngle(bot);
+        float x = ccTarget->GetPositionX() + std::cos(angle) * 2.0f;
+        float y = ccTarget->GetPositionY() + std::sin(angle) * 2.0f;
+        float z = ccTarget->GetPositionZ();
+        if (!bot->GetMap()->CheckCollisionAndGetValidCoords(bot, bot->GetPositionX(), bot->GetPositionY(),
+                                                             bot->GetPositionZ(), x, y, z))
+        {
+            ResetHunterCcPlan(botAI);
+            return false;
+        }
+        ClaimPvpMovement(botAI, PvpMovementOwner::HunterTrap, ccTarget);
+        SetPvpMovementDestination(botAI, x, y);
+        bot->GetMotionMaster()->Clear(false);
+        bot->GetMotionMaster()->MovePoint(0, x, y, z, FORCED_MOVEMENT_NONE, 0.0f, 0.0f, true, false);
+        DebugPvpTactical(botAI, "scatter-trap-move", ccTarget);
+        return true;
+    }
+
+    ClearPvpMovement(botAI, PvpMovementOwner::HunterTrap);
+    bot->GetMotionMaster()->Clear(false);
+    bot->StopMoving();
+    if (!TrySpell(botAI, "freezing trap", bot, false))
+        return false;
+    state.hunterCcStage = PvpHunterCcStage::Complete;
+    DebugPvpTactical(botAI, "scatter-trap-complete", ccTarget);
+    return true;
+}
 }
 
