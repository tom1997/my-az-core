+PvpControlState GetPvpControlState(Unit* target)
+{
+    if (!target)
+        return PvpControlState::None;
+
+    if ((target->IsImmunedToDamage(SPELL_SCHOOL_MASK_NORMAL) &&
+         target->IsImmunedToDamage(SPELL_SCHOOL_MASK_MAGIC)) ||
+        target->HasAuraWithMechanic(1ULL << MECHANIC_BANISH))
+        return PvpControlState::DamageImmune;
+
+    uint64 const controlMask = (1ULL << MECHANIC_CHARM) | (1ULL << MECHANIC_DISORIENTED) |
+                               (1ULL << MECHANIC_FEAR) | (1ULL << MECHANIC_ROOT) |
+                               (1ULL << MECHANIC_SLEEP) | (1ULL << MECHANIC_STUN) |
+                               (1ULL << MECHANIC_FREEZE) | (1ULL << MECHANIC_KNOCKOUT) |
+                               (1ULL << MECHANIC_POLYMORPH) | (1ULL << MECHANIC_SHACKLE) |
+                               (1ULL << MECHANIC_TURN) | (1ULL << MECHANIC_HORROR) |
+                               (1ULL << MECHANIC_SAPPED) | (1ULL << MECHANIC_SILENCE);
+    uint64 const breakableMask = controlMask & ~((1ULL << MECHANIC_ROOT) |
+                                                 (1ULL << MECHANIC_STUN) |
+                                                 (1ULL << MECHANIC_SILENCE));
+    for (auto const& applied : target->GetAppliedAuras())
+    {
+        Aura* aura = applied.second ? applied.second->GetBase() : nullptr;
+        SpellInfo const* info = aura ? aura->GetSpellInfo() : nullptr;
+        if (!info || info->IsPositive() || aura->GetDuration() <= 0 ||
+            !(info->GetAllEffectsMechanicMask() & breakableMask))
+            continue;
+        if (info->AuraInterruptFlags & (AURA_INTERRUPT_FLAG_TAKE_DAMAGE | AURA_INTERRUPT_FLAG_DIRECT_DAMAGE))
+            return PvpControlState::DamageBreakable;
+    }
+
+    bool const damageSafe = target->HasAuraType(SPELL_AURA_MOD_STUN) ||
+                            target->HasAuraType(SPELL_AURA_MOD_ROOT) ||
+                            target->HasAuraType(SPELL_AURA_MOD_SILENCE) ||
+                            target->HasAuraType(SPELL_AURA_MOD_FEAR) ||
+                            target->HasAuraType(SPELL_AURA_MOD_CONFUSE) ||
+                            target->HasAuraType(SPELL_AURA_MOD_CHARM) ||
+                            target->HasAuraType(SPELL_AURA_AOE_CHARM) ||
+                            target->HasAuraWithMechanic(controlMask);
+    return damageSafe ? PvpControlState::DamageSafe : PvpControlState::None;
+}
+
+bool IsPvpDamageSpell(SpellInfo const* spellInfo)
+{
+    if (!spellInfo)
+        return false;
+    for (SpellEffectInfo const& effect : spellInfo->Effects)
+    {
+        switch (effect.Effect)
+        {
+            case SPELL_EFFECT_INSTAKILL:
+            case SPELL_EFFECT_SCHOOL_DAMAGE:
+            case SPELL_EFFECT_ENVIRONMENTAL_DAMAGE:
+            case SPELL_EFFECT_HEALTH_LEECH:
+            case SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL:
+            case SPELL_EFFECT_WEAPON_PERCENT_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE:
+            case SPELL_EFFECT_NORMALIZED_WEAPON_DMG:
+                return true;
+            default:
+                break;
+        }
+        if (effect.ApplyAuraName == SPELL_AURA_PERIODIC_DAMAGE ||
+            effect.ApplyAuraName == SPELL_AURA_PERIODIC_DAMAGE_PERCENT ||
+            effect.ApplyAuraName == SPELL_AURA_PERIODIC_LEECH)
+            return true;
+    }
+    return false;
+}
+
+PvpCastPurpose GetPvpCastPurpose(SpellInfo const* spellInfo)
+{
+    if (IsHighValueHeal(spellInfo))
+        return PvpCastPurpose::Heal;
+    if (IsHardCcCast(spellInfo))
+        return PvpCastPurpose::Control;
+    if (IsPvpDamageSpell(spellInfo))
+        return PvpCastPurpose::Damage;
+    return IsSoftControlCast(spellInfo) ? PvpCastPurpose::Control : PvpCastPurpose::Utility;
+}
+
+bool HasBreakablePvpControlNearby(PlayerbotAI* botAI, Unit* center, float radius)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot || !center || !IsPvpTacticalContextEnabled(bot))
+        return false;
+
+    std::set<ObjectGuid> seen;
+    auto isNearbyBreakable = [&](Unit* candidate)
+    {
+        return candidate && candidate->IsPlayer() && candidate->IsAlive() && bot->IsHostileTo(candidate) &&
+               seen.insert(candidate->GetGUID()).second && center->GetDistance2d(candidate) <= radius &&
+               GetPvpControlState(candidate) == PvpControlState::DamageBreakable;
+    };
+    for (Unit* attacker : bot->getAttackers())
+        if (isNearbyBreakable(attacker))
+            return true;
+    for (ObjectGuid const& guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest enemy players")->Get())
+        if (isNearbyBreakable(botAI->GetUnit(guid)))
+            return true;
+    return false;
+}
+
+bool CanDamagePvpTarget(PlayerbotAI* botAI, Unit* target, SpellInfo const* spellInfo)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot || !target || !IsPvpTacticalContextEnabled(bot))
+        return true;
+    if (target->IsPlayer() && bot->IsHostileTo(target))
+    {
+        PvpControlState const control = GetPvpControlState(target);
+        if (control == PvpControlState::DamageBreakable || control == PvpControlState::DamageImmune)
+            return false;
+    }
+    if (!spellInfo || !IsPvpDamageSpell(spellInfo))
+        return true;
+
+    bool areaDamage = false;
+    float radius = 0.0f;
+    for (SpellEffectInfo const& effect : spellInfo->Effects)
+    {
+        bool damagingEffect = effect.ApplyAuraName == SPELL_AURA_PERIODIC_DAMAGE ||
+                               effect.ApplyAuraName == SPELL_AURA_PERIODIC_DAMAGE_PERCENT ||
+                               effect.ApplyAuraName == SPELL_AURA_PERIODIC_LEECH;
+        switch (effect.Effect)
+        {
+            case SPELL_EFFECT_INSTAKILL:
+            case SPELL_EFFECT_SCHOOL_DAMAGE:
+            case SPELL_EFFECT_ENVIRONMENTAL_DAMAGE:
+            case SPELL_EFFECT_HEALTH_LEECH:
+            case SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL:
+            case SPELL_EFFECT_WEAPON_PERCENT_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE:
+            case SPELL_EFFECT_NORMALIZED_WEAPON_DMG:
+                damagingEffect = true;
+                break;
+            default:
+                break;
+        }
+        if (!damagingEffect)
+            continue;
+        if (!effect.IsTargetingArea() && effect.ChainTarget <= 1)
+            continue;
+        areaDamage = true;
+        if (effect.HasRadius())
+            radius = std::max(radius, effect.CalcRadius(bot));
+        if (effect.ChainTarget > 1)
+            radius = std::max(radius, 12.0f);
+    }
+    if (!areaDamage)
+        return true;
+    radius = std::max(radius, 8.0f);
+    Unit* center = target == bot ? static_cast<Unit*>(bot) : target;
+    return !HasBreakablePvpControlNearby(botAI, center, radius) &&
+           (center == bot || !HasBreakablePvpControlNearby(botAI, bot, radius));
+}
