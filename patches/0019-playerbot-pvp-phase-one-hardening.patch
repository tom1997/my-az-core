+void CalculatePressureMix(Player* player, float& magicPressure, float& physicalPressure)
+{
+    magicPressure = 0.0f;
+    physicalPressure = 0.0f;
+    if (!player)
+        return;
+
+    for (Unit* attacker : player->getAttackers())
+    {
+        Player* enemy = attacker ? attacker->ToPlayer() : nullptr;
+        if (!enemy)
+            continue;
+        float const weight = HasMajorOffensive(enemy) ? 0.42f : 0.24f;
+        switch (enemy->getClass())
+        {
+            case CLASS_WARRIOR:
+            case CLASS_ROGUE:
+            case CLASS_HUNTER:
+                physicalPressure += weight;
+                break;
+            case CLASS_MAGE:
+            case CLASS_PRIEST:
+            case CLASS_WARLOCK:
+                magicPressure += weight;
+                break;
+            case CLASS_PALADIN:
+            case CLASS_SHAMAN:
+            case CLASS_DRUID:
+            case CLASS_DEATH_KNIGHT:
+                magicPressure += weight * 0.55f;
+                physicalPressure += weight * 0.45f;
+                break;
+            default:
+                physicalPressure += weight * 0.50f;
+                magicPressure += weight * 0.50f;
+                break;
+        }
+    }
+    magicPressure = std::clamp(magicPressure, 0.0f, 1.0f);
+    physicalPressure = std::clamp(physicalPressure, 0.0f, 1.0f);
+}
