+
+ObservedPvpCooldownState ClassifyObservedPvpCooldown(uint32 now, uint32 observedAtMs,
+                                                     uint32 recentMs, uint32 unavailableMs)
+{
+    if (!observedAtMs)
+        return ObservedPvpCooldownState::Unknown;
+    uint32 const elapsed = now - observedAtMs;
+    if (elapsed <= recentMs)
+        return ObservedPvpCooldownState::RecentlyUsed;
+    if (elapsed <= unavailableMs)
+        return ObservedPvpCooldownState::LikelyUnavailable;
+    return ObservedPvpCooldownState::LikelyAvailable;
+}
+
+PvpSpecPhase SelectPvpSpecPhase(bool allyCritical, bool selfCritical, bool targetFinish,
+                                bool targetProtected, bool safeRecovery, bool resetRequested,
+                                float incomingBurstScore, float killWindowScore)
+{
+    // A nearly secured kill may be worth finishing through moderate pressure,
+    // but never through a true lethal enemy go. This is the shared answer to
+    // "Finish or Reset?" used by every specialization policy.
+    if (targetFinish && killWindowScore >= 0.82f && incomingBurstScore < 0.85f && !targetProtected)
+        return PvpSpecPhase::Finish;
+    if (selfCritical || incomingBurstScore >= 0.78f)
+        return PvpSpecPhase::Survive;
+    if (allyCritical)
+        return PvpSpecPhase::Peel;
+    if (targetProtected)
+        return safeRecovery ? PvpSpecPhase::Recover : PvpSpecPhase::Setup;
+    if (resetRequested)
+        return PvpSpecPhase::Reset;
+    if (safeRecovery)
+        return PvpSpecPhase::Recover;
+    if (targetFinish)
+        return PvpSpecPhase::Finish;
+    if (killWindowScore >= 0.62f)
+        return PvpSpecPhase::Commit;
+    if (killWindowScore >= 0.35f)
+        return PvpSpecPhase::Setup;
+    return PvpSpecPhase::Pressure;
+}
+
+bool ShouldCommitPvpPrimaryBurst(PvpSpecPhase phase, float commitScore,
+                                 bool targetProtected, bool targetConnected)
+{
+    return !targetProtected && targetConnected && commitScore >= 0.62f &&
+           (phase == PvpSpecPhase::Commit || phase == PvpSpecPhase::Finish);
+}
+
+bool ShouldSpendPvpMobility(ObservedPvpCooldownState observedEnemyMobility,
+                            float targetDistance, bool movementImpaired, bool emergency)
+{
+    if (emergency && movementImpaired)
+        return true;
+    bool const enemyMobilitySpent = observedEnemyMobility == ObservedPvpCooldownState::RecentlyUsed ||
+                                    observedEnemyMobility == ObservedPvpCooldownState::LikelyUnavailable;
+    return enemyMobilitySpent && targetDistance >= 8.0f;
+}
+
+bool ShouldReserveSurvivalTrap(bool controlCandidate, bool controlAlreadyActive,
+                               PvpSpecPhase phase)
+{
+    return controlCandidate && !controlAlreadyActive && phase != PvpSpecPhase::Finish;
+}
+
+PvpProcUse SelectPvpProcUse(uint8 stacks, uint8 requiredStacks, bool criticalHeal,
+                            bool controlSetup, bool damageWindow)
+{
+    if (stacks < requiredStacks)
+        return PvpProcUse::Hold;
+    if (criticalHeal)
+        return PvpProcUse::Heal;
+    if (controlSetup)
+        return PvpProcUse::Control;
+    return damageWindow ? PvpProcUse::Damage : PvpProcUse::Hold;
+}
+
+PvpSpecPlan BuildPvpSpecPlan(PlayerbotAI* botAI, PvpSnapshot const& snapshot)
+{
+    PvpSpecPlan plan;
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    Unit* target = botAI ? botAI->GetUnit(snapshot.primaryTarget) : nullptr;
+    if (!bot || !target)
+        return plan;
+
+    plan.killTarget = snapshot.primaryTarget;
+    plan.controlTarget = snapshot.ccTarget;
+    bool const targetProtected = snapshot.targetMajorDefensive ||
+        snapshot.targetControlState == PvpControlState::DamageImmune ||
+        snapshot.targetControlState == PvpControlState::DamageBreakable;
+    bool const safeRecovery = bot->GetHealthPct() < 55.0f &&
+        (snapshot.controlWindow.active || targetProtected || snapshot.incomingBurstScore < 0.30f);
+    bool const resetRequested = snapshot.intent == PvpIntent::Reset ||
+        (bot->GetHealthPct() < 40.0f && target->GetHealthPct() > 55.0f &&
+         snapshot.killWindowScore < 0.45f);
+    bool const allyCritical = snapshot.triage.targetGuid != bot->GetGUID() &&
+        snapshot.triage.dangerScore >= 0.72f;
+    bool const selfCritical = bot->GetHealthPct() <= 25.0f;
+    bool const targetFinish = target->GetHealthPct() <= 30.0f || snapshot.killWindowScore >= 0.72f;
+
+    float observedOpportunity = 0.0f;
+    if (snapshot.observedCooldowns.mobility == ObservedPvpCooldownState::RecentlyUsed ||
+        snapshot.observedCooldowns.mobility == ObservedPvpCooldownState::LikelyUnavailable)
+        observedOpportunity += 0.30f;
+    if (snapshot.observedCooldowns.majorDefensive == ObservedPvpCooldownState::LikelyUnavailable ||
+        snapshot.observedCooldowns.immunity == ObservedPvpCooldownState::LikelyUnavailable)
+        observedOpportunity += 0.12f;
+    if (snapshot.targetControlState == PvpControlState::DamageSafe)
+        observedOpportunity += 0.12f;
+    if (bot->GetDistance2d(target) <= 12.0f)
+        observedOpportunity += 0.12f;
+    plan.commitScore = std::clamp(snapshot.killWindowScore + observedOpportunity -
+                                      (targetProtected ? 0.65f : 0.0f),
+                                  0.0f, 1.0f);
+    plan.resetScore = std::clamp((100.0f - bot->GetHealthPct()) / 100.0f * 0.65f +
+                                     snapshot.incomingBurstScore * 0.45f -
+                                     snapshot.killWindowScore * 0.50f,
+                                 0.0f, 1.0f);
+    plan.phase = SelectPvpSpecPhase(allyCritical, selfCritical, targetFinish,
+                                    targetProtected, safeRecovery, resetRequested,
+                                    snapshot.incomingBurstScore, snapshot.killWindowScore);
+    if ((plan.phase == PvpSpecPhase::Pressure || plan.phase == PvpSpecPhase::Setup) &&
+        plan.commitScore >= 0.62f && !targetProtected)
+        plan.phase = PvpSpecPhase::Commit;
+    plan.reservePrimaryBurst = targetProtected ||
+        (plan.phase != PvpSpecPhase::Commit && plan.phase != PvpSpecPhase::Finish) ||
+        plan.commitScore < 0.62f;
+    plan.reservePrimaryMobility =
+        snapshot.observedCooldowns.mobility != ObservedPvpCooldownState::RecentlyUsed &&
+        snapshot.observedCooldowns.mobility != ObservedPvpCooldownState::LikelyUnavailable &&
+        bot->GetDistance2d(target) < 12.0f;
+    plan.reservePrimaryDefensive = plan.phase != PvpSpecPhase::Survive &&
+        snapshot.defensiveNeedScore < 0.58f;
+    plan.reserveControl = snapshot.controlWindow.active ||
+        snapshot.targetControlState != PvpControlState::None || plan.phase == PvpSpecPhase::Finish;
+    plan.reserveSurvivalResource =
+        snapshot.archetype == PvpArchetype::BloodDeathKnight && bot->GetHealthPct() < 72.0f;
+    return plan;
 }
 
