+bool PvpTacticalSpecPolicyAction::isUseful()
+{
+    if (!bot->IsAlive() || bot->IsNonMeleeSpellCast(false))
+        return false;
+    switch (DetectPvpArchetype(botAI))
+    {
+        case PvpArchetype::FuryWarrior:
+        case PvpArchetype::ProtectionWarrior:
+        case PvpArchetype::HolyPaladin:
+        case PvpArchetype::ProtectionPaladin:
+        case PvpArchetype::BloodDeathKnight:
+        case PvpArchetype::FrostDeathKnight:
+        case PvpArchetype::BeastMasteryHunter:
+        case PvpArchetype::SurvivalHunter:
+        case PvpArchetype::AssassinationRogue:
+        case PvpArchetype::CombatRogue:
+        case PvpArchetype::HolyPriest:
+        case PvpArchetype::EnhancementShaman:
+        case PvpArchetype::RestorationShaman:
+        case PvpArchetype::FireMage:
+        case PvpArchetype::DemonologyWarlock:
+        case PvpArchetype::FeralDruid:
+            return ResolvePvpClassActionTarget(botAI) != nullptr;
+        default:
+            return false;
+    }
+}
+
+bool PvpTacticalSpecPolicyAction::Execute(Event /*event*/)
+{
+    Unit* target = ResolvePvpClassActionTarget(botAI);
+    if (!target || !target->IsPlayer() || !target->IsAlive())
+        return false;
+
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    PvpSpecPlan const& plan = snapshot.specPlan;
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    float const distance = bot->GetDistance2d(target);
+    bool const melee = bot->IsWithinMeleeRange(target);
+    bool const commit = plan.phase == PvpSpecPhase::Commit || plan.phase == PvpSpecPhase::Finish;
+    bool const survive = plan.phase == PvpSpecPhase::Survive;
+    bool const targetProtected = snapshot.targetMajorDefensive ||
+        snapshot.targetControlState == PvpControlState::DamageBreakable ||
+        snapshot.targetControlState == PvpControlState::DamageImmune;
+    bool const targetConnected = melee ||
+        ((botAI->IsRanged(bot, true) || botAI->IsHeal(bot)) && distance <= 35.0f) ||
+        snapshot.targetControlState == PvpControlState::DamageSafe;
+    Unit* controlTarget = plan.controlTarget.IsEmpty() ? nullptr : botAI->GetUnit(plan.controlTarget);
+    Unit* support = ResolvePvpSupportTarget(botAI, 0.20f);
+    if (!support)
+        support = bot;
+
+    if (!bot->duel && plan.phase != PvpSpecPhase::Survive &&
+        plan.phase != PvpSpecPhase::Peel && plan.phase != PvpSpecPhase::Recover &&
+        snapshot.recommendedTarget != snapshot.primaryTarget)
+        if (botAI->DoSpecificAction("pvp tactical target swap", Event(), true))
+            return true;
+
+    if ((bot->getClass() == CLASS_HUNTER || bot->getClass() == CLASS_WARLOCK) &&
+        CanDamagePvpTarget(botAI, target))
+        if (Pet* pet = bot->GetPet(); pet && pet->IsAlive() && pet->GetVictim() != target)
+            if (botAI->DoSpecificAction("pvp tactical pet attack", Event(), true))
+                return true;
+
+    auto cast = [&](std::string const& spell, Unit* unit, char const* reason,
+                    bool respectDiminishing = false)
+    {
+        if (!unit || !TrySpell(botAI, spell, unit, respectDiminishing))
+            return false;
+        DebugPvpTactical(botAI, reason, unit);
+        return true;
+    };
+    auto pressure = [&](std::string const& spell, Unit* unit, char const* reason)
+    {
+        if (!TryPvpPressureSpell(botAI, spell, unit))
+            return false;
+        DebugPvpTactical(botAI, reason, unit);
+        return true;
+    };
+    auto primaryDefensiveReady = [&](uint32 spacingMs = 3500u)
+    {
+        return !state.lastPrimaryDefensiveAtMs || now - state.lastPrimaryDefensiveAtMs >= spacingMs;
+    };
+    auto secondaryDefensiveReady = [&](uint32 spacingMs = 2500u)
+    {
+        return !state.lastSecondaryDefensiveAtMs || now - state.lastSecondaryDefensiveAtMs >= spacingMs;
+    };
+    auto markPrimaryDefensive = [&]() { state.lastPrimaryDefensiveAtMs = now; };
+    auto markSecondaryDefensive = [&]() { state.lastSecondaryDefensiveAtMs = now; };
+    auto castBurst = [&](std::string const& spell, Unit* unit, char const* reason)
+    {
+        if (plan.reservePrimaryBurst ||
+            !ShouldCommitPvpPrimaryBurst(plan.phase, plan.commitScore, targetProtected, targetConnected) ||
+            (state.lastPrimaryBurstAtMs && now - state.lastPrimaryBurstAtMs < 1500))
+            return false;
+        if (!cast(spell, unit, reason))
+            return false;
+        state.lastPrimaryBurstAtMs = now;
+        return true;
+    };
+
+    switch (snapshot.archetype)
+    {
+        case PvpArchetype::FeralDruid:
+        {
+            bool const instantNature = botAI->HasAura("predator's swiftness", bot);
+            PvpProcUse const predatoryUse = SelectPvpProcUse(
+                instantNature ? 1 : 0, 1, bot->GetHealthPct() <= 55.0f,
+                !plan.reserveControl, commit);
+            if ((botAI->IsMovementImpaired(bot) || bot->HasRootAura()) &&
+                bot->GetShapeshiftForm() != FORM_NONE)
+            {
+                botAI->RemoveShapeshift();
+                DebugPvpTactical(botAI, "feral-shift-root", target);
+                return true;
+            }
+            if (survive && primaryDefensiveReady())
+            {
+                if (cast("barkskin", bot, "feral-barkskin"))
+                {
+                    markPrimaryDefensive();
+                    return true;
+                }
+                if (bot->GetHealthPct() <= 35.0f && cast("survival instincts", bot, "feral-survival-instincts"))
+                {
+                    markPrimaryDefensive();
+                    return true;
+                }
+            }
+            if (survive && bot->GetHealthPct() <= 30.0f && !botAI->HasAura("dire bear form", bot) &&
+                cast("dire bear form", bot, "feral-survive-bear"))
+                return true;
+            if (survive && botAI->HasAura("dire bear form", bot) && secondaryDefensiveReady() &&
+                cast("frenzied regeneration", bot, "feral-frenzied-regeneration"))
+            {
+                markSecondaryDefensive();
+                return true;
+            }
+            if (predatoryUse == PvpProcUse::Heal &&
+                cast("healing touch", bot, "feral-predatory-heal"))
+                return true;
+            if (predatoryUse == PvpProcUse::Control)
+            {
+                Unit* cycloneTarget = controlTarget ? controlTarget : target;
+                if (cast("cyclone", cycloneTarget, "feral-predatory-cyclone", true))
+                    return true;
+            }
+            if (!botAI->HasAura("cat form", bot) && cast("cat form", bot, "feral-pressure-cat"))
+                return true;
+            if (commit && melee && castBurst("berserk", bot, "feral-berserk"))
+                return true;
+            if (!melee)
+                return false;
+            if (!botAI->HasAura("mangle (cat)", target) &&
+                pressure("mangle (cat)", target, "feral-mangle"))
+                return true;
+            if (!botAI->HasAura("rake", target, false, true) && pressure("rake", target, "feral-rake"))
+                return true;
+            if (bot->GetComboPoints() >= 5)
+            {
+                if (!botAI->HasAura("rip", target, false, true) && pressure("rip", target, "feral-rip"))
+                    return true;
+                if (!botAI->HasAura("savage roar", bot) && cast("savage roar", bot, "feral-savage-roar"))
+                    return true;
+                if (pressure("ferocious bite", target, "feral-bite"))
+                    return true;
+            }
+            return pressure("shred", target, "feral-shred") ||
+                   pressure("mangle (cat)", target, "feral-mangle-filler");
+        }
+        case PvpArchetype::SurvivalHunter:
+        {
+            Aura* lockAndLoad = botAI->GetAura("lock and load", bot, false, true);
+            bool const trapReserved = ShouldReserveSurvivalTrap(
+                controlTarget && controlTarget != target,
+                controlTarget && GetPvpControlState(controlTarget) != PvpControlState::None,
+                plan.phase);
+            if (lockAndLoad && (!state.lastExplosiveShotAtMs || now - state.lastExplosiveShotAtMs >= 1100) &&
+                cast("explosive shot", target, "survival-lock-and-load"))
+            {
+                state.lastExplosiveShotAtMs = now;
+                return true;
+            }
+            if (controlTarget && controlTarget != target && !plan.reserveControl &&
+                cast("wyvern sting", controlTarget, "survival-wyvern", true))
+                return true;
+            if (!trapReserved && commit && !botAI->HasAura("black arrow", target, false, true) &&
+                pressure("black arrow", target, "survival-black-arrow"))
+                return true;
+            if (!botAI->HasAura("serpent sting", target, false, true) &&
+                pressure("serpent sting", target, "survival-serpent-sting"))
+                return true;
+            if ((!state.lastExplosiveShotAtMs || now - state.lastExplosiveShotAtMs >= 1100) &&
+                cast("explosive shot", target, "survival-explosive-shot"))
+            {
+                state.lastExplosiveShotAtMs = now;
+                return true;
+            }
+            if (bot->isMoving())
+                return pressure("arcane shot", target, "survival-moving-arcane") ||
+                       pressure("aimed shot", target, "survival-moving-aimed");
+            return pressure("steady shot", target, "survival-steady-shot") ||
+                   pressure("arcane shot", target, "survival-arcane-shot");
+        }
+        case PvpArchetype::EnhancementShaman:
+        {
+            Aura* maelstrom = botAI->GetAura("maelstrom weapon", bot, false, true);
+            uint8 const stacks = maelstrom ? maelstrom->GetStackAmount() : 0;
+            PvpProcUse const maelstromUse = SelectPvpProcUse(
+                stacks, 5, survive || support->GetHealthPct() <= 55.0f,
+                !plan.reserveControl && controlTarget && controlTarget != target, true);
+            SpellInfo const* enemySpell = snapshot.enemyCastSpellId ?
+                sSpellMgr->GetSpellInfo(snapshot.enemyCastSpellId) : nullptr;
+            bool const incomingFear = enemySpell &&
+                (enemySpell->GetAllEffectsMechanicMask() & (1ULL << MECHANIC_FEAR));
+            if (incomingFear && cast("tremor totem", bot, "enhancement-tremor"))
+                return true;
+            if (maelstromUse != PvpProcUse::Hold)
+            {
+                if (maelstromUse == PvpProcUse::Heal &&
+                    cast("healing wave", support, "enhancement-maelstrom-heal"))
+                    return true;
+                if (maelstromUse == PvpProcUse::Control &&
+                    cast("hex", controlTarget, "enhancement-maelstrom-hex", true))
+                    return true;
+                if (maelstromUse == PvpProcUse::Damage &&
+                    pressure("lightning bolt", target, "enhancement-maelstrom-damage"))
+                    return true;
+            }
+            if ((commit || survive) && melee && castBurst("feral spirit", bot, "enhancement-feral-spirit"))
+                return true;
+            if (snapshot.magicPressureScore >= 0.45f && target->IsNonMeleeSpellCast(false) &&
+                cast("grounding totem", bot, "enhancement-grounding"))
+                return true;
+            bool const valuablePurge = botAI->HasAura("power word: shield", target, false, true) ||
+                                       botAI->HasAura("hand of freedom", target, false, true) ||
+                                       botAI->HasAura("ice barrier", target, false, true) ||
+                                       botAI->HasAura("sacred shield", target, false, true);
+            if (valuablePurge && bot->GetPowerPct(POWER_MANA) >= 35.0f &&
+                (!state.lastSpecUtilityAtMs || now - state.lastSpecUtilityAtMs >= 2000) &&
+                cast("purge", target, "enhancement-selective-purge"))
+            {
+                state.lastSpecUtilityAtMs = now;
+                return true;
+            }
+            if (melee)
+                return pressure("stormstrike", target, "enhancement-stormstrike") ||
+                       pressure("lava lash", target, "enhancement-lava-lash") ||
+                       pressure("earth shock", target, "enhancement-earth-shock");
+            return NeedsSlow(botAI, "frost shock", target) &&
+                   cast("frost shock", target, "enhancement-frost-shock");
+        }
+        case PvpArchetype::FireMage:
+        {
+            if (melee && secondaryDefensiveReady())
+            {
+                if (cast("dragon's breath", target, "fire-dragon-breath", true))
+                {
+                    markSecondaryDefensive();
+                    return true;
+                }
+                if (cast("blast wave", target, "fire-blast-wave", true))
+                {
+                    markSecondaryDefensive();
+                    ContinuePvpKiteAfterInstant(botAI, target, false);
+                    return true;
+                }
+            }
+            bool const plannedPolymorph = controlTarget == target ||
+                (snapshot.controlWindow.active && snapshot.controlWindow.targetGuid == target->GetGUID());
+            if (!plannedPolymorph && !botAI->HasAura("living bomb", target, false, true) &&
+                pressure("living bomb", target, "fire-living-bomb"))
+                return true;
+            if (botAI->HasAura("hot streak", bot) && !snapshot.targetMajorDefensive &&
+                pressure("pyroblast", target, "fire-hot-streak"))
+                return true;
+            if (commit && castBurst("combustion", bot, "fire-combustion"))
+                return true;
+            if (bot->isMoving())
+                return pressure("fire blast", target, "fire-moving-fire-blast");
+            return pressure("scorch", target, "fire-scorch") ||
+                   pressure("fireball", target, "fire-fireball") ||
+                   pressure("fire blast", target, "fire-fire-blast");
+        }
+        case PvpArchetype::DemonologyWarlock:
+        {
+            Pet* pet = bot->GetPet();
+            if ((!pet || !pet->IsAlive()) && snapshot.castSafetyScore >= 0.62f)
+            {
+                if (!botAI->HasAura("fel domination", bot) && cast("fel domination", bot, "demo-fel-domination"))
+                    return true;
+                if (pressure("summon felguard", bot, "demo-summon-felguard"))
+                    return true;
+            }
+            if (pet && pet->IsAlive() && pet->GetHealthPct() < 35.0f && bot->GetHealthPct() > 65.0f &&
+                snapshot.incomingBurstScore < 0.35f && pressure("health funnel", pet, "demo-health-funnel"))
+                return true;
+            bool const petConnected = pet && pet->IsAlive() && pet->GetVictim() == target;
+            bool const targetConstrained = melee || snapshot.targetControlState == PvpControlState::DamageSafe;
+            if (commit && (petConnected || targetConstrained) && distance <= 15.0f &&
+                castBurst("metamorphosis", bot, "demo-metamorphosis"))
+                return true;
+            if (botAI->HasAura("metamorphosis", bot))
+            {
+                if (distance > 8.0f && distance <= 25.0f && cast("demon charge", target, "demo-demon-charge"))
+                    return true;
+                if (distance <= 10.0f && cast("immolation aura", bot, "demo-immolation-aura"))
+                    return true;
+            }
+            if (!botAI->HasAura("corruption", target, false, true) &&
+                pressure("corruption", target, "demo-corruption"))
+                return true;
+            return pressure("soul fire", target, "demo-soul-fire") ||
+                   pressure("incinerate", target, "demo-incinerate") ||
+                   pressure("shadow bolt", target, "demo-shadow-bolt");
+        }
+        case PvpArchetype::RestorationShaman:
+        {
+            if (!botAI->HasAura("water shield", bot) && cast("water shield", bot, "resto-shaman-water-shield"))
+                return true;
+            bool const earthShieldValid = !state.earthShieldTargetGuid.IsEmpty() &&
+                botAI->GetUnit(state.earthShieldTargetGuid) &&
+                botAI->HasAura("earth shield", botAI->GetUnit(state.earthShieldTargetGuid), false, true);
+            if (!earthShieldValid &&
+                (!state.lastEarthShieldSwapAtMs || now - state.lastEarthShieldSwapAtMs >= 8000) &&
+                cast("earth shield", support, "resto-shaman-earth-shield"))
+            {
+                state.earthShieldTargetGuid = support->GetGUID();
+                state.lastEarthShieldSwapAtMs = now;
+                return true;
+            }
+            if (support->GetHealthPct() <= 32.0f && primaryDefensiveReady() &&
+                cast("nature's swiftness", bot, "resto-shaman-natures-swiftness"))
+            {
+                markPrimaryDefensive();
+                return true;
+            }
+            if (botAI->HasAura("nature's swiftness", bot) &&
+                cast("healing wave", support, "resto-shaman-emergency-heal"))
+                return true;
+            if (support->GetHealthPct() < 92.0f && !botAI->HasAura("riptide", support, false, true) &&
+                cast("riptide", support, "resto-shaman-riptide"))
+                return true;
+            if (support->GetHealthPct() <= 70.0f)
+                return pressure(support->GetHealthPct() <= 45.0f ? "healing wave" : "lesser healing wave",
+                                support, "resto-shaman-hard-heal");
+            if (bot->GetPowerPct(POWER_MANA) < 28.0f && snapshot.incomingBurstScore < 0.30f &&
+                cast("mana tide totem", bot, "resto-shaman-mana-tide"))
+                return true;
+            if (controlTarget && snapshot.triage.dangerScore < 0.40f && !plan.reserveControl &&
+                cast("hex", controlTarget, "resto-shaman-hex", true))
+                return true;
+            return false;
+        }
+        case PvpArchetype::HolyPaladin:
+        {
+            if (botAI->HasAura("divine plea", bot) && snapshot.incomingBurstScore >= 0.45f)
+            {
+                botAI->RemoveAura("divine plea");
+                DebugPvpTactical(botAI, "holy-paladin-cancel-plea", target);
+                return true;
+            }
+            if (!botAI->HasAura("sacred shield", support, false, true) &&
+                cast("sacred shield", support, "holy-paladin-sacred-shield"))
+                return true;
+            if (support != bot && (botAI->IsMovementImpaired(support) || support->HasRootAura()) &&
+                cast("hand of freedom", support, "holy-paladin-freedom"))
+                return true;
+            if (bot->GetHealthPct() <= 22.0f && primaryDefensiveReady(5000) &&
+                cast("divine shield", bot, "holy-paladin-divine-shield"))
+            {
+                markPrimaryDefensive();
+                return true;
+            }
+            if (snapshot.physicalPressureScore >= 0.70f && support != bot && support->GetHealthPct() <= 38.0f &&
+                primaryDefensiveReady() && cast("hand of protection", support, "holy-paladin-bop"))
+            {
+                markPrimaryDefensive();
+                return true;
+            }
+            if (support != bot && support->GetHealthPct() <= 55.0f && secondaryDefensiveReady() &&
