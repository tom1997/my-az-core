diff --git a/modules/mod-playerbots/src/Ai/Base/Value/PvpTacticalValue.cpp b/modules/mod-playerbots/src/Ai/Base/Value/PvpTacticalValue.cpp
new file mode 100644
index 0000000..503c827
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Base/Value/PvpTacticalValue.cpp
@@ -0,0 +1,117 @@
+/*
+ * Shared state for cooperative PvP movement and class ability selection.
+ */
+
+#include "PvpTacticalValue.h"
+
+#include "AiObjectContext.h"
+#include "MotionMaster.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "PlayerbotAIConfig.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+#include "Timer.h"
+#include "Unit.h"
+
+void PvpTacticalState::Reset()
+{
+    mode = PvpTacticalMode::None;
+    movementOwner = PvpMovementOwner::None;
+    targetGuid.Clear();
+    updatedAtMs = 0;
+    movementIssuedAtMs = 0;
+    desiredDistance = 0.0f;
+    retreating = false;
+}
+
+PvpTacticalState& GetPvpTacticalState(PlayerbotAI* botAI)
+{
+    return botAI->GetAiObjectContext()->GetValue<PvpTacticalState&>("pvp tactical state")->Get();
+}
+
+void UpdatePvpTacticalState(PlayerbotAI* botAI, Unit* target)
+{
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    Player* bot = botAI->GetBot();
+    if (!target || !target->IsPlayer() || !bot->IsAlive())
+    {
+        state.Reset();
+        return;
+    }
+
+    state.updatedAtMs = getMSTime();
+    state.targetGuid = target->GetGUID();
+    float const distance = bot->GetDistance2d(target);
+    bool const ranged = botAI->IsRanged(bot, true) || botAI->IsHeal(bot);
+    bool const enemyRanged = botAI->IsRanged(target->ToPlayer(), true);
+
+    if (bot->duel && bot->duel->State == DUEL_STATE_COUNTDOWN)
+        state.mode = PvpTacticalMode::Prepare;
+    else if (target->GetHealthPct() <= 20.0f)
+        state.mode = PvpTacticalMode::Finish;
+    else if (bot->GetHealthPct() <= 35.0f)
+        state.mode = PvpTacticalMode::Recover;
+    else if (ranged && !enemyRanged && distance < state.desiredDistance)
+        state.mode = PvpTacticalMode::Kite;
+    else if (bot->GetHealthPct() >= target->GetHealthPct() + 20.0f || target->GetHealthPct() <= 40.0f)
+        state.mode = PvpTacticalMode::Pressure;
+    else
+        state.mode = PvpTacticalMode::Control;
+}
+
+void ClaimPvpMovement(PlayerbotAI* botAI, PvpMovementOwner owner, Unit* target)
+{
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    state.movementOwner = owner;
+    state.movementIssuedAtMs = getMSTime();
+    if (target)
+        state.targetGuid = target->GetGUID();
+}
+
+void ClearPvpMovement(PlayerbotAI* botAI, PvpMovementOwner owner)
+{
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (owner == PvpMovementOwner::None || state.movementOwner == owner)
+    {
+        state.movementOwner = PvpMovementOwner::None;
+        state.movementIssuedAtMs = 0;
+    }
+}
+
+bool IsPvpMovementActive(PlayerbotAI* botAI, Player* bot, PvpMovementOwner owner)
+{
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (owner != PvpMovementOwner::None && state.movementOwner != owner)
+        return false;
+
+    bool const active = state.movementOwner != PvpMovementOwner::None && bot->isMoving() &&
+                        bot->GetMotionMaster()->GetCurrentMovementGeneratorType() == POINT_MOTION_TYPE &&
+                        getMSTime() - state.movementIssuedAtMs < 5000;
+    if (!active && state.movementOwner != PvpMovementOwner::None)
+        ClearPvpMovement(botAI);
+    return active;
+}
+
+bool CanUsePvpSpell(PlayerbotAI* botAI, std::string const& spell, Unit* target, bool respectDiminishing)
+{
+    if (!target)
+        return false;
+
+    uint32 const spellId = botAI->GetAiObjectContext()->GetValue<uint32>("spell id", spell)->Get();
+    if (!spellId || botAI->GetBot()->HasSpellCooldown(spellId))
+        return false;
+
+    if (respectDiminishing)
+    {
+        SpellInfo const* spellInfo = sSpellMgr->GetSpellInfo(spellId);
+        if (spellInfo)
+        {
+            DiminishingGroup const group = GetDiminishingReturnsGroupForSpell(spellInfo, false);
+            if (group != DIMINISHING_NONE && target->GetDiminishing(group) >= DIMINISHING_LEVEL_IMMUNE)
+                return false;
+        }
+    }
+
+    return botAI->CanCastSpell(spell, target);
+}
diff --git a/modules/mod-playerbots/src/Ai/Base/Value/PvpTacticalValue.h b/modules/mod-playerbots/src/Ai/Base/Value/PvpTacticalValue.h
new file mode 100644
index 0000000..7c91993
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Base/Value/PvpTacticalValue.h
@@ -0,0 +1,67 @@
+/*
+ * Shared state for cooperative PvP movement and class ability selection.
+ */
+
+#ifndef PLAYERBOTS_PVP_TACTICAL_VALUE_H
+#define PLAYERBOTS_PVP_TACTICAL_VALUE_H
+
+#include "ObjectGuid.h"
+#include "Value.h"
+
+#include <string>
+
+class Player;
+class PlayerbotAI;
+class Unit;
+
+enum class PvpTacticalMode : uint8
+{
+    None,
+    Prepare,
+    Pressure,
+    Kite,
+    Control,
+    Recover,
+    Finish
+};
+
+enum class PvpMovementOwner : uint8
+{
+    None,
+    Retreat,
+    Flank,
+    Pressure,
+    DuelPrepare,
+    ReturnToAnchor
+};
+
+struct PvpTacticalState
+{
+    PvpTacticalMode mode = PvpTacticalMode::None;
+    PvpMovementOwner movementOwner = PvpMovementOwner::None;
+    ObjectGuid targetGuid;
+    uint32 updatedAtMs = 0;
+    uint32 movementIssuedAtMs = 0;
+    float desiredDistance = 0.0f;
+    bool retreating = false;
+
+    void Reset();
+};
+
+class PvpTacticalStateValue : public ManualSetValue<PvpTacticalState&>
+{
+public:
+    PvpTacticalStateValue(PlayerbotAI* botAI) : ManualSetValue<PvpTacticalState&>(botAI, data, "pvp tactical state") {}
+
+private:
+    PvpTacticalState data;
+};
+
+PvpTacticalState& GetPvpTacticalState(PlayerbotAI* botAI);
+void UpdatePvpTacticalState(PlayerbotAI* botAI, Unit* target);
+void ClaimPvpMovement(PlayerbotAI* botAI, PvpMovementOwner owner, Unit* target);
+void ClearPvpMovement(PlayerbotAI* botAI, PvpMovementOwner owner = PvpMovementOwner::None);
+bool IsPvpMovementActive(PlayerbotAI* botAI, Player* bot, PvpMovementOwner owner = PvpMovementOwner::None);
+bool CanUsePvpSpell(PlayerbotAI* botAI, std::string const& spell, Unit* target, bool respectDiminishing = true);
+
+#endif
