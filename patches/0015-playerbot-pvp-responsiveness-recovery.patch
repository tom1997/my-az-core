+
+Unit* ResolvePvpThreatTarget(PlayerbotAI* botAI, float maxDistance)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!IsPvpTacticalEligible(bot))
+        return nullptr;
+
+    if (bot->duel && bot->duel->Opponent && bot->duel->Opponent->IsAlive())
+    {
+        // AttackDuelOpponentAction temporarily switches to pets or mirror images
+        // while the opponent is completely immune. Tactical player actions must
+        // pause instead of immediately overriding that secondary-target window.
+        if (bot->duel->Opponent->IsImmunedToDamage(SPELL_SCHOOL_MASK_NORMAL) &&
+            bot->duel->Opponent->IsImmunedToDamage(SPELL_SCHOOL_MASK_MAGIC))
+            return nullptr;
+        return bot->duel->Opponent;
+    }
+
+    Unit* best = nullptr;
+    float bestDistance = maxDistance > 0.0f ? maxDistance : FLT_MAX;
+    auto consider = [&](Unit* candidate)
+    {
+        if (!candidate || !candidate->IsPlayer() || !candidate->IsAlive() || candidate->GetMap() != bot->GetMap() ||
+            !bot->IsHostileTo(candidate))
+            return;
+        float const distance = bot->GetDistance2d(candidate);
+        if (distance < bestDistance)
+        {
+            best = candidate;
+            bestDistance = distance;
+        }
+    };
+
+    // Unit::getAttackers is updated by the combat system immediately, unlike
+    // the one-second calculated Playerbot "attackers" value.
+    for (Unit* attacker : bot->getAttackers())
+        consider(attacker);
+
+    Unit* current = botAI->GetAiObjectContext()->GetValue<Unit*>("current target")->Get();
+    consider(current);
+
+    if (!best && bot->IsInCombat())
+        for (ObjectGuid const guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest enemy players")->Get())
+        {
+            Unit* candidate = botAI->GetUnit(guid);
+            if (candidate && (candidate->GetVictim() == bot || candidate == current))
+                consider(candidate);
+        }
+
+    return best;
 }
 
