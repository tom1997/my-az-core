+        return;
+    state.lastDebugAtMs = now;
+    LOG_INFO("playerbots", "[PvPTactical] bot={} event={} mode={} owner={} target={} dist={:.1f} hp={:.1f}",
+             bot->GetName(), message, uint32(state.mode), uint32(state.movementOwner),
+             target ? target->GetName() : "none", target ? bot->GetDistance2d(target) : 0.0f, bot->GetHealthPct());
