+bool IsPvpTacticalEligible(Player* bot)
+{
+    return bot && bot->IsAlive() && bot->IsInWorld() && !bot->IsBeingTeleported() && !bot->IsInFlight() &&
+           !bot->GetVehicle() && !bot->IsDuringRemoveFromWorld();
