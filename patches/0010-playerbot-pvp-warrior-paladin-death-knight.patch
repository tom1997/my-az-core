diff --git a/modules/mod-playerbots/src/Ai/Base/Actions/PvpTacticalActions.cpp b/modules/mod-playerbots/src/Ai/Base/Actions/PvpTacticalActions.cpp
new file mode 100644
index 0000000..081b486
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Base/Actions/PvpTacticalActions.cpp
@@ -0,0 +1,64 @@
+/* Class-aware PvP control actions. */
+#include "PvpTacticalActions.h"
+#include "AiObjectContext.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "PvpTacticalValue.h"
+#include "SharedDefines.h"
+#include "Unit.h"
+
+namespace
+{
+bool TrySpell(PlayerbotAI* botAI, std::string const& spell, Unit* target, bool respectDiminishing = true)
+{
+    return CanUsePvpSpell(botAI, spell, target, respectDiminishing) && botAI->CastSpell(spell, target);
+}
+bool NeedsSlow(PlayerbotAI* botAI, std::string const& aura, Unit* target)
+{
+    return target && !botAI->HasAura(aura, target);
+}
+}
+
+bool PvpTacticalClassControlAction::isUseful()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    return target && target->IsPlayer() && target->IsAlive() && bot->IsAlive();
+}
+
+bool PvpTacticalClassControlAction::Execute(Event /*event*/)
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsPlayer())
+        return false;
+    float const distance = bot->GetDistance2d(target);
+    bool const melee = bot->IsWithinMeleeRange(target);
+    bool const targetCasting = target->IsNonMeleeSpellCast(false);
+    switch (bot->getClass())
+    {
+        case CLASS_WARRIOR:
+            if (targetCasting && melee && (TrySpell(botAI, "pummel", target, false) || TrySpell(botAI, "shield bash", target, false)))
+                return true;
+            if (melee && NeedsSlow(botAI, "hamstring", target) && TrySpell(botAI, "hamstring", target, false))
+                return true;
+            if (distance >= 8.0f && distance <= 25.0f && TrySpell(botAI, "charge", target, false))
+                return true;
+            return distance > 8.0f && TrySpell(botAI, "intercept", target, false);
+        case CLASS_PALADIN:
+            if ((bot->HasRootAura() || bot->HasAuraType(SPELL_AURA_MOD_DECREASE_SPEED)) && TrySpell(botAI, "hand of freedom", bot, false))
+                return true;
+            if (melee && TrySpell(botAI, "hammer of justice", target))
+                return true;
+            return distance > 8.0f && TrySpell(botAI, "repentance", target);
+        case CLASS_DEATH_KNIGHT:
+            if (targetCasting && melee && TrySpell(botAI, "mind freeze", target, false))
+                return true;
+            if (targetCasting && TrySpell(botAI, "strangulate", target))
+                return true;
+            if (NeedsSlow(botAI, "chains of ice", target) && TrySpell(botAI, "chains of ice", target, false))
+                return true;
+            return distance > 10.0f && TrySpell(botAI, "death grip", target, false);
+        default:
+            return false;
+    }
+}
