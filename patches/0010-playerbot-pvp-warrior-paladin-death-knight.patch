+/* Class-aware PvP control actions. */
+#ifndef PLAYERBOTS_PVP_TACTICAL_ACTIONS_H
+#define PLAYERBOTS_PVP_TACTICAL_ACTIONS_H
+#include "Action.h"
+
+class PvpTacticalClassControlAction : public Action
+{
+public:
+    PvpTacticalClassControlAction(PlayerbotAI* botAI) : Action(botAI, "pvp tactical class control") {}
+    bool Execute(Event event) override;
+    bool isUseful() override;
+};
+#endif
