+}
+
+bool RequestPvpCastPlant(PlayerbotAI* botAI, uint32 castMs)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot || !castMs)
+        return false;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (state.rangedCastPlantUntilMs > now)
+        return true;
+
+    Unit* threat = ResolvePvpMovementThreat(botAI);
+    PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+    float const threatDistance = threat ? bot->GetDistance2d(threat) : 0.0f;
+    float const emergencyDistance = botAI->IsHeal(bot) ? 14.0f : 10.0f;
+    float const minimumPlantDistance = botAI->IsHeal(bot) ? 20.0f : 18.0f;
+    bool const targetControlled = threat && GetPvpControlState(threat) != PvpControlState::None;
+    bool const recentlyPlanted = state.lastRangedCastPlantAtMs &&
+                                 now - state.lastRangedCastPlantAtMs < 2500;
+    if (!ShouldRequestPvpCastPlant(
+            bot->duel && bot->duel->State == DUEL_STATE_IN_PROGRESS,
+            botAI->IsRanged(bot, true) || botAI->IsHeal(bot), bot->isMoving(),
+            state.movementOwner == PvpMovementOwner::Retreat, true, targetControlled,
+            recentlyPlanted, threatDistance, minimumPlantDistance, emergencyDistance,
+            snapshot.castSafetyScore))
+        return false;
+
+    state.lastRangedCastPlantAtMs = now;
+    state.rangedCastPlantUntilMs = now + std::clamp<uint32>(castMs + 700, 1400, 4500);
+    state.rangeMotion = PvpRangeMotion::Hold;
+    CancelPvpMovement(botAI, PvpMovementOwner::Retreat);
+    DebugPvpTactical(botAI, "ranged-cast-plant", threat);
+    return true;
+}
+
+bool IsPvpCastPlantActive(PlayerbotAI* botAI)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot)
+        return false;
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    if (!state.rangedCastPlantUntilMs || now >= state.rangedCastPlantUntilMs)
+    {
+        state.rangedCastPlantUntilMs = 0;
+        return false;
+    }
+
+    Unit* threat = ResolvePvpMovementThreat(botAI);
+    float const emergencyDistance = botAI->IsHeal(bot) ? 14.0f : 10.0f;
+    if (!threat || bot->GetDistance2d(threat) <= emergencyDistance)
+    {
+        state.rangedCastPlantUntilMs = 0;
+        return false;
+    }
+    return true;
+}
