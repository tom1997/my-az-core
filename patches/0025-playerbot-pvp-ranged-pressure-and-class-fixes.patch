+bool ShouldRequestPvpCastPlant(bool duel, bool ranged, bool moving, bool retreatOwned, bool hardCast,
+                              bool targetControlled, bool recentlyPlanted, float threatDistance,
+                              float minimumPlantDistance, float emergencyDistance, float castSafety)
+{
