+        Unit* target = ResolvePvpThreatTarget(botAI);
+        if (!target)
+            return false;
+        PvpSnapshot const snapshot = GetPvpSnapshot(botAI);
+        bool const protectedWindow = snapshot.controlWindow.active &&
+            (snapshot.controlWindow.controlState == PvpControlState::DamageBreakable ||
+             snapshot.controlWindow.controlState == PvpControlState::DamageImmune) &&
+            snapshot.controlWindow.expectedRemainingMs >= 3500;
+        bool const distantWindow = bot->GetDistance2d(target) >= 28.0f &&
+                                   snapshot.incomingBurstScore < 0.30f;
+        if (!protectedWindow && !distantWindow)
+            return false;
+    }
+    return CastSpellAction::isUseful();
+}
