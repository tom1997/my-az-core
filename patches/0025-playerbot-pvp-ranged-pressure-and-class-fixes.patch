+bool TryDruidRecoveryReposition(PlayerbotAI* botAI, Unit* target)
+{
+    Player* bot = botAI->GetBot();
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    uint32 const now = getMSTime();
+    float const distance = target ? bot->GetDistance2d(target) : 0.0f;
+    bool const controlStillSafe = target &&
+        (GetPvpControlState(target) == PvpControlState::DamageBreakable ||
+         GetPvpControlState(target) == PvpControlState::DamageImmune ||
+         target->HasRootAura() || target->HasAuraType(SPELL_AURA_MOD_STUN));
+
+    if (state.movementOwner == PvpMovementOwner::DruidRecovery)
+    {
+        if (!controlStillSafe || distance >= 18.0f ||
+            now - state.druidRecoveryMoveStartedAtMs >= 2500)
+        {
+            CancelPvpMovement(botAI, PvpMovementOwner::DruidRecovery);
+            state.druidRecoveryMoveStartedAtMs = 0;
+            DebugPvpTactical(botAI, "druid-recovery-positioned", target);
+            return false;
+        }
+        if (IsPvpMovementActive(botAI, bot, PvpMovementOwner::DruidRecovery))
+            return true;
+        CancelPvpMovement(botAI, PvpMovementOwner::DruidRecovery);
+    }
+
+    if (!controlStillSafe || distance >= 18.0f)
+        return false;
+
+    float const awayAngle = target->GetAngle(bot);
+    float const step = std::clamp(22.0f - distance, 7.0f, 14.0f);
+    GameObject* duelFlag = bot->GetMap()->GetGameObject(bot->GetGuidValue(PLAYER_DUEL_ARBITER));
+    for (float const offset : { 0.0f, float(M_PI / 6.0), float(-M_PI / 6.0) })
+    {
+        float x = bot->GetPositionX() + std::cos(awayAngle + offset) * step;
+        float y = bot->GetPositionY() + std::sin(awayAngle + offset) * step;
+        float z = bot->GetPositionZ();
+        if (!bot->GetMap()->CheckCollisionAndGetValidCoords(bot, bot->GetPositionX(), bot->GetPositionY(),
+                                                             bot->GetPositionZ(), x, y, z))
+            continue;
+        if (duelFlag && duelFlag->GetDistance2d(x, y) >
+            std::clamp(sPlayerbotAIConfig.pvpTacticalDuelSafeRadius, 20.0f, 39.0f))
+            continue;
+
+        ClaimPvpMovement(botAI, PvpMovementOwner::DruidRecovery, target);
+        SetPvpMovementDestination(botAI, x, y);
+        state.druidRecoveryMoveStartedAtMs = now;
+        bot->GetMotionMaster()->Clear(false);
+        bot->GetMotionMaster()->MovePoint(0, x, y, z, FORCED_MOVEMENT_NONE, 0.0f, 0.0f, true, false);
+        DebugPvpTactical(botAI, "druid-recovery-cat-reposition", target);
+        return true;
+    }
+    return false;
+}
