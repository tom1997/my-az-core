 #include "Player.h"
 #include "PlayerbotAI.h"
 #include "Playerbots.h"
+#include "PvpTacticalValue.h"
+
+bool PvpShadowDebuffTrigger::IsActive()
+{
+    Unit* target = GetTarget();
+    if (!target || !target->IsAlive() || !target->IsInWorld())
+        return false;
+
+    // The generic debuff trigger requires an estimated eight-second target
+    // lifetime, which is useful for short PvE trash but suppresses the entire
+    // shadow DoT package against players. In tactical PvP, aura ownership and
+    // refresh state are the useful gate; the rotation itself decides priority.
+    if (target->IsPlayer() && IsPvpTacticalContextEnabled(bot))
+        return AI_VALUE2(uint32, "spell id", spell) && BuffTrigger::IsActive();
+
+    return DebuffTrigger::IsActive();
+}
 
 bool ShadowProtectionTrigger::IsActive()
 {
