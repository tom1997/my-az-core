+TEST(PvpControlPolicy, RootsAreReservedForCloseMeleeEscape)
+{
+    EXPECT_TRUE(ShouldUsePvpEscapeRoot(true, true, false, 8.0f));
+    EXPECT_TRUE(ShouldUsePvpEscapeRoot(true, true, false, 12.0f));
+    EXPECT_FALSE(ShouldUsePvpEscapeRoot(true, true, false, 12.1f));
+    EXPECT_FALSE(ShouldUsePvpEscapeRoot(false, true, false, 8.0f));
+    EXPECT_FALSE(ShouldUsePvpEscapeRoot(true, false, false, 8.0f));
+    EXPECT_FALSE(ShouldUsePvpEscapeRoot(true, true, true, 8.0f));
+}
+
+TEST(PvpDuelPolicy, ReengageAfterAttackStopWithoutInterruptingCasts)
+{
+    EXPECT_TRUE(ShouldReengagePvpDuel(false, true, false, false));
+    EXPECT_TRUE(ShouldReengagePvpDuel(true, false, true, false));
+    EXPECT_TRUE(ShouldReengagePvpDuel(true, true, false, false));
+    EXPECT_FALSE(ShouldReengagePvpDuel(true, true, false, true));
+    EXPECT_FALSE(ShouldReengagePvpDuel(true, true, true, false));
+}
