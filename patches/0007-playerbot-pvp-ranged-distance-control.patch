+bool IsPvpTacticalHunterContext(Player* bot)
+{
+    if (!sPlayerbotAIConfig.pvpTacticalEnabled)
+        return false;
+    if (bot->duel && bot->duel->Opponent)
+        return sPlayerbotAIConfig.pvpTacticalDuel;
+    if (bot->InArena())
+        return sPlayerbotAIConfig.pvpTacticalArena;
+    if (bot->InBattleground())
+        return sPlayerbotAIConfig.pvpTacticalBattleground;
+    return sPlayerbotAIConfig.pvpTacticalOpenWorld;
+}
