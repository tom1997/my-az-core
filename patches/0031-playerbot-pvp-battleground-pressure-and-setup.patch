+bool HasActivePvpAuraOwnedByBot(PlayerbotAI* botAI, std::string const& aura, Unit* exceptTarget)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot)
+        return false;
+
+    auto hasOwnedAura = [&](Unit* unit)
+    {
+        return unit && unit != exceptTarget && unit->IsInWorld() &&
+               botAI->HasAura(aura, unit, false, true);
+    };
+
+    Unit* current = botAI->GetAiObjectContext()->GetValue<Unit*>("current target")->Get();
+    if (hasOwnedAura(current))
+        return true;
+    for (ObjectGuid const guid :
+         botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest enemy players")->Get())
+        if (hasOwnedAura(botAI->GetUnit(guid)))
+            return true;
+    if (hasOwnedAura(ResolvePvpHostilePet(botAI, 65.0f)))
+        return true;
+    return false;
+}
