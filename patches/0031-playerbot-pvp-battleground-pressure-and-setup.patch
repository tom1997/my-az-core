+int32 GetMatchingPvpSpecNo(Player* player)
+{
+    if (!player)
+        return -1;
+    uint8 const tab = AiFactory::GetPlayerSpecTab(player);
+    int32 firstPvpSpec = 3;
+    if (player->getClass() == CLASS_DEATH_KNIGHT || player->getClass() == CLASS_MAGE ||
+        player->getClass() == CLASS_DRUID)
+        firstPvpSpec = 4;
+    int32 const specNo = firstPvpSpec + tab;
+    std::string const& name = sPlayerbotAIConfig.premadeSpecName[player->getClass()][specNo];
+    return !name.empty() && name.find("pvp") != std::string::npos ? specNo : -1;
+}
+
+bool PrepareRandomBotForPvpQueue(Player* player)
+{
+    if (!player || !sRandomPlayerbotMgr.IsRandomBot(player) ||
+        sRandomPlayerbotMgr.IsSpecPvp(player->GetGUID().GetCounter(), player->getClass()))
+        return false;
+
+    int32 const specNo = GetMatchingPvpSpecNo(player);
+    PlayerbotAI* ai = GET_PLAYERBOT_AI(player);
+    if (specNo < 0 || !ai)
+        return false;
+
+    PlayerbotFactory::InitTalentsBySpecNo(player, specNo, true);
+    PlayerbotFactory factory(player, player->GetLevel());
+    factory.InitGlyphs(false);
+    factory.InitPetTalents();
+    ai->ResetStrategies(false);
+    LOG_INFO("playerbots", "Bot {} <{}> prepared PvP spec <{}> for battleground queue",
+             player->GetGUID().ToString().c_str(), player->GetName(),
+             sPlayerbotAIConfig.premadeSpecName[player->getClass()][specNo]);
+    return true;
+}
+}
