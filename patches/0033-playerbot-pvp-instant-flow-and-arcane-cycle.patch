+bool HasUsablePvpHealthRecoveryItem(PlayerbotAI* botAI)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    if (!bot)
+        return false;
+
+    std::vector<Item*> const healthstones =
+        AI_VALUE2(std::vector<Item*>, "inventory items", "healthstone");
+    for (Item* item : healthstones)
+    {
+        if (!item || bot->CanUseItem(item) != EQUIP_ERR_OK)
+            continue;
+        for (uint8 i = 0; i < MAX_ITEM_PROTO_SPELLS; ++i)
+        {
+            uint32 const spellId = item->GetTemplate()->Spells[i].SpellId;
+            if (spellId > 0 && botAI->CanCastSpell(spellId, bot, false, nullptr, item))
+                return true;
+        }
+    }
+
+    return !bot->HasAura(11196) && botAI->FindBandage();
+}
