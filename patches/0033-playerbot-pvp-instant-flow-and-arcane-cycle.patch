+bool ShouldContinuePvpInstantKite(bool ranged, bool validThreat, bool directPressure,
+                                  float threatDistance, float preferredDistance)
+{
+    if (!ranged || !validThreat || preferredDistance <= 0.0f)
+        return false;
+
+    // Blink, Disengage and instant roots are only one link in a kite chain.
+    // Keep the existing/rebuilt spline while the source is still pressuring us
+    // or the displacement has not actually reached the stable casting band.
+    return directPressure || threatDistance + 1.0f < preferredDistance;
+}
