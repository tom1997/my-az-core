+bool ShouldRepeatPvpControl(PvpControlPurpose purpose, float drWeight)
+{
+    if (purpose == PvpControlPurpose::None)
+        return false;
+
+    // Escape/recovery/peel may still need a shortened control immediately.
+    // Pure setup and off-target control should not feed a dispel/recast loop
+    // after the first full-duration application has already established DR.
+    return purpose == PvpControlPurpose::Escape || purpose == PvpControlPurpose::Recover ||
+           purpose == PvpControlPurpose::Peel || drWeight > 0.55f;
+}
+
+bool ShouldUsePvpPrimaryControlWindow(bool recoveryAvailable, bool petOpportunity,
+                                      bool activePressure, float botHealthPct,
+                                      float targetHealthPct)
+{
+    // Controlling a pet owner can still be a real peel. Otherwise a main-target
+    // breakable CC at low health is only worthwhile when it buys recovery that
+    // the bot can actually execute. Never heal an opponent out of execute range.
+    if (petOpportunity)
+        return targetHealthPct > 35.0f;
+    return recoveryAvailable && activePressure && botHealthPct <= 60.0f &&
+           targetHealthPct > 45.0f;
+}
