+void ContinuePvpKiteAfterInstant(PlayerbotAI* botAI, Unit* threat, bool movementInvalidated)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    bool const validThreat = bot && threat && threat->IsAlive() && threat->IsInWorld() &&
+                             threat->GetMap() == bot->GetMap() && bot->IsHostileTo(threat) &&
+                             bot->CanSeeOrDetect(threat, false, true);
+    float const preferredDistance = validThreat ? GetControlWindowPreferredDistance(botAI, bot, threat) : 0.0f;
+    float const threatDistance = validThreat ? bot->GetDistance2d(threat) : 0.0f;
+    bool const directPressure = validThreat &&
+        (threat->GetVictim() == bot || threat->GetTarget() == bot->GetGUID() || threatDistance <= 8.0f);
+    if (!ShouldContinuePvpInstantKite(bot && botAI->IsRanged(bot, true), validThreat,
+                                     directPressure, threatDistance, preferredDistance))
+        return;
+
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    state.instantKiteThreatGuid = threat->GetGUID();
+    state.instantKiteUntilMs = getMSTime() + 3000;
+    state.rangedCastPlantUntilMs = 0;
+
+    bool const retreatActive = IsPvpMovementActive(botAI, bot, PvpMovementOwner::Retreat);
+    if (movementInvalidated || !retreatActive)
+    {
+        // Teleports replace MotionMaster's old spline; instant roots may happen
+        // before the first retreat path was issued. Rebuild immediately without
+        // waiting for another range trigger/AI interval.
+        CancelPvpMovement(botAI);
+        state.rangeMotion = PvpRangeMotion::Retreat;
+        botAI->DoSpecificAction("pvp tactical retreat", Event(), true);
+    }
+    else
+        state.rangeMotion = PvpRangeMotion::Retreat;
+}
