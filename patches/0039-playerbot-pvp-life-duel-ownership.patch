+    bool Manager::EnsureDuelArea(ActiveEvent& event)
+    {
+        if (event.DuelAreaValidated)
+            return true;
+        uint32 const now = GameTimeSeconds();
+        if (event.DuelAreaRetryAt > now)
+            return false;
+
+        Player* reference = nullptr;
+        for (Participant const& participant : event.Members)
+        {
+            Player* bot = FindPlayer(participant.Bot.GuidLow);
+            // Wait until the destination map/grid has been loaded by arrival.
+            if (bot && !bot->IsBeingTeleported() && bot->GetMapId() == event.EventZone.MapId &&
+                bot->GetDistance2d(event.EventZone.RallyX, event.EventZone.RallyY) <= _duelLeashRadius)
+            {
+                reference = bot;
+                break;
+            }
+        }
+        if (!reference)
+            return false;
+
+        Map* map = reference->GetMap();
+        uint32 const phase = reference->GetPhaseMask();
+        float const margin = static_cast<float>(_positionJitter) + 5.0f;
+        auto allowsDuels = [&](float x, float y, float z)
+        {
+            // Validate the whole placement margin, not just a city-gate center
+            // whose jitter can put half of the participants in a no-duel area.
+            for (int dx = -1; dx <= 1; ++dx)
+                for (int dy = -1; dy <= 1; ++dy)
+                {
+                    AreaTableEntry const* area = sAreaTableStore.LookupEntry(
+                        map->GetAreaId(phase, x + dx * margin, y + dy * margin, z));
+                    if (!area || !(area->flags & AREA_FLAG_ALLOW_DUELS))
+                        return false;
+                }
+            return true;
+        };
+
+        float const originX = event.EventZone.RallyX;
+        float const originY = event.EventZone.RallyY;
+        float const originZ = event.EventZone.RallyZ;
+        for (uint32 ring = 0; ring <= 8; ++ring)
+            for (uint32 direction = 0; direction < (ring ? 16u : 1u); ++direction)
+            {
+                float const angle = direction * 6.2831853f / 16.0f;
+                float const x = originX + ring * 20.0f * std::cos(angle);
+                float const y = originY + ring * 20.0f * std::sin(angle);
+                float const z = map->GetHeight(phase, x, y, originZ + 30.0f);
+                if (!std::isfinite(z) || std::abs(z - originZ) > 40.0f || !allowsDuels(x, y, z))
+                    continue;
+
+                event.DuelAreaValidated = true;
+                event.EventZone.RallyX = event.EventZone.TargetX = x;
+                event.EventZone.RallyY = event.EventZone.TargetY = y;
+                event.EventZone.RallyZ = event.EventZone.TargetZ = z;
+                for (Participant& participant : event.Members)
+                {
+                    participant.ActivityX = x + Jitter();
+                    participant.ActivityY = y + Jitter();
+                    participant.ActivityZ = z;
+                }
+                for (MoveStep& step : _moveQueue)
+                    if (step.EventId == event.EventId)
+                    {
+                        step.X = x;
+                        step.Y = y;
+                        step.Z = z;
+                    }
+                LOG_INFO("module", "[PvPLife] Validated duel area '{}' at {}, {}, {}", event.EventZone.Name, x, y, z);
+                return true;
+            }
+
+        event.DuelAreaRetryAt = now + MINUTE;
+        LOG_WARN("module", "[PvPLife] No legal duel area near '{}'; waiting instead of spamming failed requests.",
+            event.EventZone.Name);
+        return false;
+    }
