+PvpRangeMotion SelectPvpRangeMotion(PvpRangeMotion current, float closestThreatDistance,
+                                    float primaryTargetDistance, float minimumDistance,
+                                    float preferredDistance, float maximumDistance)
+{
+    minimumDistance = std::max(1.0f, minimumDistance);
+    preferredDistance = std::max(minimumDistance + 1.0f, preferredDistance);
+    maximumDistance = std::max(preferredDistance + 1.0f, maximumDistance);
+
+    // A current correction owns the motion until the center of the band is
+    // reached. This is what turns kiting into one continuous run instead of
+    // repeated one- or two-yard adjustments at the edge of the band.
+    if (current == PvpRangeMotion::Retreat)
+        return closestThreatDistance < preferredDistance ? PvpRangeMotion::Retreat : PvpRangeMotion::Hold;
+    if (current == PvpRangeMotion::Advance)
+        return primaryTargetDistance > preferredDistance ? PvpRangeMotion::Advance : PvpRangeMotion::Hold;
+
+    if (closestThreatDistance < minimumDistance)
+        return PvpRangeMotion::Retreat;
+    if (primaryTargetDistance > maximumDistance)
+        return PvpRangeMotion::Advance;
