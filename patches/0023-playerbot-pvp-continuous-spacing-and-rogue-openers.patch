+bool TryRogueOpenerSpell(PlayerbotAI* botAI, std::string const& spell, Unit* target)
+{
+    uint32 const spellId = botAI->GetAiObjectContext()->GetValue<uint32>("spell id", spell)->Get();
+    SpellInfo const* spellInfo = spellId ? sSpellMgr->GetSpellInfo(spellId) : nullptr;
+    // This is the one deliberate exception to the breakable-control damage
+    // guard: a completed Sap setup must be released by its planned stealth
+    // opener. It remains subject to visibility and normal cast checks. The
+    // normal broad active-control/DR gate is intentionally skipped because Sap
+    // and Cheap Shot use different DR groups, yet that gate fails closed across
+    // every active control type.
+    return target && botAI->GetBot()->CanSeeOrDetect(target, false, true) &&
+           IsSafeForPvpCast(botAI, target, spellInfo, 0) &&
+           CanUsePvpSpell(botAI, spell, target, false) && botAI->CastSpell(spell, target);
+}
+
+bool TryPlannedRogueUtility(PlayerbotAI* botAI, std::string const& spell)
+{
