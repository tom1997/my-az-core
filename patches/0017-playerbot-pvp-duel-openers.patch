+bool IsFeralCat(PlayerbotAI* botAI)
+{
+    Player* bot = botAI->GetBot();
+    return bot->getClass() == CLASS_DRUID && AiFactory::GetPlayerSpecTab(bot) == DRUID_TAB_FERAL &&
+           !botAI->IsTank(bot, true);
+}
+
+void InitializeDuelOpener(PlayerbotAI* botAI, Player* opponent, bool countdown)
+{
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (!state.duelOpenerInitialized || state.targetGuid != opponent->GetGUID() ||
+        (countdown && !state.duelWasCountdown))
+    {
+        state.duelOpenerInitialized = true;
+        state.duelOpenerComplete = false;
+        state.duelWasCountdown = countdown;
+        state.duelOpenerStep = 0;
+        state.duelOpenerStartedAtMs = countdown ? 0 : getMSTime();
+        state.hasDuelAnchor = false;
+        state.targetGuid = opponent->GetGUID();
+        ClearPvpMovement(botAI, PvpMovementOwner::DuelPrepare);
+        DebugPvpTactical(botAI, "duel-opener-initialize", opponent);
+    }
+    else if (!countdown && !state.duelOpenerStartedAtMs)
+        state.duelOpenerStartedAtMs = getMSTime();
+}
+
+bool TryDuelPreparation(PlayerbotAI* botAI, Player* opponent)
+{
+    Player* bot = botAI->GetBot();
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    switch (bot->getClass())
+    {
+        case CLASS_WARRIOR:
+            if (!botAI->HasAura("battle shout", bot) && !botAI->HasAura("commanding shout", bot))
+                return TrySpell(botAI, "battle shout", bot, false) || TrySpell(botAI, "commanding shout", bot, false);
+            break;
+        case CLASS_PALADIN:
+            if (!botAI->HasAura("sacred shield", bot) && TrySpell(botAI, "sacred shield", bot, false))
+                return true;
+            break;
+        case CLASS_DEATH_KNIGHT:
+            if (!botAI->HasAura("bone shield", bot) && TrySpell(botAI, "bone shield", bot, false))
+                return true;
+            if (!botAI->HasAura("horn of winter", bot) && TrySpell(botAI, "horn of winter", bot, false))
+                return true;
+            break;
+        case CLASS_HUNTER:
+            if (!botAI->HasAura("aspect of the dragonhawk", bot) && !botAI->HasAura("aspect of the hawk", bot) &&
+                (TrySpell(botAI, "aspect of the dragonhawk", bot, false) ||
+                 TrySpell(botAI, "aspect of the hawk", bot, false)))
+                return true;
+            if (!state.hasDuelAnchor && TrySpell(botAI, "freezing trap", bot, false))
+            {
+                state.hasDuelAnchor = true;
+                state.duelAnchorX = bot->GetPositionX();
+                state.duelAnchorY = bot->GetPositionY();
+                state.duelAnchorZ = bot->GetPositionZ();
+                DebugPvpTactical(botAI, "hunter-trap-anchor", opponent);
+                return true;
+            }
+            break;
+        case CLASS_ROGUE:
+            if (!botAI->HasAura("stealth", bot) && TrySpell(botAI, "stealth", bot, false))
+                return true;
+            break;
+        case CLASS_PRIEST:
+            if (!botAI->HasAura("power word: shield", bot) && TrySpell(botAI, "power word: shield", bot, false))
+                return true;
+            break;
+        case CLASS_SHAMAN:
+            if (!botAI->HasAura("lightning shield", bot) && !botAI->HasAura("water shield", bot) &&
+                (TrySpell(botAI, "lightning shield", bot, false) || TrySpell(botAI, "water shield", bot, false)))
+                return true;
+            break;
+        case CLASS_MAGE:
+            if (!botAI->HasAura("ice barrier", bot) && TrySpell(botAI, "ice barrier", bot, false))
+                return true;
+            break;
+        case CLASS_WARLOCK:
+            if (!botAI->HasAura("fel armor", bot) && !botAI->HasAura("demon armor", bot) &&
+                (TrySpell(botAI, "fel armor", bot, false) || TrySpell(botAI, "demon armor", bot, false)))
+                return true;
+            break;
+        case CLASS_DRUID:
+            if (IsFeralCat(botAI))
+            {
+                if (!botAI->HasAura("cat form", bot) && TrySpell(botAI, "cat form", bot, false))
+                    return true;
+                if (!botAI->HasAura("prowl", bot) && TrySpell(botAI, "prowl", bot, false))
+                    return true;
+            }
+            break;
+        default:
+            break;
+    }
+    return false;
+}
+
+bool MoveStealthOpenerToTarget(PlayerbotAI* botAI, Player* opponent)
+{
+    Player* bot = botAI->GetBot();
+    if (bot->IsWithinMeleeRange(opponent))
+        return false;
+    if (IsPvpMovementActive(botAI, bot, PvpMovementOwner::DuelPrepare))
+        return false;
+
+    float const stopDistance = 2.0f;
+    float const angle = opponent->GetAngle(bot);
+    float x = opponent->GetPositionX() + std::cos(angle) * stopDistance;
+    float y = opponent->GetPositionY() + std::sin(angle) * stopDistance;
+    float z = opponent->GetPositionZ();
+    if (!bot->GetMap()->CheckCollisionAndGetValidCoords(bot, bot->GetPositionX(), bot->GetPositionY(),
+                                                         bot->GetPositionZ(), x, y, z))
+        return false;
+
+    ClaimPvpMovement(botAI, PvpMovementOwner::DuelPrepare, opponent);
+    SetPvpMovementDestination(botAI, x, y);
+    bot->GetMotionMaster()->Clear(false);
+    bot->GetMotionMaster()->MovePoint(0, x, y, z, FORCED_MOVEMENT_NONE, 0.0f, 0.0f, true, false);
+    DebugPvpTactical(botAI, "stealth-opener-approach", opponent);
+    return true;
+}
+}
+
+bool PvpTacticalDuelOpenerAction::isUseful()
+{
+    return sPlayerbotAIConfig.pvpTacticalEnabled && bot->duel && bot->duel->Opponent &&
+           (bot->duel->State == DUEL_STATE_COUNTDOWN || bot->duel->State == DUEL_STATE_IN_PROGRESS);
+}
+
+bool PvpTacticalDuelOpenerAction::Execute(Event /*event*/)
+{
+    Player* opponent = bot->duel && bot->duel->Opponent ? bot->duel->Opponent : nullptr;
+    if (!opponent)
+        return false;
+
+    bool const countdown = bot->duel->State == DUEL_STATE_COUNTDOWN;
+    InitializeDuelOpener(botAI, opponent, countdown);
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (countdown)
+        return TryDuelPreparation(botAI, opponent);
+
+    if (state.duelOpenerComplete)
+        return false;
+    if (getMSTime() - state.duelOpenerStartedAtMs >= 8000)
+    {
+        state.duelOpenerComplete = true;
+        ClearPvpMovement(botAI, PvpMovementOwner::DuelPrepare);
+        DebugPvpTactical(botAI, "duel-opener-timeout", opponent);
+        return false;
+    }
+
+    if (bot->getClass() == CLASS_ROGUE && botAI->HasAura("stealth", bot))
+    {
+        if (MoveStealthOpenerToTarget(botAI, opponent))
+            return true;
+        if (!bot->IsWithinMeleeRange(opponent))
+            return false;
+        if (state.duelOpenerStep == 0 && !opponent->IsInCombat() && TrySpell(botAI, "sap", opponent))
+        {
+            state.duelOpenerStep = 1;
+            DebugPvpTactical(botAI, "rogue-opener-sap", opponent);
+            return true;
+        }
+        if (state.duelOpenerStep == 1)
+        {
+            int32 const sapRemaining = MechanicControlRemainingMs(opponent, MECHANIC_SAPPED);
+            if (sapRemaining > 1500 && bot->GetPower(POWER_ENERGY) < 80)
+            {
+                bot->AttackStop();
+                botAI->PetFollow();
+                DebugPvpTactical(botAI, "rogue-opener-pool-energy", opponent);
+                return true;
+            }
+        }
+        if (TrySpell(botAI, "cheap shot", opponent))
+        {
+            state.duelOpenerComplete = true;
+            DebugPvpTactical(botAI, "rogue-opener-cheap-shot", opponent);
+            return true;
+        }
+        if (TrySpell(botAI, "garrote", opponent))
+        {
+            state.duelOpenerComplete = true;
+            DebugPvpTactical(botAI, "rogue-opener-garrote-fallback", opponent);
+            return true;
+        }
+        return false;
+    }
+
+    if (IsFeralCat(botAI) && botAI->HasAura("prowl", bot))
+    {
+        if (MoveStealthOpenerToTarget(botAI, opponent))
+            return true;
+        if (!bot->IsWithinMeleeRange(opponent))
+            return false;
+        if (TrySpell(botAI, "pounce", opponent))
+        {
+            state.duelOpenerComplete = true;
+            DebugPvpTactical(botAI, "feral-opener-pounce", opponent);
+            return true;
+        }
+        if (TrySpell(botAI, "ravage", opponent))
+        {
+            state.duelOpenerComplete = true;
+            DebugPvpTactical(botAI, "feral-opener-ravage-fallback", opponent);
+            return true;
+        }
+        return false;
+    }
+
+    // Ranged and non-stealth melee classes prepared their defensive state in
+    // the countdown. Their normal class strategy now owns the first cast.
+    state.duelOpenerComplete = true;
+    return false;
+}
+
+bool ShouldHoldDuelAttackForOpener(PlayerbotAI* botAI, Player* opponent)
+{
+    if (!sPlayerbotAIConfig.pvpTacticalEnabled || !botAI || !opponent)
+        return false;
+    PvpTacticalState& state = GetPvpTacticalState(botAI);
+    if (!state.duelOpenerInitialized || state.duelOpenerComplete || state.targetGuid != opponent->GetGUID())
+        return false;
+    Player* bot = botAI->GetBot();
+    return (bot->getClass() == CLASS_ROGUE && botAI->HasAura("stealth", bot)) ||
+           (IsFeralCat(botAI) && botAI->HasAura("prowl", bot));
 }
 
 bool PvpTacticalClassControlAction::isUseful()
