+void PlayerbotMgr::DetachPersistentBots()
+{
+    std::vector<ObjectGuid> persistentBots;
+    for (auto const& [guid, bot] : playerBots)
+        if (bot && GetLoginMode(guid) == PlayerbotLoginMode::PersistentOwned)
+            persistentBots.push_back(guid);
+
+    for (ObjectGuid const guid : persistentBots)
+    {
+        Player* bot = DetachPlayerBot(guid);
+        PlayerbotAI* botAI = bot ? GET_PLAYERBOT_AI(bot) : nullptr;
+        if (!botAI)
+            continue;
+
+        botAI->SetMaster(nullptr);
+        botAI->ResetStrategies(false);
+        PlayerbotRepository::instance().ApplyUserStrategies(botAI);
+        botAI->ChangeStrategy("+new rpg", BOT_STATE_NON_COMBAT);
+        sRandomPlayerbotMgr.AttachPlayerBot(bot);
+        LOG_INFO("playerbots", "Persistent owned bot {} remains online after owner logout", bot->GetName());
+    }
+}
+
+void PlayerbotMgr::ReclaimPersistentBots()
+{
+    if (!master || !master->GetSession())
+        return;
+
+    uint32 const ownerAccount = master->GetSession()->GetAccountId();
+    PlayerBotMap const onlineBots = sRandomPlayerbotMgr.GetAllBots();
+    for (auto const& [guid, candidate] : onlineBots)
+    {
+        if (!candidate || GetLoginMode(guid) != PlayerbotLoginMode::PersistentOwned ||
+            GetOwnerAccountId(guid) != ownerAccount)
+            continue;
+
+        Player* bot = sRandomPlayerbotMgr.DetachPlayerBot(guid);
+        if (!bot)
+            continue;
+
+        AttachPlayerBot(bot);
+        if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot))
+        {
+            botAI->SetMaster(master);
+            botAI->ResetStrategies(false);
+            PlayerbotRepository::instance().ApplyUserStrategies(botAI);
+            botAI->ChangeStrategy("+new rpg", BOT_STATE_NON_COMBAT);
+        }
+        LOG_INFO("playerbots", "Persistent owned bot {} reattached to owner {}", bot->GetName(), master->GetName());
+    }
+}
+
+void PlayerbotMgr::LogoutBotsForMaster()
+{
+    DetachPersistentBots();
+    LogoutAllBots();
+}
