+void PlayerbotMgr::StartBotDuels()
+{
+    if (!master || !master->GetGroup())
+    {
+        if (master && master->GetSession())
+            ChatHandler(master->GetSession()).SendSysMessage("botduel: you must be in a group");
+        return;
+    }
+
+    std::vector<Player*> candidates;
+    for (GroupReference* reference = master->GetGroup()->GetFirstMember(); reference; reference = reference->next())
+    {
+        Player* bot = reference->GetSource();
+        PlayerbotAI* botAI = bot ? GET_PLAYERBOT_AI(bot) : nullptr;
+        if (!bot || bot == master || !botAI || !bot->IsAlive() || bot->IsInCombat() || bot->duel ||
+            bot->GetMap() != master->GetMap())
+            continue;
+        candidates.push_back(bot);
+    }
+
+    std::sort(candidates.begin(), candidates.end(),
+              [this](Player* left, Player* right)
+              {
+                  return master->GetDistance(left) < master->GetDistance(right);
+              });
+
+    uint32 started = 0;
+    for (size_t i = 0; i + 1 < candidates.size(); i += 2)
+    {
+        Player* challenger = candidates[i];
+        Player* opponent = candidates[i + 1];
+        if (challenger->GetTeamId() != opponent->GetTeamId() || challenger->GetDistance(opponent) > 40.0f)
+            continue;
+
+        PlayerbotAI* challengerAI = GET_PLAYERBOT_AI(challenger);
+        PlayerbotAI* opponentAI = GET_PLAYERBOT_AI(opponent);
+        if (!challengerAI || !opponentAI)
+            continue;
+
+        challengerAI->ChangeStrategy("+duel", BOT_STATE_COMBAT);
+        opponentAI->ChangeStrategy("+duel", BOT_STATE_COMBAT);
+        if (challengerAI->DoSpecificAction(
+                "cast custom spell", Event("botduel", "7266 on " + opponent->GetName()), true))
+            ++started;
+    }
+
+    if (master->GetSession())
+    {
+        if (started)
+            ChatHandler(master->GetSession()).PSendSysMessage("botduel: started {} bot duel(s)", started);
+        else
+            ChatHandler(master->GetSession()).SendSysMessage(
+                "botduel: no eligible same-faction bot pairs within 40 yards");
+    }
+}
