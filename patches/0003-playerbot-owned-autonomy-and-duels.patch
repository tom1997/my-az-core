+    if (change.size() < 2 || (change[0] != '+' && change[0] != '-' && change[0] != '~'))
+        return;
+
+    std::string name = Trim(change.substr(1));
+    if (name.empty())
+        return;
+
+    uint32 guid = botAI->GetBot()->GetGUID().GetCounter();
+    std::string const key = UserStrategyKey(state);
+    std::unordered_map<std::string, char> changes;
+    std::stringstream input(GetSingleValue(guid, key));
+    std::string token;
+    while (std::getline(input, token, ','))
+    {
+        token = Trim(token);
+        if (token.size() > 1 && (token[0] == '+' || token[0] == '-'))
+            changes[Trim(token.substr(1))] = token[0];
+    }
+
+    if (IsTransientStrategy(name))
+        changes.erase(name);
+    else
+        changes[name] = change[0] == '~' ? (botAI->HasStrategy(name, state) ? '+' : '-') : change[0];
+
+    std::vector<std::string> names;
+    names.reserve(changes.size());
+    for (auto const& [strategy, operation] : changes)
+        names.push_back(std::string(1, operation) + strategy);
+    std::sort(names.begin(), names.end());
+
+    std::ostringstream output;
+    for (size_t i = 0; i < names.size(); ++i)
+    {
+        if (i)
+            output << ',';
+        output << names[i];
+    }
+    SaveSingleValue(guid, key, output.str());
+}
+
+void PlayerbotRepository::ClearUserStrategies(PlayerbotAI* botAI, BotState state)
+{
+    SaveSingleValue(botAI->GetBot()->GetGUID().GetCounter(), UserStrategyKey(state), "");
+}
